# Replaces only the benchmark-owned observer service after review.
# Old journals are retained; no history is migrated to a new scope.
[Unit]
Description=Supervise exact-source stage fixture endpoint observation
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/hami/phorvex-benchmark/releases/REVIEWED_SOURCE
Environment=PYTHONPATH=/home/hami/phorvex-benchmark/releases/REVIEWED_SOURCE/benchmark/worker:/home/hami/phorvex-benchmark/releases/REVIEWED_SOURCE
Environment=PATH=/home/hami/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/hami/phorvex-benchmark/runtime/python/bin/python -B benchmark/worker/stage_observer_runtime.py --data /home/hami/phorvex-benchmark/stage-data --repo /home/hami/phorvex-benchmark/operator-refactored --max-bytes 4294967296 --poll-seconds 30 --scan-timeout 120
Restart=on-failure
RestartSec=30
TimeoutStopSec=40
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
