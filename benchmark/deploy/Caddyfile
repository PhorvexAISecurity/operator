# The only public listener. API/web remain on loopback; metrics has its own token.
# Replace the IP with the operator-owned DNS name to use a publicly trusted cert.
{
    admin off
    auto_https disable_redirects
    skip_install_trust
}

https://87.106.63.105:8444 {
    tls internal
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        -Server
    }
    handle /metrics {
        reverse_proxy 127.0.0.1:4101
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:4101
    }
    handle {
        reverse_proxy 127.0.0.1:4100
    }
}
