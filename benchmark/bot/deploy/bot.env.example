# The benchmark bot's configuration, as /home/hami/phorvex-benchmark/config/bot.env
# with mode 600. Never commit real values. The token, the dashboard password and
# the OpenAI key below were exposed in chat once: rotate them before use.

# From BotFather. Rotate a leaked token with /revoke there.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ids allowed to command the bot, comma-separated. To find
# yours: start the bot, message it, and read the "ignored a message from Telegram
# user id N" line in `journalctl --user -u phorvex-benchmark-bot`.
BOT_ALLOWED_USER_IDS=

# The benchmark dashboard, through Caddy, verified against its internal root CA.
# Use PUBLIC_ORIGIN from server.env for both, and the same DASHBOARD_PASSWORD.
DASHBOARD_URL=https://87.106.63.105:7065
DASHBOARD_ORIGIN=https://87.106.63.105:7065
DASHBOARD_CA=/home/hami/phorvex-benchmark/runtime/caddy-data/caddy/pki/authorities/local/root.crt
DASHBOARD_PASSWORD=

# For /bench: an operator clone that holds the deployed brain's commit (the
# git_sha in data/mathlab/bin/current.json). The bot only reads it, by commit.
# After each deploy, fetch there so the new commit is present.
BOT_REPO=/home/hami/phorvex-benchmark/operator
# A Go SDK that can fetch the deployed binary's Go release through GOTOOLCHAIN,
# with egress to proxy.golang.org. The bot reads that release from build metadata.
BOT_GO=/home/hami/go-sdk/go/bin/go
# /bench refuses to start below this much free disk (two checkouts and a build).
BOT_MIN_FREE_GB=4
# Builds use BOT_STATE_DIR/go-build-cache. The bot trims this disposable cache
# to 2 GiB between jobs, or further when free space is below BOT_MIN_FREE_GB.
# This retention limit does not cap peak disk usage during a running build.

# The LLM that writes /bench changes. The model id is yours to choose.
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_REASONING_EFFORT=high
# OPENAI_BASE_URL=https://api.openai.com/v1
# For the dashboard's existing gateway, set both explicitly:
# OPENAI_BASE_URL=https://codex.algoty.com/v1
# OPENAI_API=responses

# Defaults for both commands.
BOT_DEFAULT_POLICY=vllm/vllm-defense
BOT_MAX_TICKS=500
