# The benchmark bot's configuration, as /home/hami/phorvex-benchmark/config/bot.env
# with mode 600. Never commit real values. The token, the dashboard password and
# the OpenAI key below were exposed in chat once: rotate them before use.

# From BotFather. Rotate a leaked token with /revoke there.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ids allowed to command the bot, comma-separated. To find
# yours: start the bot, message it, and read the "ignored a message from Telegram
# user id N" line in `journalctl --user -u phorvex-benchmark-bot`.
BOT_ALLOWED_USER_IDS=

# The benchmark dashboard, through Caddy, verified against its internal root CA.
# Same password as DASHBOARD_PASSWORD in server.env; the origin is PUBLIC_ORIGIN.
DASHBOARD_URL=https://87.106.63.105:8444
DASHBOARD_ORIGIN=https://87.106.63.105:8444
DASHBOARD_CA=/home/hami/phorvex-benchmark/runtime/caddy-data/caddy/pki/authorities/local/root.crt
DASHBOARD_PASSWORD=

# For /bench: a clean clone of the operator repository with its tags. The bot only
# reads it. Keep tags current: git -C /home/hami/phorvex-benchmark/operator fetch --tags
BOT_REPO=/home/hami/phorvex-benchmark/operator
# A Go that can fetch go1.26.1 (GOTOOLCHAIN), with egress to proxy.golang.org.
BOT_GO=go

# The LLM that writes /bench changes. The model id is yours to choose.
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_REASONING_EFFORT=high
# OPENAI_BASE_URL=https://api.openai.com/v1

# Defaults for both commands.
BOT_DEFAULT_POLICY=vllm/vllm-defense
BOT_MAX_TICKS=500
