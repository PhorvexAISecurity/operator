# Docker build context = repo root (the operator and console images both need
# multiple modules: phorvex/ + build/phoenix-extended/, and the console also needs
# dashboard-web/ + the build/test-harness/out-* report snapshots). Keep the context
# lean by dropping everything that no image build reads.

# Git metadata is host-specific and never enters an image build. CI validates
# the clean exact checkout before passing its reviewed SHA as a build argument.
.git
.gitignore
**/node_modules
**/.next

# Prebuilt local binaries — images compile from source.
**/*.exe
**/*.exe~

# Documentation, tooling, process records and other apps (no image reads these).
docs/
tools/
workflow/
benchmark/
End-to-End/

# Harness run logs (the dashboard reads metrics.jsonl, not the *-run.log files).
build/test-harness/**/*-run.log
build/test-harness/**/*.log

# Local dev artifacts.
**/tsconfig.tsbuildinfo
dashboard-web/out
