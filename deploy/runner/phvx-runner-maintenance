   try:
    target=os.readlink(p)
    if target.startswith(h.DIAG+'/Runner_') and target.endswith('.log'):active.append(target)
   except FileNotFoundError:continue
  if len(set(active))!=1:raise
  data=h.Path(active[0]).read_text(errors='replace')
