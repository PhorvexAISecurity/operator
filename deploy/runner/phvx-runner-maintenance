def log(kind,**kw):print(json.dumps({'at':time.time(),'kind':kind,**kw}),flush=True)
def command(args,timeout=8):return subprocess.check_output(args,text=True,timeout=timeout)
def proc(pid):
 d=pathlib.Path('/proc')/str(pid);s=(d/'stat').read_text();f=s[s.rfind(')')+2:].split()
 return {'pid':int(pid),'ppid':int(f[1]),'start':int(f[19]),'state':f[0],'uid':d.stat().st_uid,'exe':str((d/'exe').resolve()),'comm':(d/'comm').read_text().strip(),'cgroup':(d/'cgroup').read_text().strip()}
def processes():
 out=[]
 for d in pathlib.Path('/proc').iterdir():
  if not d.name.isdigit():continue
  try:
   if (d/'comm').read_text().strip() in ('Runner.Listener','Runner.Worker'):out.append(proc(int(d.name)))
  except FileNotFoundError:continue
 return out

def local_idle(allow_listener=True,allow_unmatched=False):
 ps=processes();configured=profiles_lib.profiles()
 listeners,workers=profiles_lib.census(ps,configured)
 if workers or (listeners and not allow_listener):raise RuntimeError('Worker/unexpected listener present')
 allowed=set();latest=[]
