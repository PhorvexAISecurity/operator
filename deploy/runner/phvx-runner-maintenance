    if extra:raise RuntimeError('Runner descendants remain: '+repr(extra))
  if not p and profile['runner_id']==133 and profiles_lib.listener_count()==1:
   latest.append({'runner_id':133,'inactive':True});continue
  code="""import sys,json,os,importlib.machinery,importlib.util
