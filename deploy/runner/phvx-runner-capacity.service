[Unit]
Description=Phorvex runner boot CPU capacity
After=local-fs.target
Before=actions.runner.PhorvexSecurity.phorvex.service actions.runner.PhorvexSecurity.phorvex-1.service docker.service containerd.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/phvx-runner-capacity --boot
RemainAfterExit=yes
TimeoutStartSec=60s
