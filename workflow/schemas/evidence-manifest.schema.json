{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-manifest.schema.json",
  "type": "object",
  "required": ["schema_version", "fix_id", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "fix_id": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "path", "bytes", "sha256", "producer", "created_at",
          "evidence_class", "retention"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "producer": {"type": "string", "minLength": 1},
          "created_at": {
            "anyOf": [
              {"type": "string", "format": "date-time"},
              {"type": "null"}
            ]
          },
          "evidence_class": {
            "enum": ["RED", "L0", "L1", "L2", "P3", "L3", "L4", "CONTROL"]
          },
          "retention": {"enum": ["git", "artifact-store", "local-original"]},
          "positive_control_for": {"type": ["string", "null"]},
          "sensitivity": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
