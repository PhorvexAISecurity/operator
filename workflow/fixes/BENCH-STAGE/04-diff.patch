+  const request = JSON.parse(document.getElementById('endpoint-templates').textContent)[name];
+  const url = URL.createObjectURL(new Blob([JSON.stringify(request)+'\n'], {type:'application/json;charset=utf-8'}));
+  const link = document.createElement('a'); link.href=url; link.download='endpoint-v3-'+name+'.json';
+  document.body.appendChild(link); link.click(); link.remove(); setTimeout(() => URL.revokeObjectURL(url), 1000);
+}));
+</script>
+</body>
+</html>
