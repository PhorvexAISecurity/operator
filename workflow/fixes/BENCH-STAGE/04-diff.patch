+package decision
+
+import (
+	"encoding/json"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/phorvex/phorvex/internal/actionset"
+	"github.com/phorvex/phorvex/internal/cost/endpoint"
+	"github.com/phorvex/phorvex/internal/model"
+)
+
+func studyTickForPreparation(p StudyPreparation, mandatory string) endpoint.Tick {
+	n, k, zero, hold, from := 3, 1, 0.0, 30.0, 0.0
+	tick := endpoint.Tick{ID: "tick", At: 100000, WorkloadUID: "workload", PolicyUID: p.policyUID,
+		SpecReplicas: &n, CandidateSetComplete: true, MandatoryID: mandatory,
+		SLO:    &endpoint.SLO{Target: .5, Window: 600, StudyAssumption: true},
+		Ledger: &endpoint.Ledger{At: 100000, CompleteFrom: &from, Measurement: "watch-observed-service-ready-backends"}}
+	for _, c := range p.Candidates {
+		c.K, c.WorthThreshold, c.HistoryKnown, c.HoldCap = &k, &zero, true, &hold
+		tick.Candidates = append(tick.Candidates, c)
+	}
+	return tick
+}
+
+func studyPrices(t *testing.T, tick endpoint.Tick) endpoint.ArmResult {
+	t.Helper()
+	result, err := endpoint.Run(endpoint.Trace{Schema: endpoint.TraceSchema, Evidence: "synthetic", SourceRevision: "test-source", Ticks: []endpoint.Tick{tick}}, endpoint.Defaults(), endpoint.FileStore{Dir: t.TempDir()})
+	if err != nil || result.State != "COMPLETE" {
+		t.Fatalf("pricing fixture: state=%s missing=%v err=%v", result.State, result.MissingReasons, err)
+	}
+	return result.Ticks[0].V2
+}
+
+func studyWorkload(v *model.WorkloadView) {
+	v.Pod.WorkloadSpec = model.WorkloadSpecObservation{Known: true, PodUID: v.Pod.UID, SpecReplicas: 3,
+		Workload: model.ObjectIdentity{Kind: "Deployment", Namespace: v.Pod.Namespace, UID: "workload"}}
+}
+
+func TestStudyPreparationDoesNotMutateOwnerViewsOrCallImpureCapability(t *testing.T) {
+	e := NewCoverageEngine()
+	e.Now = func() time.Time { return time.Unix(100000, 0) }
+	v, p := covView("candidate", true, 2*time.Hour, false), covPolicy(1)
+	p.PolicyUID = "study-policy"
+	studyWorkload(v)
+	e.Capability = func(*model.WorkloadView, model.Action, []string) *actionset.Eligibility {
+		t.Fatal("study called impure capability")
+		return nil
+	}
+	if _, err := e.PrepareEndpointStudy([]*model.WorkloadView{v}, p); err != ErrShadowCapabilityUnavailable {
+		t.Fatalf("missing read-only capability accepted: %v", err)
+	}
+	observations := 0
+	e.ShadowCapability = func(*model.WorkloadView, model.Action, []string) *actionset.Eligibility { observations++; return nil }
+	beforeState := e.ExportOwnerState(p.Owner())
+	beforeViews, _ := json.Marshal(v)
+	prepared, err := e.PrepareEndpointStudy([]*model.WorkloadView{v}, p)
+	if err != nil || len(prepared.Candidates) == 0 || observations == 0 {
+		t.Fatalf("real preparation failed: %+v %v", prepared, err)
+	}
+	afterViews, _ := json.Marshal(v)
+	if !reflect.DeepEqual(beforeState, e.ExportOwnerState(p.Owner())) || string(beforeViews) != string(afterViews) {
+		t.Fatal("offline preparation mutated owner state or input view")
+	}
+}
+
+func TestStudyRealContainmentAndHardGateOverridePrices(t *testing.T) {
+	for _, stateful := range []bool{false, true} {
+		v, p := m99Fixture()
+		e := NewCoverageEngine()
+		bindRotate(t, e, v, p) // required keys from the real production recon grant
+		p.EnabledActions = map[model.Action]bool{model.ActionRotate: true}
+		p.MayBreachSLO = true
+		studyWorkload(v)
+		v.Pod.Stateful = stateful
+		prepared, err := e.PrepareEndpointStudy([]*model.WorkloadView{v}, p)
+		if err != nil || !prepared.Mandatory {
+			t.Fatalf("mandatory fixture: %+v %v", prepared, err)
+		}
+		id := StudyCandidateID(p.PolicyUID, v.Pod.UID, model.ActionRotate)
+		tick := studyTickForPreparation(prepared, id)
+		arm := studyPrices(t, tick)
+		for _, lambda := range []float64{0, 1, 1e12} {
+			pick, err := prepared.SelectEndpointStudy(tick, arm, lambda)
+			if err != nil || (pick != nil) == stateful || (pick != nil && *pick != id) {
+				t.Fatalf("stateful=%v lambda=%v pick=%v err=%v", stateful, lambda, pick, err)
+			}
+		}
+	}
+}
+
+func TestStudyNegativePricedGainDoesNotAddAPricedWorthGate(t *testing.T) {
+	v, p := covView("candidate", true, 2*time.Hour, false), covPolicy(1)
+	p.PolicyUID, p.EnabledActions = "study-policy", map[model.Action]bool{model.ActionRotate: true}
+	studyWorkload(v)
+	prepared, err := NewCoverageEngine().PrepareEndpointStudy([]*model.WorkloadView{v}, p)
+	if err != nil || len(prepared.Candidates) != 1 {
+		t.Fatal(prepared, err)
+	}
+	tick := studyTickForPreparation(prepared, "")
+	arm := studyPrices(t, tick)
+	if arm.Pick == nil || arm.Rows[0].Cost.E == nil || *arm.Rows[0].Cost.E <= 0 {
+		t.Fatal("fixture must admit a positive-cost candidate")
+	}
+	pick, err := prepared.SelectEndpointStudy(tick, arm, 1e12)
+	if err != nil || !reflect.DeepEqual(pick, arm.Pick) {
+		t.Fatalf("negative priced gain silently vetoed: %v %v", pick, err)
+	}
+	wrong := *arm.Rows[0].V + 1
+	arm.Rows[0].V = &wrong
+	if _, err := prepared.SelectEndpointStudy(tick, arm, 1); err == nil {
+		t.Fatal("uploaded value displaced grounded source facts")
+	}
+}
+
+func TestStudyPreservesRealResourceAndFailureGates(t *testing.T) {
+	for _, gate := range []string{"resource", "failure"} {
+		v, p := covView("candidate", true, 2*time.Hour, false), covPolicy(1)
+		p.PolicyUID, p.EnabledActions = "study-policy", map[model.Action]bool{model.ActionRotate: true}
+		studyWorkload(v)
+		e := NewCoverageEngine()
+		if gate == "resource" {
+			p.SharedResourceCapacityConfigured, p.SharedResourceReservationsKnown = true, true
+			v.Pod.ServiceAvailabilityKnown = true // complete inventory says no target Service membership
+		} else {
+			e.FailureExclusion = func(*model.WorkloadView, model.Action) (string, bool) { return "cooldown-fixture", true }
+		}
+		prepared, err := e.PrepareEndpointStudy([]*model.WorkloadView{v}, p)
+		if err != nil || len(prepared.Candidates) != 1 || len(prepared.Candidates[0].Gates) == 0 {
+			t.Fatalf("lost gate=%s: %+v %v", gate, prepared, err)
+		}
+		reason := strings.Join(prepared.Candidates[0].Gates, ",")
+		if (gate == "resource" && !strings.Contains(reason, "resource-capacity")) || (gate == "failure" && !strings.Contains(reason, "cooldown-fixture")) {
+			t.Fatal(reason)
+		}
+		tick := studyTickForPreparation(prepared, "")
+		arm := studyPrices(t, tick)
+		pick, err := prepared.SelectEndpointStudy(tick, arm, 0)
+		if err != nil || pick != nil {
+			t.Fatalf("gate bypassed: %v %v", pick, err)
+		}
+	}
+}
diff --git a/phorvex/internal/mathlab/endpoint_study.go b/phorvex/internal/mathlab/endpoint_study.go
new file mode 100644
index 0000000000000000000000000000000000000000..b354a0b3eb4430b396c241b587784f57698d6b91
--- /dev/null
+++ b/phorvex/internal/mathlab/endpoint_study.go
@@ -0,0 +1,246 @@
+package mathlab
+
+import (
+	"fmt"
+	"reflect"
+	"sort"
+	"time"
+
+	"github.com/phorvex/phorvex/internal/cost/endpoint"
+	"github.com/phorvex/phorvex/internal/decision"
+	"github.com/phorvex/phorvex/internal/model"
+)
+
+const StudyCandidatesSchema = "math-lab.study-candidates.v1"
+
+// StudyCandidates binds the full pre-cost generator output to a verified
+// snapshot. Only endpoint measurement/history and declared study settings may
+// be enriched by the observer; source-owned candidate fields stay immutable.
+type StudyCandidates struct {
+	Schema                 string               `json:"schema"`
+	SnapshotDigest         string               `json:"snapshot_digest"`
+	SourceRevision         string               `json:"source_revision"`
+	SnapshotSourceRevision string               `json:"snapshot_source_revision"`
+	CrossVersion           bool                 `json:"cross_version"`
+	Observational          bool                 `json:"observational"`
+	Namespace              string               `json:"namespace"`
+	PolicyName             string               `json:"policy_name"`
+	PolicyUID              string               `json:"policy_uid"`
+	PolicyGeneration       int64                `json:"policy_generation"`
+	TickID                 string               `json:"tick_id"`
+	At                     float64              `json:"at"`
+	CapturedAt             float64              `json:"captured_at"`
+	WorkloadUID            string               `json:"workload_uid"`
+	SpecReplicas           *int                 `json:"spec_replicas"`
+	MaxMovesPerTick        int                  `json:"max_moves_per_tick"`
+	CandidateSetComplete   bool                 `json:"candidate_set_complete"`
+	Missing                []string             `json:"missing"`
+	MandatoryID            string               `json:"mandatory_id,omitempty"`
+	Candidates             []endpoint.Candidate `json:"candidates"`
+	BaselineReproduced     bool                 `json:"baseline_reproduced"`
+	FinalDecisions         []model.Decision     `json:"final_decisions"`
+	preparation            decision.StudyPreparation
+}
+
+// StudySource records the actual embedded replay identity. Cross-source use is
+// explicit and remains observational even when legacy decisions reproduce.
+type StudySource struct {
+	ReplayGitSHA      string
+	AllowCrossVersion bool
+}
+
+// ExportStudyCandidates runs exact baseline replay first, then the real shared
+// preparation with recorded impure collaborators and isolated owner state.
+func ExportStudyCandidates(s *Snapshot, source StudySource) StudyCandidates {
+	out := StudyCandidates{Schema: StudyCandidatesSchema, SnapshotDigest: s.Digest, SourceRevision: source.ReplayGitSHA,
+		SnapshotSourceRevision: s.Header.GitSHA, CrossVersion: source.ReplayGitSHA != s.Header.GitSHA, Observational: source.ReplayGitSHA != s.Header.GitSHA,
+		Namespace: s.Header.Namespace, PolicyName: s.Header.PolicyName, PolicyUID: s.Header.PolicyUID,
+		PolicyGeneration: s.Header.PolicyGeneration, TickID: s.Header.TickID,
+		At: float64(s.Header.DecidedAt.UnixNano()) / 1e9, CapturedAt: float64(s.Header.CapturedAt.UnixNano()) / 1e9,
+		MaxMovesPerTick: s.Inputs.Policy.MaxMovesPerTick, Missing: []string{}, Candidates: []endpoint.Candidate{}, FinalDecisions: []model.Decision{}}
+	if s.Final != nil {
+		out.FinalDecisions = s.Final.Decisions
+	}
+	if !fullGitSHA(source.ReplayGitSHA) || !fullGitSHA(s.Header.GitSHA) || (out.CrossVersion && !source.AllowCrossVersion) {
+		out.Missing = append(out.Missing, "VERSION_MISMATCH")
+		return out
+	}
+	baseline, err := Replay(s, ReplayOptions{Arms: []Arm{{ID: "baseline"}}})
+	if err != nil || len(baseline) != 1 || baseline[0].Status != StatusOK || baseline[0].Baseline == nil || !baseline[0].Baseline.Reproduced {
+		out.Missing = append(out.Missing, "BASELINE_NOT_EXACT")
+		return out
+	}
+	out.BaselineReproduced = true
+	if out.PolicyUID == "" || out.PolicyUID != s.Inputs.Policy.PolicyUID || out.Namespace != s.Inputs.Policy.Namespace {
+		out.Missing = append(out.Missing, "POLICY_IDENTITY_MISMATCH")
+		return out
+	}
+	for _, v := range s.Inputs.Views {
+		o := v.Pod.WorkloadSpec
+		if !o.Known || v.Pod.UID == "" || o.PodUID != v.Pod.UID || o.Workload.UID == "" || o.SpecReplicas <= 0 || v.Pod.Namespace != out.Namespace || o.Workload.Namespace != out.Namespace {
+			out.Missing = append(out.Missing, "WORKLOAD_SPEC_REPLICAS_MISSING:"+v.Pod.Name)
+			continue
+		}
+		n := int(o.SpecReplicas)
+		if out.WorkloadUID != "" && (out.WorkloadUID != o.Workload.UID || out.SpecReplicas == nil || *out.SpecReplicas != n) {
+			out.Missing = append(out.Missing, "STUDY_SCOPE_REQUIRES_ONE_WORKLOAD_UID_AND_SPEC")
+			continue
+		}
+		out.WorkloadUID, out.SpecReplicas = o.Workload.UID, &n
+	}
+	if out.WorkloadUID == "" {
+		out.Missing = append(out.Missing, "WORKLOAD_IDENTITY_MISSING")
+	}
+	err = withGlobals(s.Header, func() error {
+		engine := decision.NewCoverageEngine()
+		if engine.Recon == nil || engine.Recon.Name() != s.Header.ReconProfile || engine.Context == nil || engine.Context.Name() != s.Header.ContextProvider {
+			return fmt.Errorf("STUDY_ENGINE_PROFILE_MISMATCH")
+		}
+		engine.Now = func() time.Time { return s.Header.DecidedAt }
+		if err := engine.RestoreOwnerState(s.Inputs.Engine); err != nil {
+			return err
+		}
+		pb := newPlayback(s.Outcome)
+		if s.Outcome.CapabilityWired {
+			engine.Capability, engine.ShadowCapability = pb.capability, pb.capability
+		}
+		if s.Outcome.FailureWired {
+			engine.FailureExclusion = pb.failure
+		}
+		views, err := cloneViews(s.Inputs.Views)
+		if err != nil {
+			return err
+		}
+		out.preparation, err = engine.PrepareEndpointStudy(views, s.Inputs.Policy)
+		out.Candidates = out.preparation.Candidates
+		out.Missing = append(out.Missing, pb.missed()...)
+		return err
+	})
+	if err != nil {
+		out.Missing = append(out.Missing, err.Error())
+	}
+	if out.preparation.Mandatory {
+		// Retain the recorded deterministic containment winner. If the real
+		// baseline could not select containment, the study may not invent a fix.
+		out.MandatoryID = "required-containment-unavailable"
+		for _, d := range s.Outcome.Production {
+			if !d.Selected || d.Existential == nil || !d.Existential.Present {
+				continue
+			}
+			for _, v := range s.Inputs.Views {
+				if d.Namespace == v.Pod.Namespace && d.Pod == v.Pod.Name {
+					out.MandatoryID = decision.StudyCandidateID(out.PolicyUID, v.Pod.UID, d.Action)
+				}
+			}
+		}
+		if out.MandatoryID == "required-containment-unavailable" {
+			out.Missing = append(out.Missing, "RECORDED_CONTAINMENT_PRIORITY_UNAVAILABLE")
+		}
+	}
+	out.CandidateSetComplete = len(out.Missing) == 0
+	return out
+}
+
+type EndpointStudyResult struct {
+	endpoint.Result
+	ReplayGitSHA           string   `json:"replay_git_sha"`
+	SnapshotSourceRevision string   `json:"snapshot_source_revision"`
+	CrossVersion           bool     `json:"cross_version"`
+	Observational          bool     `json:"observational"`
+	BaselineExactCount     int      `json:"baseline_exact_count"`
+	SnapshotDigests        []string `json:"snapshot_digests"`
+	BrainParity            bool     `json:"brain_selection_parity"`
+}
+
+// RunEndpointStudy binds every normalized row to the actual pinned brain
+// preparation, then executes the shared brain selection loop for both arms.
+// Source fields are compared before the shared kernel sees enriched telemetry.
+func RunEndpointStudy(snapshots []*Snapshot, trace endpoint.Trace, cfg endpoint.Config, store endpoint.StateStore, source StudySource) (EndpointStudyResult, error) {
+	var out EndpointStudyResult
+	if trace.Evidence != "recorded" || len(snapshots) != len(trace.Ticks) || source.ReplayGitSHA != trace.SourceRevision {
+		return out, fmt.Errorf("BRAIN_STUDY_REQUIRES_EXACT_RECORDED_COHORT")
+	}
+	if err := endpoint.ValidateTrace(trace); err != nil {
+		return out, err
+	}
+	exports := map[string]StudyCandidates{}
+	scope := ""
+	for _, s := range snapshots {
+		if s == nil || exports[s.Digest].SnapshotDigest != "" || (out.SnapshotSourceRevision != "" && out.SnapshotSourceRevision != s.Header.GitSHA) {
+			return out, fmt.Errorf("BRAIN_STUDY_SOURCE_OR_DUPLICATE_SNAPSHOT")
+		}
+		out.SnapshotSourceRevision = s.Header.GitSHA
+		ex := ExportStudyCandidates(s, source)
+		if !ex.BaselineReproduced || !ex.CandidateSetComplete {
+			return out, fmt.Errorf("BRAIN_STUDY_SOURCE_UNAVAILABLE %s: %v", s.Digest, ex.Missing)
+		}
+		identity := ex.Namespace + "\x00" + ex.PolicyUID + "\x00" + ex.WorkloadUID
+		if scope != "" && scope != identity {
+			return out, fmt.Errorf("BRAIN_STUDY_COHORT_REQUIRES_ONE_POLICY_AND_WORKLOAD")
+		}
+		scope = identity
+		exports[s.Digest] = ex
+		out.SnapshotDigests = append(out.SnapshotDigests, s.Digest)
+		out.BaselineExactCount++
+	}
+	for _, t := range trace.Ticks {
+		ex, ok := exports[t.ID]
+		if !ok || t.At != ex.At || t.PolicyUID != ex.PolicyUID || t.WorkloadUID != ex.WorkloadUID || !reflect.DeepEqual(t.SpecReplicas, ex.SpecReplicas) || !t.CandidateSetComplete || t.MandatoryID != ex.MandatoryID {
+			return out, fmt.Errorf("BRAIN_STUDY_TICK_IDENTITY_MISMATCH: %s", t.ID)
+		}
+		if len(t.Candidates) != len(ex.Candidates) {
+			return out, fmt.Errorf("BRAIN_STUDY_CANDIDATE_POPULATION_MISMATCH: %s", t.ID)
+		}
+		byID := map[string]endpoint.Candidate{}
+		for _, c := range ex.Candidates {
+			byID[c.ID] = c
+		}
+		for _, c := range t.Candidates {
+			source, ok := byID[c.ID]
+			if !ok || c.PodUID != source.PodUID || c.Action != source.Action || c.Class != source.Class || c.Containment != source.Containment || c.FactsKnown != source.FactsKnown || c.GatesKnown != source.GatesKnown || !reflect.DeepEqual(c.Facts, source.Facts) || !reflect.DeepEqual(c.Gates, source.Gates) || (source.K != nil && !reflect.DeepEqual(c.K, source.K)) {
+				return out, fmt.Errorf("BRAIN_STUDY_SOURCE_CANDIDATE_MISMATCH: %s/%s", t.ID, c.ID)
+			}
+		}
+	}
+	result, err := endpoint.Run(trace, cfg, store)
+	if err != nil {
+		return out, err
+	}
+	byTick := map[string]endpoint.Tick{}
+	for _, t := range trace.Ticks {
+		byTick[t.ID] = t
+	}
+	for _, r := range result.Ticks {
+		ex := exports[r.ID]
+		for _, arm := range []endpoint.ArmResult{r.V2, r.V3} {
+			lambda := 0.0
+			if arm.Arm == "v3" {
+				lambda = r.Lambda.Effective
+			}
+			pick, err := ex.preparation.SelectEndpointStudy(byTick[r.ID], arm, lambda)
+			if err != nil || !reflect.DeepEqual(pick, arm.Pick) {
+				return out, fmt.Errorf("BRAIN_STUDY_SELECTION_PARITY_FAILED: %s/%s: %v", r.ID, arm.Arm, err)
+			}
+		}
+	}
+	out.Result, out.BrainParity = result, true
+	out.ReplayGitSHA = source.ReplayGitSHA
+	out.CrossVersion = source.ReplayGitSHA != out.SnapshotSourceRevision
+	out.Observational = out.CrossVersion
+	out.Mode = "PAIRED_BRAIN_REPLAY"
+	sort.Strings(out.SnapshotDigests)
+	out.Limitations = append(out.Limitations, "Both arms execute the pinned brain's shared non-cost preparation and selection predicates; shared endpoint pricing is experimental and offline. Recorded baseline replay is exact. No counterfactual action was actuated.")
+	return out, nil
+}
+
+func fullGitSHA(s string) bool {
+	if len(s) != 40 {
+		return false
+	}
+	for _, c := range s {
+		if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {
+			return false
+		}
+	}
+	return true
+}
diff --git a/phorvex/internal/mathlab/endpoint_study_test.go b/phorvex/internal/mathlab/endpoint_study_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..ef9d0e19e9cf8c520a7c3dd458145e68956dcca9
--- /dev/null
+++ b/phorvex/internal/mathlab/endpoint_study_test.go
@@ -0,0 +1,218 @@
+package mathlab
+
+import (
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/phorvex/phorvex/internal/cost"
+	"github.com/phorvex/phorvex/internal/cost/endpoint"
+	"github.com/phorvex/phorvex/internal/decision"
+	"github.com/phorvex/phorvex/internal/model"
+	"github.com/phorvex/phorvex/internal/recon"
+)
+
+const studyCaptureSHA = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
+const studyReplaySHA = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
+
+// The source is a real recorder/engine tick, not a fabricated final selection.
+func recordStudyTick(t *testing.T, reactive bool) *Snapshot {
+	t.Helper()
+	recon.Registry.SetDefault("ucw-recon")
+	engine := decision.NewCoverageEngine()
+	engine.Capability, engine.ShadowCapability = capabilityGate, capabilityGate
+	engine.FailureExclusion = func(*model.WorkloadView, model.Action) (string, bool) { return "", false }
+	pol, spec := fixturePolicy()
+	pol.GitSHA, pol.ReactiveOnly = studyCaptureSHA, reactive
+	now := time.Date(2026, 10, 31, 12, 0, 0, 0, time.UTC)
+	engine.Now = func() time.Time { return now }
+	views := fleet()
+	for _, v := range views {
+		v.Pod.WorkloadSpec = model.WorkloadSpecObservation{Known: true, PodUID: v.Pod.UID, ObservedAt: now,
+			Source: "test-controller-read", Workload: model.ObjectIdentity{Kind: "Deployment", Namespace: "vllm", Name: "fixture", UID: "workload-uid"}, SpecReplicas: 3}
+	}
+	sink := &memorySink{}
+	r, err := NewRecorder(Config{Policies: []string{"vllm/vllm-defense"}, GPUEnvelopeMax: cost.GPUEnvelopeMax()}, sink, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	capture := r.Begin(engine, spec, views, pol, now.Add(-time.Second))
+	decisions, err := engine.DecideChecked(views, pol)
+	capture.Decided(decisions, err)
+	capture.Finalize(decisions)
+	capture.Close()
+	if err != nil || len(sink.items) != 1 {
+		t.Fatalf("record tick: %v, items=%d", err, len(sink.items))
+	}
+	raw, err := assemble(sink.items[0].Header, sink.items[0].Stream)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s, err := Decode(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return s
+}
+
+func studyTrace(ex StudyCandidates) endpoint.Trace {
+	tick := endpoint.Tick{ID: ex.SnapshotDigest, At: ex.At, PolicyUID: ex.PolicyUID, WorkloadUID: ex.WorkloadUID,
+		SpecReplicas: ex.SpecReplicas, CandidateSetComplete: ex.CandidateSetComplete, MandatoryID: ex.MandatoryID,
+		SLO:    &endpoint.SLO{Target: .5, Window: 600, StudyAssumption: true},
+		Ledger: &endpoint.Ledger{At: ex.At, CompleteFrom: f(ex.At - 3600), Measurement: "watch-observed-service-ready-backends", Moves: []endpoint.Move{}}}
+	for _, c := range ex.Candidates {
+		one := 1
+		c.K, c.WorthThreshold, c.HistoryKnown = &one, f(0), true
+		c.HoldCap = f(30)
+		tick.Candidates = append(tick.Candidates, c)
+	}
+	return endpoint.Trace{Schema: endpoint.TraceSchema, SourceRevision: ex.SourceRevision, Evidence: "recorded", Ticks: []endpoint.Tick{tick}}
+}
+
+func studyConfig() endpoint.Config {
+	cfg := endpoint.Defaults()
+	cfg.Lookback = 60 // explicit short fixture study, never claimed as a day of history
+	return cfg
+}
+
+func TestEndpointStudyUsesRealPreCostPopulationAndExactBaseline(t *testing.T) {
+	s := recordStudyTick(t, false)
+	source := StudySource{ReplayGitSHA: studyCaptureSHA}
+	ex := ExportStudyCandidates(s, source)
+	if !ex.BaselineReproduced || !ex.CandidateSetComplete {
+		t.Fatalf("source unavailable: %+v", ex)
+	}
+	retained, vetoed := false, false
+	for _, c := range ex.Candidates {
+		if c.PodUID == "uid-unmeasured" && c.Action == "rotate" {
+			retained = len(c.Gates) == 0 && len(c.Facts) > 0
+		}
+		if c.PodUID == "uid-gated" && c.Action == "kv-reset" {
+			vetoed = len(c.Gates) > 0
+		}
+		if c.HistoryKnown || c.K != nil {
+			t.Fatal("source invented endpoint evidence")
+		}
+	}
+	if !retained || !vetoed {
+		t.Fatalf("cost-only survivor/non-cost veto missing: %+v", ex.Candidates)
+	}
+	trace := studyTrace(ex)
+	result, err := RunEndpointStudy([]*Snapshot{s}, trace, studyConfig(), endpoint.FileStore{Dir: t.TempDir()}, source)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.Mode != "PAIRED_BRAIN_REPLAY" || result.BaselineExactCount != 1 || !result.BrainParity || result.Comparable != 1 || result.Ticks[0].V2.Pick == nil {
+		t.Fatalf("real brain study did not run both arms: %+v", result)
+	}
+	if result.CrossVersion || result.Observational || result.ActualCharges != nil || result.VerifiedFacts != nil {
+		t.Fatal("source/counterfactual claims changed")
+	}
+	baseline, err := Replay(s, ReplayOptions{Arms: []Arm{{ID: "baseline"}}})
+	if err != nil || !baseline[0].Baseline.Reproduced {
+		t.Fatalf("study mutated production replay: %v", err)
+	}
+}
+
+func TestEndpointStudyCrossSourceIsExplicitAndRetainsBothIdentities(t *testing.T) {
+	s := recordStudyTick(t, false)
+	source := StudySource{ReplayGitSHA: studyReplaySHA}
+	ex := ExportStudyCandidates(s, source)
+	if ex.CandidateSetComplete || !reflect.DeepEqual(ex.Missing, []string{"VERSION_MISMATCH"}) {
+		t.Fatal(ex)
+	}
+	source.AllowCrossVersion = true
+	ex = ExportStudyCandidates(s, source)
+	if !ex.CandidateSetComplete || !ex.BaselineReproduced || !ex.CrossVersion || !ex.Observational || ex.SourceRevision != studyReplaySHA || ex.SnapshotSourceRevision != studyCaptureSHA {
+		t.Fatal(ex)
+	}
+	result, err := RunEndpointStudy([]*Snapshot{s}, studyTrace(ex), studyConfig(), endpoint.FileStore{Dir: t.TempDir()}, source)
+	if err != nil || result.ReplayGitSHA != studyReplaySHA || result.SnapshotSourceRevision != studyCaptureSHA || !result.CrossVersion || !result.Observational {
+		t.Fatalf("result=%+v err=%v", result, err)
+	}
+}
+
+func TestEndpointStudyRejectsChangedSourceFieldsAndMissingControls(t *testing.T) {
+	for _, change := range []string{"fact", "gate", "population", "tick", "workload", "baseline", "spec", "source"} {
+		t.Run(change, func(t *testing.T) {
+			s := recordStudyTick(t, false)
+			source := StudySource{ReplayGitSHA: studyCaptureSHA}
+			ex := ExportStudyCandidates(s, source)
+			trace := studyTrace(ex)
+			switch change {
+			case "fact":
+				trace.Ticks[0].Candidates[0].Facts = []endpoint.Fact{{ID: "invented", Weight: 999}}
+			case "gate":
+				trace.Ticks[0].Candidates[0].Gates = []string{"changed"}
+			case "population":
+				trace.Ticks[0].Candidates = trace.Ticks[0].Candidates[1:]
+			case "tick":
+				trace.Ticks[0].ID = "different"
+			case "workload":
+				trace.Ticks[0].WorkloadUID = "different"
+			case "baseline":
+				s.Outcome.Production = nil
+			case "spec":
+				s.Inputs.Views[0].Pod.WorkloadSpec.Known = false
+			case "source":
+				trace.SourceRevision = studyReplaySHA
+			}
+			_, err := RunEndpointStudy([]*Snapshot{s}, trace, studyConfig(), endpoint.FileStore{Dir: t.TempDir()}, source)
+			if err == nil {
+				t.Fatal("altered/missing source evidence accepted")
+			}
+		})
+	}
+}
+
+func TestEndpointStudyDoesNotBackdateHistory(t *testing.T) {
+	s := recordStudyTick(t, false)
+	source := StudySource{ReplayGitSHA: studyCaptureSHA}
+	trace := studyTrace(ExportStudyCandidates(s, source))
+	result, err := RunEndpointStudy([]*Snapshot{s}, trace, endpoint.Defaults(), endpoint.FileStore{Dir: t.TempDir()}, source)
+	if err != nil || result.State != "BLOCKED" || result.Comparable != 0 || result.MissingReasons["LOOKBACK_HISTORY_INCOMPLETE"] != 1 {
+		t.Fatalf("short history was accepted for a day-long lookback: state=%s missing=%v err=%v", result.State, result.MissingReasons, err)
+	}
+}
+
+func TestEndpointStudyMissingPriceCannotBeComparable(t *testing.T) {
+	for _, missing := range []string{"censored-duration", "quarantine-hold"} {
+		t.Run(missing, func(t *testing.T) {
+			s := recordStudyTick(t, false)
+			source := StudySource{ReplayGitSHA: studyCaptureSHA}
+			trace := studyTrace(ExportStudyCandidates(s, source))
+			for i := range trace.Ticks[0].Candidates {
+				c := &trace.Ticks[0].Candidates[i]
+				if missing == "quarantine-hold" && c.Action == "quarantine" {
+					c.HoldCap = nil
+				}
+				if missing == "censored-duration" {
+					c.Samples = []endpoint.Sample{{ID: "unfinished-calibration", WorkloadUID: trace.Ticks[0].WorkloadUID,
+						Action: "rotate", At: trace.Ticks[0].At - 1, Censored: true}}
+				}
+			}
+			result, err := RunEndpointStudy([]*Snapshot{s}, trace, studyConfig(), endpoint.FileStore{Dir: t.TempDir()}, source)
+			if err != nil || result.State != "BLOCKED" || result.Comparable != 0 || len(result.MissingReasons) == 0 || !result.BrainParity {
+				t.Fatalf("unknown price was comparable: state=%s count=%d missing=%v err=%v", result.State, result.Comparable, result.MissingReasons, err)
+			}
+		})
+	}
+}
