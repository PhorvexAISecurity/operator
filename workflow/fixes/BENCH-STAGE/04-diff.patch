+    {&quot;id&quot;: &quot;entropy&quot;, &quot;cost&quot;: {&quot;kind&quot;: &quot;endpoint-v1&quot;}, &quot;selector&quot;: {&quot;kind&quot;: &quot;entropy&quot;, &quot;tau&quot;: 1, &quot;epsilon&quot;: 0.5}},
