+++ b/benchmark/bot/guide-fa.html
@@ -0,0 +1,469 @@
+<!doctype html>
+<html lang="fa" dir="rtl">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="color-scheme" content="light">
+  <meta name="description" content="راهنمای عملی و مرحله‌به‌مرحله تغییر پارامتر، کد و فرمول برین و مقایسه نتایج از طریق بات تلگرام Phorvex.">
+  <title>راهنمای بنچمارک برین | Phorvex</title>
+  <style>
+    :root{--ink:#152638;--muted:#526678;--paper:#f4f7fa;--white:#fff;--line:#dce5ec;--navy:#112c43;--blue:#075eb6;--teal:#006c61;--mint:#e9f6f1;--amber:#835100;--sand:#fff6e5;--red:#9b3140;--rose:#fff0f2;--radius:18px;--mono:Consolas,"Liberation Mono",monospace}
+    *{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:32px}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.95 Tahoma,"Segoe UI",Arial,sans-serif}button,input,select,textarea{font:inherit}a{color:var(--blue);text-underline-offset:4px}a:hover{color:#003b73}button,a,input,select,textarea,summary{ -webkit-tap-highlight-color:transparent}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible{outline:3px solid #b87216;outline-offset:4px}button{cursor:pointer}button:disabled{cursor:default;opacity:.5}h1,h2,h3,h4,p{margin:0}h1,h2,h3,h4{line-height:1.65}h1{font-size:clamp(30px,4.2vw,47px);letter-spacing:-1.2px}h2{font-size:27px;letter-spacing:-.5px}h3{font-size:19px}h4{font-size:16px}p+p{margin-top:12px}small,.small{font-size:13px}strong{font-weight:700}code,kbd{font-family:var(--mono);direction:ltr;unicode-bidi:isolate;font-size:.91em}p code,li code,td code,label code,summary code{padding:2px 5px;border-radius:5px;background:#edf2f6;color:#17456a;overflow-wrap:anywhere}pre{margin:0;direction:ltr;text-align:left;unicode-bidi:isolate;white-space:pre-wrap;overflow-wrap:anywhere;tab-size:2;line-height:1.8;font:13px/1.85 var(--mono)}pre code{font:inherit}ul,ol{padding-inline-start:24px;margin:12px 0}li+li{margin-top:8px}hr{border:0;border-top:1px solid var(--line);margin:28px 0}.muted{color:var(--muted)}.ltr{direction:ltr;unicode-bidi:isolate;display:inline-block}.nowrap{white-space:nowrap}.skip{position:fixed;inset-block-start:-80px;inset-inline-start:20px;background:white;padding:8px 18px;z-index:30}.skip:focus{inset-block-start:12px}.progress{height:3px;position:fixed;inset:0 0 auto;z-index:20;background:var(--line)}.progress span{height:100%;display:block;width:0;background:#1aaa96;transition:width .1s}.shell{max-width:1440px;margin:auto;display:grid;grid-template-columns:250px minmax(0,1fr);gap:36px;padding:36px 36px 70px}.sidebar{position:sticky;top:28px;height:calc