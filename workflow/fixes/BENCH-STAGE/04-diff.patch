+    def run_study(self, job):
+        self.step(job, 'validating study configuration and trace evidence')
+        try:
+            result = study.run(study.strict_json(job.text), job.dir / 'study', self.cfg.data,
+                               cancelled=job.cancel.is_set, progress=lambda text: self.step(job, text))
+        except (ValueError, OSError) as err:
+            raise JobError('study: %s' % err) from err
+        root = job.dir / 'study'
+        job.state = 'DONE' if result['state'] == 'COMPLETE' else result['state']
+        headline = ('Study %s: %s; evidence=%s, history=%s. Reference-model experiment; '
+                    'verified counterfactual coverage and realized cost are not observed.' % (
+                        job.id, result['state'], result.get('evidence', 'unavailable'),
+                        result.get('history_mode', 'unavailable')))
+        if result.get('reason'):
+            headline += '\n' + result['reason']
+        for name in ('report.html', 'metrics.csv', 'result.json', 'evidence.zip'):
+            self.send_file(job.chat_id, 'study-%s-%s' % (job.id, name), (root / name).read_bytes())
+        self.say(job.chat_id, headline)
+        return headline
+
+    def run_endpoint(self, job, request=None):
+        if request is None:
+            request = endpoint_study.strict_json(job.text)
+        self.step(job, 'preflighting paired V2/V3 endpoint-cost inputs')
+        try:
+            result = endpoint_study.run(request, job.dir / 'endpoint', self.cfg.data,
+                                        progress=lambda s: self.step(job, s), cancelled=job.cancel.is_set)
+        except (ValueError, OSError) as err:
+            raise JobError('endpoint study: %s' % err) from err
+        job.state = 'DONE' if result['state'] == 'COMPLETE' else result['state']
+        mode = 'Source-pinned stage brain replay' if result.get('mode') == 'PAIRED_BRAIN_REPLAY' else 'Offline Go reference experiment'
+        if (result.get('runner') or {}).get('cross_version'):
+            mode += '; reviewed experimental source, cross-version observational comparison'
+        headline = 'Endpoint V2/V3: %s; %s comparable ticks; evidence=%s. %s.' % (
+            result['state'], result.get('comparable_ticks', 0), result.get('evidence', 'unavailable'), mode)
+        if result.get('reason'):
+            headline += '\n' + result['reason']
+        for name in ('report.html', 'metrics.csv', 'result.json', 'evidence.zip'):
+            self.send_file(job.chat_id, 'endpoint-%s-%s' % (job.id, name), (job.dir / 'endpoint' / name).read_bytes())
+        self.say(job.chat_id, headline)
