+package endpoint
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+type memoryStore struct {
+	data map[string]State
+	fail bool
+}
+
+func (s *memoryStore) Load(k string) (State, bool, error) { v, ok := s.data[k]; return v, ok, nil }
+func (s *memoryStore) Save(k string, v State) error {
+	if s.fail {
+		return fmt.Errorf("injected write failure")
+	}
+	s.data[k] = v
+	return nil
+}
+func memory() *memoryStore { return &memoryStore{data: map[string]State{}} }
+func iptr(v int) *int      { return &v }
+func near(t *testing.T, got, want float64) {
+	t.Helper()
+	if math.Abs(got-want) > 1e-8*math.Max(1, math.Abs(want)) {
+		t.Fatalf("got %.12g want %.12g", got, want)
+	}
+}
+func tick() Tick {
+	return Tick{ID: "t1", At: 3000000, WorkloadUID: "workload", PolicyUID: "policy", SpecReplicas: iptr(4), SLO: &SLO{Target: .999, Window: 2592000, StudyAssumption: true}, Ledger: &Ledger{At: 3000000, CompleteFrom: ptr(0), Measurement: "measured-endpoint-intervals", Moves: []Move{}}, CandidateSetComplete: true}
+}
+func candidate(id, action string, value float64) Candidate {
+	return Candidate{ID: id, PodUID: id, Action: action, Facts: []Fact{{ID: id, Weight: value}}, FactsKnown: true, GatesKnown: true, WorthThreshold: ptr(0), K: iptr(1), Class: "stateless", HistoryKnown: true}
+}
+func move(at float64) Move {
+	return Move{ID: "move", Revision: 1, WorkloadUID: "workload", PolicyUID: "policy", Action: "rotate", State: "open", ObservedAt: at, Attributed: true, Measured: true, Reservation: ptr(40), Overdue: true, Intervals: []Interval{{EndpointUID: "endpoint", Start: at - 100, End: at}}}
+}
+
+func TestBudgetAndColdCost(t *testing.T) {
+	in := tick()
+	b := Account(in, Defaults())
+	if b.Refusal != "" {
+		t.Fatal(b)
+	}
+	near(t, *b.R, 10368)
+	c := Price(in, candidate("a", "rotate", 10), b, Defaults())
+	near(t, *c.Rho, 159)
+	near(t, *c.E, 159)
+	near(t, *c.FailureUpper, 1)
+	d := candidate("a", "documented", 10)
+	d.DocumentedBound = &Bound{Source: "explicit unit fixture", Approved: true, Mid: 43, Upper: 43, FailureUpper: 0}
+	c = Price(in, d, b, Defaults())
+	near(t, *c.Rho, 159)
+	near(t, *c.E, 43)
+}
+func TestOrderStatisticAndClopperPearson(t *testing.T) {
+	if ConfidenceRank(28) != 0 || ConfidenceRank(29) != 29 {
+		t.Fatal("wrong 90/95 tolerance rank")
+	}
+	near(t, FailureUpper(29, 0), 1-math.Pow(.05, 1.0/29))
+	near(t, FailureUpper(200, 0), 1-math.Pow(.05, 1.0/200))
+	near(t, FailureUpper(9, 9), 1)
+	for _, pair := range [][2]int{{30, 3}, {100, 15}, {200, 199}} {
+		p := FailureUpper(pair[0], pair[1])
+		near(t, BinomialCDF(pair[0], pair[1], p), .05)
+	}
+	samples := []Sample{}
+	for i := 1; i <= 98; i++ {
+		samples = append(samples, Sample{Duration: ptr(float64(i))})
+	}
+	samples = append(samples, Sample{Censored: true}, Sample{Censored: true})
+	mid, upper, _ := Duration(samples, 43)
+	near(t, mid, 49.5)
+	if !finite(upper) || upper < mid {
+		t.Fatal(mid, upper)
+	}
+}
+func TestCensoringAndUnknownHistory(t *testing.T) {
+	in := tick()
+	c := candidate("a", "rotate", 10)
+	c.Samples = []Sample{{ID: "x", WorkloadUID: in.WorkloadUID, Action: "rotate", At: in.At - 1, Censored: true}}
+	price := Price(in, c, Account(in, Defaults()), Defaults())
+	if !strings.HasPrefix(price.Refusal, "BOUND_MISSING") || price.E != nil {
+		t.Fatal(price)
+	}
+	c.K = iptr(0)
+	price = Price(in, c, Account(in, Defaults()), Defaults())
+	near(t, *price.E, 0)
+	c.K = iptr(1)
+	c.Samples = nil
+	c.HistoryKnown = false
+	price = Price(in, c, Account(in, Defaults()), Defaults())
+	if price.E != nil {
+		t.Fatal("unknown history was treated as cold n=0")
+	}
+	c = candidate("a", "kv-reset", 10)
+	price = Price(in, c, Account(in, Defaults()), Defaults())
+	if price.E != nil {
+		t.Fatal("invented kv-reset prior")
+	}
+}
+func TestQuarantineBudgetFormula(t *testing.T) {
+	in := tick()
+	c := candidate("q", "quarantine", 10)
+	c.HoldCap = ptr(100)
+	p := Price(in, c, Account(in, Defaults()), Defaults())
+	near(t, *p.Rho, 259)
+	near(t, *p.E, 259)
+	near(t, *p.Hold, 100)
+	b := Account(in, Defaults())
+	b.Left = ptr(158)
+	p = Price(in, c, b, Defaults())
+	if !strings.HasPrefix(p.Refusal, "BUDGET") {
+		t.Fatal(p)
+	}
+}
+func TestNewest200Filtering(t *testing.T) {
+	in := tick()
+	c := candidate("a", "rotate", 10)
+	for i := 0; i < 201; i++ {
+		d := 50.0
+		if i == 0 {
+			d = 10000
+		}
+		c.Samples = append(c.Samples, Sample{ID: fmt.Sprint(i), WorkloadUID: in.WorkloadUID, Action: "rotate", At: in.At - 201 + float64(i), Duration: ptr(d)})
+	}
+	c.Samples = append(c.Samples, Sample{ID: "wrong", WorkloadUID: "other", Action: "rotate", At: in.At, Duration: ptr(1e6)})
+	p := Price(in, c, Account(in, Defaults()), Defaults())
+	if p.SampleCount != 200 {
+		t.Fatal(p.SampleCount)
+	}
+	near(t, *p.Upper, 50)
+}
+func TestOpenToSettledReplacementAndClipping(t *testing.T) {
+	in := tick()
+	m := move(in.At)
+	m.Intervals = append(m.Intervals, m.Intervals[0])
+	in.Ledger.Moves = []Move{m}
+	b := Account(in, Defaults())
+	near(t, *b.Used, 0)
+	near(t, *b.Held, 100)
+	near(t, *b.Spend, 100)
+	settled := m
+	settled.State = "settled"
+	settled.Revision = 2
+	settled.Reservation = nil
+	in.Ledger.Moves = append(in.Ledger.Moves, settled)
+	b = Account(in, Defaults())
+	near(t, *b.Used, 100)
+	near(t, *b.Held, 0)
+	near(t, *b.Spend, 100)
+	in.Ledger.Moves = []Move{settled, m}
+	b = Account(in, Defaults())
+	near(t, *b.Spend, 100)
+	near(t, intervalLoss(m.Intervals, in.At-50, in.At), 50)
+}
+
+func TestLedgerRevisionFreshnessAndRegressions(t *testing.T) {
+	in := tick()
+	old := move(in.At - 30)
+	settled := old
+	settled.State, settled.Revision, settled.ObservedAt = "settled", 2, in.At
+	for _, rows := range [][]Move{{old, settled}, {settled, old}} {
+		in.Ledger.Moves = rows
+		b := Account(in, Defaults())
+		if b.Refusal != "" {
+			t.Fatal("superseded open row must not fail freshness", b)
+		}
+		near(t, *b.Spend, 100)
+	}
+	in.Ledger.Moves = []Move{old}
+	if Account(in, Defaults()).Refusal != "OPEN_MOVE_OBSERVATION_STALE" {
+		t.Fatal("stale latest open accepted")
+	}
+	reopened := settled
+	reopened.State, reopened.Revision = "open", 3
+	for _, rows := range [][]Move{{settled, reopened}, {reopened, settled}} {
+		in.Ledger.Moves = rows
+		if Account(in, Defaults()).Refusal != "MOVE_REVISION_REGRESSED" {
+			t.Fatal("settled move reopened")
+		}
+	}
+}
+func TestContainmentExcludedFromLambdaNotBudget(t *testing.T) {
+	in := tick()
+	m := move(in.At)
+	m.Containment = true
+	m.State = "settled"
+	in.Ledger.Moves = []Move{m}
+	b := Account(in, Defaults())
+	near(t, *b.Used, 100)
+	near(t, *b.Spend, 0)
+}
+func TestUnknownTelemetryNeverBecomesZero(t *testing.T) {
+	for _, change := range []func(*Tick){func(t *Tick) { t.Ledger = nil }, func(t *Tick) { t.Ledger.Measurement = "replica-readiness" }, func(t *Tick) { t.Ledger.CompleteFrom = nil }, func(t *Tick) { t.Ledger.At-- }, func(t *Tick) { m := move(t.At); m.Measured = false; t.Ledger.Moves = []Move{m} }, func(t *Tick) { m := move(t.At); m.Attributed = false; t.Ledger.Moves = []Move{m} }} {
+		in := tick()
+		change(&in)
+		b := Account(in, Defaults())
+		if b.Spend != nil || b.Refusal == "" {
+			t.Fatal(b)
+		}
+	}
+}
+func TestLambdaBurnCasesAndClock(t *testing.T) {
+	cfg := Defaults()
+	for _, burn := range []float64{0, 1, 2} {
+		in := tick()
+		b := Account(in, cfg)
+		b.Spend = ptr(burn * cfg.Lookback * *b.R / in.SLO.Window)
+		ctl := NewController(cfg, memory())
+		ctl.states[in.WorkloadUID+"\x00"+in.PolicyUID] = State{Lambda: 1, At: in.At - 100, Tick: "prior"}
+		l := ctl.Update(in, b)
+		near(t, *l.B, burn)
+		near(t, *l.G, burn-1)
+		near(t, l.DT, 30)
+		near(t, *l.Next, math.Exp(cfg.Eta*30*(burn-1)))
+		dup := ctl.Update(in, b)
+		if dup.Effective != 0 || dup.Reason != "DUPLICATE_TICK" {
+			t.Fatal(dup)
+		}
+		in.At--
+		in.ID = "back"
+		back := ctl.Update(in, b)
+		if back.Effective != 0 || back.Reason != "CLOCK_BACKWARDS" {
+			t.Fatal(back)
+		}
+	}
+}
+func TestFloorWriteFailureRestartAndZeroCost(t *testing.T) {
+	in := tick()
+	b := Account(in, Defaults())
+	store := memory()
+	ctl := NewController(Defaults(), store)
+	l := ctl.Update(in, b)
+	if l.Effective != 0 || !l.AtFloor {
+		t.Fatal(l)
+	}
+	in.At += 10
+	in.ID = "t2"
+	store.fail = true
+	l = ctl.Update(in, b)
+	if l.Effective != 0 || l.Write != "FAILED" {
+		t.Fatal(l)
+	}
+	store.fail = false
+	in.At += 10
+	in.ID = "t3"
+	l = ctl.Update(in, b)
+	if l.Effective != 0 || l.Reason != "STATE_WRITE_FAILED" {
+		t.Fatal(l)
+	}
+	restarted := NewController(Defaults(), store)
+	l = restarted.Update(in, b)
+	if l.Effective != 0 || l.Reason != "RESTART_RESET_INACTIVE" {
+		t.Fatal(l)
+	}
+	c := candidate("zero", "rotate", 2)
+	c.K = iptr(0)
+	in.Candidates = []Candidate{c}
+	a := score(in, b, 100, Defaults(), "v3")
+	near(t, *a.Rows[0].J, 2)
+}
+func TestScaledOrderingWorthAndHardGates(t *testing.T) {
+	in := tick()
+	in.SpecReplicas = iptr(1)
+	in.SLO = &SLO{Target: .5, Window: 2000, StudyAssumption: true}
+	a, b := candidate("A", "doc-a", 10), candidate("B", "doc-b", 9)
+	a.DocumentedBound = &Bound{Source: "controlled example", Approved: true, Mid: 100, Upper: 100, FailureUpper: 0}
+	b.DocumentedBound = &Bound{Source: "controlled example", Approved: true, Mid: 1, Upper: 1, FailureUpper: 0}
+	in.Candidates = []Candidate{a, b}
+	budget := Account(in, Defaults())
+	v2 := score(in, budget, 0, Defaults(), "v2")
+	v3 := score(in, budget, 100/1000.0, Defaults(), "v3")
+	if *v2.Pick != "A" || *v3.Pick != "B" {
+		t.Fatal(v2.Pick, v3.Pick)
+	}
+	near(t, *v3.Rows[0].J, 0)
+	near(t, *v3.Rows[1].J, 8.9)
+	// Negative J is still eligible if V passes theta: no priced-worth gate.
+	negative := score(in, budget, 1000, Defaults(), "v3")
+	if negative.Pick == nil {
+		t.Fatal("invented priced-worth rejection")
+	}
+	in.Candidates[1].Gates = []string{"PDB"}
+	v3 = score(in, budget, .1, Defaults(), "v3")
+	if *v3.Pick != "A" {
+		t.Fatal("gate bypass")
+	}
+	in.MandatoryID = "A"
+	in.Candidates[0].Containment = true
+	v3 = score(in, budget, 100, Defaults(), "v3")
+	if *v3.Pick != "A" || *v3.Rows[0].J != 10 {
+		t.Fatal("containment priced")
+	}
+	in.Candidates[0].Gates = []string{"CAPACITY"}
+	v3 = score(in, budget, 100, Defaults(), "v3")
+	if v3.Pick != nil || v3.Noop != "NO_SAFE_CONTAINMENT_ACTION" {
+		t.Fatal("unsafe containment")
+	}
+}
+func TestFactDedupAndStableTie(t *testing.T) {
+	in := tick()
+	a := candidate("A", "rotate", 10)
+	a.Facts = append(a.Facts, a.Facts[0])
+	v, err := Value(a)
+	if err != "" {
+		t.Fatal(err)
+	}
+	near(t, *v, 10)
+	b := candidate("B", "rotate", 10)
+	in.Candidates = []Candidate{b, a}
+	r := score(in, Account(in, Defaults()), 0, Defaults(), "v2")
+	if *r.Pick != "A" {
+		t.Fatal("unstable tie")
+	}
+}
+func TestPairedRunChronologyIndependenceAndMissingStatus(t *testing.T) {
+	a := tick()
+	a.Candidates = []Candidate{candidate("a", "rotate", 10)}
+	b := a
+	b.At += 30
+	b.ID = "t2"
+	bl := *a.Ledger
+	bl.At = b.At
+	b.Ledger = &bl
+	trace := Trace{Schema: TraceSchema, Evidence: "synthetic", SourceRevision: "fixture", Ticks: []Tick{b, a}}
+	before, _ := json.Marshal(trace)
+	r, err := Run(trace, Defaults(), memory())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r.State != "COMPLETE" || r.Comparable != 2 || *r.Changed != 0 || r.Ticks[0].ID != "t1" {
+		t.Fatal(r.State, r.Comparable)
+	}
+	for _, tick := range r.Ticks {
+		if !tick.V2.Executed || !tick.V3.Executed || !reflect.DeepEqual(tick.V2.Rows[0].Cost, tick.V3.Rows[0].Cost) {
+			t.Fatal("arms not matched")
+		}
+	}
+	after, _ := json.Marshal(trace)
+	if string(before) != string(after) {
+		t.Fatal("trace mutated")
+	}
+	trace.Ticks[0].Ledger = nil
+	r, err = Run(trace, Defaults(), memory())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r.State != "PARTIAL" || r.Ticks[1].Changed != nil {
+		t.Fatal("missing data became zero effect")
+	}
+	trace.Ticks[1].Ledger = nil
+	r, err = Run(trace, Defaults(), memory())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r.State != "BLOCKED" || r.Changed != nil {
+		t.Fatal("blocked comparison marked complete")
+	}
+}
+func TestDurableStoreRoundTrip(t *testing.T) {
+	s := FileStore{Dir: t.TempDir()}
+	st := State{Lambda: 2, At: 123, Tick: "tick"}
+	if err := s.Save("workload/policy", st); err != nil {
+		t.Fatal(err)
+	}
+	got, ok, err := s.Load("workload/policy")
+	if err != nil || !ok || got != st {
+		t.Fatal(got, ok, err)
+	}
+}
+
+func TestRequiredPricingEvidenceControlsComparability(t *testing.T) {
+	type control struct {
+		name    string
+		prepare func(*Tick, *Candidate)
+		missing string
+		picked  bool
+	}
+	controls := []control{
+		{name: "known cold prior", prepare: func(_ *Tick, _ *Candidate) {}, picked: true},
+		{name: "censored rotate", prepare: func(in *Tick, c *Candidate) {
+			c.Samples = []Sample{{ID: "real-censored-observation", WorkloadUID: in.WorkloadUID, Action: c.Action, At: in.At - 1, Censored: true}}
+		}, missing: "BOUND_MISSING: censored or invalid upper estimate"},
+		{name: "quarantine missing hold cap", prepare: func(_ *Tick, c *Candidate) {
+			c.Action = "quarantine"
+		}, missing: "BOUND_MISSING: quarantine hold cap or remaining budget"},
+		{name: "unsupported kv-reset bound", prepare: func(_ *Tick, c *Candidate) {
+			c.Action = "kv-reset"
+		}, missing: "BOUND_MISSING: no approved action-specific duration bound (including kv-reset)"},
+		{name: "invalid negative endpoint impact", prepare: func(_ *Tick, c *Candidate) {
+			c.K = iptr(-1)
+		}, missing: "BOUND_MISSING: served endpoint impact k"},
+		{name: "known PDB veto needs no price", prepare: func(_ *Tick, c *Candidate) {
+			c.Gates = []string{"PDB"}
+			c.K = nil
+			c.HistoryKnown = false
+		}},
+		{name: "known worth rejection needs no price", prepare: func(_ *Tick, c *Candidate) {
+			c.WorthThreshold = ptr(10)
+			c.K = nil
+			c.HistoryKnown = false
+		}},
+		{name: "known budget rejection is comparable", prepare: func(in *Tick, _ *Candidate) {
+			in.SLO.Target = .9999999
+		}},
+		{name: "known quarantine hold budget rejection is comparable", prepare: func(in *Tick, c *Candidate) {
+			in.SLO.Target = .9999999
+			c.Action = "quarantine"
+			c.HoldCap = ptr(100)
+		}},
+		{name: "explicit bounded quarantine", prepare: func(_ *Tick, c *Candidate) {
+			c.Action = "quarantine"
+			c.HoldCap = ptr(1)
+		}, picked: true},
+	}
+	for _, test := range controls {
+		t.Run(test.name, func(t *testing.T) {
+			in := tick()
+			c := candidate("candidate", "rotate", 10)
+			test.prepare(&in, &c)
+			in.Candidates = []Candidate{c}
+			out, err := Run(Trace{Schema: TraceSchema, Evidence: "synthetic", SourceRevision: "producer-control", Ticks: []Tick{in}}, Defaults(), memory())
+			if err != nil {
+				t.Fatal(err)
+			}
+			got := out.Ticks[0]
+			if !got.V2.Executed || !got.V3.Executed {
+				t.Fatal("computed diagnostic arms falsely reported unexecuted")
+			}
+			if test.missing != "" {
+				if out.State != "BLOCKED" || got.State != "BLOCKED" || out.Comparable != 0 || out.Changed != nil || got.Changed != nil || out.MissingReasons[test.missing] != 1 {
+					t.Fatalf("unavailable price became a comparable NOOP: %+v", out)
+				}
+				if out.Noop != nil || out.Forecast != nil {
+					t.Fatal("blocked diagnostics entered aggregate comparison")
+				}
+			} else {
+				if out.State != "COMPLETE" || out.Comparable != 1 || out.Changed == nil || *out.Changed != 0 || len(out.MissingReasons) != 0 {
+					t.Fatalf("known eligibility decision became missing evidence: %+v", out)
+				}
+				if (got.V2.Pick != nil) != test.picked || (got.V3.Pick != nil) != test.picked {
+					t.Fatalf("unexpected positive-control choice: %+v", got)
+				}
+			}
+		})
+	}
+}
+
+func TestMixedRequiredPriceEvidenceIsPartial(t *testing.T) {
+	bad, good := tick(), tick()
+	bad.ID = "missing-price"
+	bad.Candidates = []Candidate{candidate("unknown-action-bound", "kv-reset", 10)}
+	good.ID = "known-price"
+	good.At += 30
+	good.Ledger.At = good.At
+	good.Candidates = []Candidate{candidate("known-rotate", "rotate", 10)}
+	out, err := Run(Trace{Schema: TraceSchema, Evidence: "synthetic", SourceRevision: "producer-control", Ticks: []Tick{bad, good}}, Defaults(), memory())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out.State != "PARTIAL" || out.Comparable != 1 || out.Changed == nil || *out.Changed != 0 || out.Ticks[0].Changed != nil || out.Ticks[1].Changed == nil {
+		t.Fatalf("missing price corrupted mixed-cohort comparison: %+v", out)
+	}
+	if out.ActualCharges != nil || out.VerifiedFacts != nil {
+		t.Fatal("counterfactual realized outcomes were invented")
+	}
+}
diff --git a/phorvex/internal/cost/endpoint/lambda.go b/phorvex/internal/cost/endpoint/lambda.go
new file mode 100644
index 0000000000000000000000000000000000000000..7f4f7b754ec0588b7c8fce038aa05bf3320cffd0
--- /dev/null
+++ b/phorvex/internal/cost/endpoint/lambda.go
@@ -0,0 +1,209 @@
+package endpoint
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"math"
+	"os"
+	"path/filepath"
+)
+
+type State struct {
+	Lambda float64 `json:"lambda_s"`
+	At     float64 `json:"at"`
+	Tick   string  `json:"tick"`
+}
+type StateStore interface {
+	Load(string) (State, bool, error)
+	Save(string, State) error
+}
+type FileStore struct{ Dir string }
+
+func (s FileStore) path(key string) string {
+	h := sha256.Sum256([]byte(key))
+	return filepath.Join(s.Dir, hex.EncodeToString(h[:])+".json")
+}
+func (s FileStore) Load(key string) (State, bool, error) {
+	var st State
+	raw, err := os.ReadFile(s.path(key))
+	if os.IsNotExist(err) {
+		return st, false, nil
+	}
+	if err != nil {
+		return st, false, err
+	}
+	err = json.Unmarshal(raw, &st)
+	return st, true, err
+}
+func (s FileStore) Save(key string, st State) error {
+	if err := os.MkdirAll(s.Dir, 0700); err != nil {
+		return err
+	}
+	raw, err := json.Marshal(st)
+	if err != nil {
+		return err
+	}
+	f, err := os.CreateTemp(s.Dir, ".lambda-")
+	if err != nil {
+		return err
+	}
+	name := f.Name()
+	defer os.Remove(name)
+	if _, err = f.Write(raw); err == nil {
+		err = f.Sync()
+	}
+	closeErr := f.Close()
+	if err != nil {
+		return err
+	}
+	if closeErr != nil {
+		return closeErr
+	}
+	if err = os.Rename(name, s.path(key)); err != nil {
+		return err
+	}
+	d, err := os.Open(s.Dir)
+	if err != nil {
+		return err
+	}
+	defer d.Close()
+	return d.Sync()
+}
+
+type Lambda struct {
+	Previous  *float64 `json:"lambda_prev"`
+	Next      *float64 `json:"lambda_next"`
+	Effective float64  `json:"lambda_eff"`
+	B         *float64 `json:"b"`
+	G         *float64 `json:"g"`
+	DT        float64  `json:"dt"`
+	S         *float64 `json:"S"`
+	R         *float64 `json:"R"`
+	Write     string   `json:"state_write"`
+	Reason    string   `json:"reason"`
+	AtFloor   bool     `json:"at_floor"`
+	AtCeiling bool     `json:"at_ceiling"`
+}
+type Controller struct {
+	Config   Config
+	Store    StateStore
+	states   map[string]State
+	restarts map[string]bool
+	poison   map[string]bool
+}
+
+func NewController(c Config, s StateStore) *Controller {
+	return &Controller{Config: c, Store: s, states: map[string]State{}, restarts: map[string]bool{}, poison: map[string]bool{}}
+}
+
+func (c *Controller) Update(t Tick, b Budget) Lambda {
+	out := Lambda{S: b.Spend, R: b.R, Write: "SKIPPED"}
+	key := t.WorkloadUID + "\x00" + t.PolicyUID
+	disable := func(reason string) Lambda { out.Reason = reason; out.Effective = 0; return out }
+	if t.WorkloadUID == "" || t.PolicyUID == "" || !finite(t.At) || t.At < 0 {
+		return disable("TICK_IDENTITY_OR_TIME_INVALID")
+	}
+	if c.poison[key] {
+		return disable("STATE_WRITE_FAILED")
+	}
+	if c.Store == nil {
+		return disable("DURABLE_STATE_UNAVAILABLE")
+	}
+	st, exists := c.states[key]
+	if !exists {
+		loaded, found, err := c.Store.Load(key)
+		if err != nil {
+			return disable("STATE_READ_FAILED")
+		}
+		if found {
+			st = loaded
+			c.restarts[key] = true
+			c.states[key] = st
+			exists = true
+		} else {
+			st = State{Lambda: c.Config.Min, At: t.At}
+		}
+	}
+	if !finite(st.Lambda) || st.Lambda < c.Config.Min || st.Lambda > c.Config.Max || !finite(st.At) {
+		return disable("STATE_INVALID")
+	}
+	out.Previous = ptr(st.Lambda)
+	out.Next = ptr(st.Lambda)
+	if t.At < st.At {
+		return disable("CLOCK_BACKWARDS")
+	}
+	if exists && (t.ID == st.Tick || t.At == st.At) {
+		return disable("DUPLICATE_TICK")
+	}
+	if b.R == nil || !finite(*b.R) || *b.R <= 0 {
+		return disable("BUDGET_R_UNAVAILABLE")
+	}
+	if b.Spend == nil || !finite(*b.Spend) || *b.Spend < 0 {
+		reason := b.TelemetryReason
+		if reason == "" {
+			reason = "MEASURED_MOVE_SPEND_MISSING"
+		}
+		return disable(reason)
+	}
+	if t.SLO == nil || !finite(t.SLO.Window) || t.SLO.Window <= 0 {
+		return disable("SLO_WINDOW_UNAVAILABLE")
+	}
+	burn := *b.Spend * t.SLO.Window / (c.Config.Lookback * *b.R)
+	if !finite(burn) {
+		return disable("NONFINITE_BURN_RATE")
+	}
+	g := clamp(burn-1, -1, c.Config.GMax)
+	dt := clamp(t.At-st.At, 0, c.Config.MaxDT)
+	out.B = ptr(burn)
+	out.G = ptr(g)
+	out.DT = dt
+	next := st.Lambda
+	if c.restarts[key] {
+		next = c.Config.Min
+		out.DT = 0
+		out.Reason = "RESTART_RESET_INACTIVE"
+	} else {
+		// Clamp in log space before exponentiation; overflow is never hidden
+		// by serializing an infinity or substituting a fabricated number.
+		next = math.Exp(clamp(math.Log(st.Lambda)+c.Config.Eta*dt*g, math.Log(c.Config.Min), math.Log(c.Config.Max)))
+		if next <= c.Config.Min*(1+1e-12) {
+			next = c.Config.Min
+		}
+		if next >= c.Config.Max*(1-1e-12) {
+			next = c.Config.Max
+		}
+	}
+	ns := State{Lambda: next, At: t.At, Tick: t.ID}
+	if err := c.Store.Save(key, ns); err != nil {
+		c.poison[key] = true
+		out.Write = "FAILED"
+		return disable("STATE_WRITE_FAILED")
+	}
+	c.states[key] = ns
+	delete(c.restarts, key)
+	out.Next = ptr(next)
+	out.Write = "COMMITTED"
+	out.AtFloor = next == c.Config.Min
+	out.AtCeiling = next == c.Config.Max
+	if !out.AtFloor && out.Reason == "" {
+		out.Effective = next / *b.R
+	}
+	if out.AtFloor && out.Reason == "" {
+		out.Reason = "AT_FLOOR_UNPRICED"
+	}
+	return out
+}
+
+func (c Config) Validate() error {
+	for _, v := range []float64{c.Lookback, c.Min, c.Max, c.Eta, c.GMax, c.MaxDT, c.Delta} {
+		if !finite(v) || v <= 0 {
+			return fmt.Errorf("controller constants must be positive and finite")
+		}
+	}
+	if c.Min >= c.Max || c.MaxDT > 30 || c.Lookback > 30*86400 || c.Max > 1e9 || c.Min < 1e-12 || c.Eta > 1 || c.GMax > 100 || c.Delta > 3600 {
+		return fmt.Errorf("controller constants outside experiment limits")
+	}
+	return nil
+}
diff --git a/phorvex/internal/cost/endpoint/ledger.go b/phorvex/internal/cost/endpoint/ledger.go
new file mode 100644
index 0000000000000000000000000000000000000000..202c18942b1d55478488a4c8ab0e1e5d36225077
--- /dev/null
+++ b/phorvex/internal/cost/endpoint/ledger.go
@@ -0,0 +1,222 @@
+package endpoint
+
+import (
+	"fmt"
+	"math"
+	"reflect"
+	"sort"
+)
+
+func latestMoves(t Tick) ([]Move, error) {
+	latest := map[string]Move{}
+	for _, m := range t.Ledger.Moves {
+		if m.ID == "" || m.Revision < 0 || m.WorkloadUID != t.WorkloadUID || m.PolicyUID != t.PolicyUID {
+			return nil, fmt.Errorf("MOVE_IDENTITY_MISSING_OR_MISMATCH")
+		}
+		if m.State != "open" && m.State != "settled" {
+			return nil, fmt.Errorf("MOVE_STATE_INVALID")
+		}
+		if !finite(m.ObservedAt) || m.ObservedAt > t.At || !m.Measured || !m.Attributed {
+			return nil, fmt.Errorf("MEASURED_MOVE_ATTRIBUTION_MISSING")
+		}
+		if old, ok := latest[m.ID]; ok {
+			if old.Action != m.Action || old.Containment != m.Containment {
+				return nil, fmt.Errorf("MOVE_IDENTITY_CHANGED")
+			}
+			if old.Revision == m.Revision && !reflect.DeepEqual(old, m) {
+				return nil, fmt.Errorf("CONFLICTING_MOVE_REVISION")
+			}
+			older, newer := old, m
+			if older.Revision > newer.Revision {
+				older, newer = newer, older
+			}
+			if older.Revision != newer.Revision && (newer.ObservedAt < older.ObservedAt || older.State == "settled" && newer.State == "open") {
+				return nil, fmt.Errorf("MOVE_REVISION_REGRESSED")
+			}
+			if old.Revision >= m.Revision {
+				continue
+			}
+			if old.State == "settled" && m.State == "open" {
+				return nil, fmt.Errorf("SETTLED_MOVE_REOPENED")
+			}
+		}
+		latest[m.ID] = m
+	}
+	ids := make([]string, 0, len(latest))
+	for id := range latest {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	out := make([]Move, 0, len(ids))
+	for _, id := range ids {
+		if latest[id].State == "open" && latest[id].ObservedAt != t.At {
+			return nil, fmt.Errorf("OPEN_MOVE_OBSERVATION_STALE")
+		}
+		out = append(out, latest[id])
+	}
+	// Intervals with the same endpoint identity are physical loss evidence.
+	// Overlap within a move is merged; overlap across distinct move identities
+	// makes attribution ambiguous and must not silently double-charge.
+	type tagged struct {
+		Interval
+		id string
+	}
+	byEndpoint := map[string][]tagged{}
+	for _, m := range out {
+		for _, iv := range m.Intervals {
+			if iv.EndpointUID == "" || !finite(iv.Start) || !finite(iv.End) || iv.Start < 0 || iv.End < iv.Start || iv.End > m.ObservedAt {
+				return nil, fmt.Errorf("ENDPOINT_INTERVAL_INVALID")
+			}
+			byEndpoint[iv.EndpointUID] = append(byEndpoint[iv.EndpointUID], tagged{iv, m.ID})
+		}
+	}
+	for _, ivs := range byEndpoint {
+		sort.Slice(ivs, func(i, j int) bool { return ivs[i].Start < ivs[j].Start })
+		for i, a := range ivs {
+			for _, b := range ivs[i+1:] {
+				if b.Start >= a.End {
+					break
+				}
+				if a.id != b.id {
+					return nil, fmt.Errorf("AMBIGUOUS_MOVE_ATTRIBUTION")
+				}
+			}
+		}
+	}
+	return out, nil
+}
+
+func intervalLoss(intervals []Interval, since, until float64) float64 {
+	byEndpoint := map[string][]Interval{}
+	for _, iv := range intervals {
+		iv.Start = math.Max(iv.Start, since)
+		iv.End = math.Min(iv.End, until)
+		if iv.End > iv.Start {
+			byEndpoint[iv.EndpointUID] = append(byEndpoint[iv.EndpointUID], iv)
+		}
+	}
+	keys := []string{}
+	for k := range byEndpoint {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	total := 0.0
+	for _, k := range keys {
+		ivs := byEndpoint[k]
+		sort.Slice(ivs, func(i, j int) bool {
+			if ivs[i].Start == ivs[j].Start {
+				return ivs[i].End < ivs[j].End
+			}
+			return ivs[i].Start < ivs[j].Start
+		})
+		start, end := ivs[0].Start, ivs[0].End
+		for _, iv := range ivs[1:] {
+			if iv.Start <= end {
+				end = math.Max(end, iv.End)
+			} else {
+				total += end - start
+				start, end = iv.Start, iv.End
+			}
+		}
+		total += end - start
+	}
+	return total
+}
+
+func Account(t Tick, cfg Config) Budget {
+	b := Budget{ActingAdmission: "BLOCKED: offline experiment"}
+	if t.SpecReplicas == nil || *t.SpecReplicas <= 0 {
+		b.Refusal = "WORKLOAD_SPEC_REPLICAS_MISSING"
+		return b
+	}
+	if t.SLO == nil || !finite(t.SLO.Target) || t.SLO.Target <= 0 || t.SLO.Target >= 1 || !finite(t.SLO.Window) || t.SLO.Window <= 0 {
+		b.Refusal = "SLO_CONTRACT_MISSING"
+		return b
+	}
+	if !t.SLO.Accepted && !t.SLO.StudyAssumption {
+		b.Refusal = "SLO_NOT_ACCEPTED_OR_DECLARED_STUDY_ASSUMPTION"
+		return b
+	}
+	r := (1 - t.SLO.Target) * t.SLO.Window * float64(*t.SpecReplicas)
+	if !finite(r) || r <= 0 {
+		b.Refusal = "SLO_BUDGET_INVALID"
+		return b
+	}
+	b.R = ptr(r)
+	if t.Ledger == nil {
+		b.Refusal = "ENDPOINT_LEDGER_MISSING"
+		b.TelemetryReason = b.Refusal
+		return b
+	}
+	l := t.Ledger
+	if !finite(l.At) || l.At != t.At {
+		b.Refusal = "LEDGER_SNAPSHOT_TIME_MISMATCH"
+		b.TelemetryReason = b.Refusal
+		return b
+	}
+	if l.Measurement != "measured-endpoint-intervals" && l.Measurement != "watch-observed-service-ready-backends" {
+		b.Refusal = "MEASURED_ENDPOINT_INTERVALS_MISSING"
+		b.TelemetryReason = b.Refusal
+		return b
+	}
+	moves, err := latestMoves(t)
+	if err != nil {
+		b.Refusal = err.Error()
+		b.TelemetryReason = b.Refusal
+		return b
+	}
+	from := l.CompleteFrom
+	if from == nil || !finite(*from) || *from > t.At {
+		b.Refusal = "LEDGER_COVERAGE_UNKNOWN"
+		b.TelemetryReason = b.Refusal
+		return b
+	}
+	used, held, spend := 0.0, 0.0, 0.0
+	holdsKnown := true
+	for _, m := range moves {
+		loss := intervalLoss(m.Intervals, t.At-t.SLO.Window, t.At)
+		if m.State == "settled" {
+			used += loss
+		} else {
+			if !nonnegative(m.Reservation) {
+				holdsKnown = false
+			} else {
+				hold := *m.Reservation
+				if m.Overdue {
+					hold = math.Max(hold, loss)
+				}
+				held += hold
+			}
+		}
+		if !m.Containment {
+			spend += intervalLoss(m.Intervals, t.At-cfg.Lookback, t.At)
+		}
+	}
+	if !finite(used) || !finite(held) || !finite(spend) {
+		b.Refusal = "NONFINITE_MEASURED_CONSUMPTION"
+		b.TelemetryReason = b.Refusal
+		return b
+	}
+	if *from <= t.At-cfg.Lookback {
+		b.Spend = ptr(spend)
+	} else {
+		b.TelemetryReason = "LOOKBACK_HISTORY_INCOMPLETE"
+	}
+	if *from > t.At-t.SLO.Window {
+		b.Refusal = "BUDGET_WINDOW_HISTORY_INCOMPLETE"
+		return b
+	}
+	b.Used = ptr(used)
+	if !holdsKnown {
+		b.Refusal = "OPEN_MOVE_RESERVATION_MISSING"
+		return b
+	}
+	b.Held = ptr(held)
+	b.Left = ptr(r - used - held)
+	if !l.Authoritative {
+		b.ActingAdmission = "BLOCKED: shadow ledger is not authoritative"
+	} else if !t.SLO.Accepted {
+		b.ActingAdmission = "BLOCKED: study SLO is not tenant acceptance"
+	}
+	return b
+}
diff --git a/phorvex/internal/cost/endpoint/run.go b/phorvex/internal/cost/endpoint/run.go
new file mode 100644
index 0000000000000000000000000000000000000000..cd863fca29557cfa86ae51355c627bc4dfebd6a7
--- /dev/null
+++ b/phorvex/internal/cost/endpoint/run.go
@@ -0,0 +1,379 @@
+package endpoint
+
+import (
+	"encoding/json"
+	"fmt"
+	"sort"
+	"strings"
+)
+
+type Row struct {
+	ID          string   `json:"candidate_id"`
+	Action      string   `json:"action"`
+	V           *float64 `json:"V"`
+	J           *float64 `json:"J"`
+	Cost        Cost     `json:"cost"`
+	Admitted    bool     `json:"admitted"`
+	Selected    bool     `json:"selected"`
+	Containment bool     `json:"containment"`
+	Refusals    []string `json:"refusals"`
+}
+type ArmResult struct {
+	Arm      string  `json:"arm"`
+	Executed bool    `json:"executed"`
+	Pick     *string `json:"pick"`
+	Noop     string  `json:"noop_reason,omitempty"`
+	Rows     []Row   `json:"candidates"`
+}
+type TickResult struct {
+	ID          string    `json:"tick_id"`
+	At          float64   `json:"at"`
+	WorkloadUID string    `json:"workload_uid"`
+	PolicyUID   string    `json:"policy_uid"`
+	State       string    `json:"state"`
+	Budget      Budget    `json:"budget"`
+	Lambda      Lambda    `json:"lambda"`
+	V2          ArmResult `json:"v2"`
+	V3          ArmResult `json:"v3"`
+	Changed     *bool     `json:"changed"`
+}
+type Result struct {
+	Schema         string             `json:"schema"`
+	State          string             `json:"state"`
+	Mode           string             `json:"mode"`
+	Evidence       string             `json:"evidence"`
+	SourceRevision string             `json:"source_revision"`
+	Config         Config             `json:"config"`
+	Ticks          []TickResult       `json:"ticks"`
+	Comparable     int                `json:"comparable_ticks"`
+	Changed        *int               `json:"changed_choices"`
+	Noop           map[string]int     `json:"noop"`
+	Forecast       map[string]float64 `json:"forecast_endpoint_seconds"`
+	ActualCharges  any                `json:"counterfactual_actual_charges"`
+	VerifiedFacts  any                `json:"counterfactual_verified_facts"`
+	MissingReasons map[string]int     `json:"missing_reasons"`
+	Limitations    []string           `json:"limitations"`
+}
+
+func Value(c Candidate) (*float64, string) {
+	if !c.FactsKnown {
+		return nil, "GROUNDED_FACTS_MISSING"
+	}
+	weights := map[string]float64{}
+	for _, f := range c.Facts {
+		if f.ID == "" || !finite(f.Weight) || f.Weight < 0 {
+			return nil, "FACT_INVALID"
+		}
+		if w, ok := weights[f.ID]; ok && w != f.Weight {
+			return nil, "FACT_WEIGHT_CONFLICT"
+		}
+		weights[f.ID] = f.Weight
+	}
+	keys := []string{}
+	for key := range weights {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	v := 0.0
+	for _, key := range keys {
+		v += weights[key]
+	}
+	if !finite(v) {
+		return nil, "FACT_VALUE_NONFINITE"
+	}
+	return ptr(v), ""
+}
+
+func score(t Tick, b Budget, lambda float64, cfg Config, arm string) ArmResult {
+	out := ArmResult{Arm: arm, Executed: true, Rows: []Row{}}
+	for _, c := range t.Candidates {
+		v, reason := Value(c)
+		row := Row{ID: c.ID, Action: c.Action, V: v, Containment: c.Containment, Refusals: append([]string{}, c.Gates...)}
+		if !t.CandidateSetComplete {
+			row.Refusals = append(row.Refusals, "CANDIDATE_SET_INCOMPLETE")
+		}
+		if !c.GatesKnown {
+			row.Refusals = append(row.Refusals, "NON_COST_GATES_MISSING")
+		}
+		if reason != "" {
+			row.Refusals = append(row.Refusals, reason)
+		}
+		row.Cost = Price(t, c, b, cfg)
+		if row.Cost.Refusal != "" {
+			row.Refusals = append(row.Refusals, row.Cost.Refusal)
+		}
+		if b.Refusal != "" {
+			row.Refusals = append(row.Refusals, b.Refusal)
+		}
+		if b.Left != nil && row.Cost.Rho != nil && *row.Cost.Rho != 0 && *row.Cost.Rho > *b.Left {
+			row.Refusals = append(row.Refusals, "BUDGET")
+		}
+		if !c.Containment {
+			if !nonnegative(c.WorthThreshold) {
+				row.Refusals = append(row.Refusals, "WORTH_THRESHOLD_MISSING")
+			} else if v != nil && *v <= *c.WorthThreshold {
+				row.Refusals = append(row.Refusals, "BELOW_V_WORTH_THRESHOLD")
+			}
+		}
+		if v != nil && row.Cost.E != nil {
+			j := *v
+			if !c.Containment {
+				j -= lambda * *row.Cost.E
+			}
+			if finite(j) {
+				row.J = ptr(j)
+			} else {
+				row.Refusals = append(row.Refusals, "NONFINITE_J")
+			}
+		}
+		row.Admitted = len(row.Refusals) == 0 && row.J != nil
+		out.Rows = append(out.Rows, row)
+	}
+	// Deterministic pre-existing containment priority is supplied explicitly;
+	// a failed mandatory action never becomes a licence to price containment.
+	if t.MandatoryID != "" {
+		for i := range out.Rows {
+			if out.Rows[i].ID == t.MandatoryID && out.Rows[i].Containment && out.Rows[i].Admitted {
+				out.Rows[i].Selected = true
+				id := out.Rows[i].ID
+				out.Pick = &id
+				return out
+			}
+		}
+		out.Noop = "NO_SAFE_CONTAINMENT_ACTION"
+		return out
+	}
+	best := -1
+	for i, r := range out.Rows {
+		if r.Containment {
+			out.Noop = "MANDATORY_PRIORITY_MISSING"
+			return out
+		}
+		if !r.Admitted {
+			continue
+		}
+		if best < 0 || better(r, out.Rows[best]) {
+			best = i
+		}
+	}
+	if best < 0 {
+		out.Noop = "NO_FEASIBLE_CANDIDATE"
+		return out
+	}
+	out.Rows[best].Selected = true
+	id := out.Rows[best].ID
+	out.Pick = &id
+	return out
+}
+func better(a, b Row) bool {
+	if *a.J != *b.J {
+		return *a.J > *b.J
+	}
+	if *a.V != *b.V {
+		return *a.V > *b.V
+	}
+	if *a.Cost.E != *b.Cost.E {
+		return *a.Cost.E < *b.Cost.E
+	}
+	return a.ID < b.ID
+}
+
+// pricingNeeded distinguishes an unevaluated price from a known rejection.
+// An established non-cost veto or the existing V<=theta rule already excludes
+// the candidate independently of price. Unknown facts/gates/thresholds cannot
+// establish that exclusion; Run records those missing inputs separately.
+func pricingNeeded(c Candidate) bool {
+	if c.GatesKnown && len(c.Gates) > 0 {
+		return false
+	}
+	if !c.Containment && nonnegative(c.WorthThreshold) {
+		if v, reason := Value(c); reason == "" && v != nil && *v <= *c.WorthThreshold {
+			return false
+		}
+	}
+	return true
+}
+
+func ValidateTrace(t Trace) error {
+	if t.Schema != TraceSchema || (t.Evidence != "recorded" && t.Evidence != "synthetic") {
+		return fmt.Errorf("unsupported endpoint trace schema/evidence")
+	}
+	if t.SourceRevision == "" || len(t.Ticks) == 0 || len(t.Ticks) > 5000 {
+		return fmt.Errorf("source revision and 1..5000 ticks required")
+	}
+	if t.Evidence == "recorded" {
+		if len(t.SourceRevision) != 40 {
+			return fmt.Errorf("recorded source revision must be a full SHA")
+		}
+		for _, c := range t.SourceRevision {
+			if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {
+				return fmt.Errorf("invalid source revision")
+			}
+		}
+	}
+	seen, times := map[string]bool{}, map[string]bool{}
+	total := 0
+	for _, tick := range t.Ticks {
+		if tick.ID == "" || seen[tick.ID] || tick.WorkloadUID == "" || tick.PolicyUID == "" || !finite(tick.At) || tick.At < 0 {
+			return fmt.Errorf("duplicate/missing tick identity or invalid timestamp")
+		}
+		seen[tick.ID] = true
+		timeKey := fmt.Sprintf("%s/%g", tick.PolicyUID, tick.At)
+		if times[timeKey] {
+			return fmt.Errorf("simultaneous policy ticks require one joined candidate set; do not split a policy tick across workloads")
+		}
+		times[timeKey] = true
+		if len(tick.Candidates) > 256 {
+			return fmt.Errorf("maximum 256 candidates per tick")
+		}
+		total += len(tick.Candidates)
+		ids, pairs := map[string]bool{}, map[string]bool{}
+		for _, c := range tick.Candidates {
+			pair := c.PodUID + "\x00" + c.Action
+			if c.ID == "" || c.PodUID == "" || c.Action == "" || ids[c.ID] || pairs[pair] {
+				return fmt.Errorf("missing/duplicate candidate identity")
+			}
+			ids[c.ID] = true
+			pairs[pair] = true
+			if len(c.Facts) > 512 || len(c.Samples) > 2000 {
+				return fmt.Errorf("candidate facts/history exceeds bounds")
+			}
+		}
+		if tick.MandatoryID != "" && !ids[tick.MandatoryID] {
+			return fmt.Errorf("mandatory candidate not present")
+		}
+		if tick.Ledger != nil {
+			if len(tick.Ledger.Moves) > 10000 {
+				return fmt.Errorf("ledger exceeds 10000 move observations")
+			}
+			for _, m := range tick.Ledger.Moves {
+				if len(m.Intervals) > 1000 {
+					return fmt.Errorf("move interval limit exceeded")
+				}
+			}
+		}
+	}
+	if total > 100000 {
+		return fmt.Errorf("candidate output limit exceeded")
+	}
+	return nil
+}
+
+func Run(trace Trace, cfg Config, store StateStore) (Result, error) {
+	out := Result{Schema: ResultSchema, State: "BLOCKED", Mode: "PAIRED_GO_REFERENCE", Evidence: trace.Evidence, SourceRevision: trace.SourceRevision, Config: cfg, Ticks: []TickResult{}, Noop: map[string]int{"v2": 0, "v3": 0}, Forecast: map[string]float64{"v2": 0, "v3": 0}, MissingReasons: map[string]int{}, Limitations: []string{
+		"Offline Go experiment on explicitly supplied candidate facts/gates and telemetry; not a deployed production V3 implementation.",
+		"V2 and V3 use identical new endpoint costs, budget gates and candidates. Only optional ordering is priced in V3; B=1.",
+		"No entropy, history picker, counterfactual spend feedback or priced-worth gate. Counterfactual actual costs and verified security effects are unknown.",
+		"Class priors, rollback proxy, lambda constants and explicitly declared SLO defaults are study assumptions, not production approval.",
+		"Candidate producers must establish real fact-to-action mapping, all non-cost safety gates, containment priority and historical telemetry. An uploaded fixture does not prove production provenance.",
+		"An arm's executed flag means its scoring code ran. Only comparable ticks with complete required inputs contribute to changed choices, NOOP counts or forecast totals.",
+	}}
+	if err := cfg.Validate(); err != nil {
+		return out, err
+	}
+	if err := ValidateTrace(trace); err != nil {
+		return out, err
+	}
+	// Copy before sorting; every arm sees the exact same immutable recorded input.
+	ticks := append([]Tick(nil), trace.Ticks...)
+	sort.Slice(ticks, func(i, j int) bool {
+		if ticks[i].At == ticks[j].At {
+			return ticks[i].ID < ticks[j].ID
+		}
+		return ticks[i].At < ticks[j].At
+	})
+	controller := NewController(cfg, store)
+	changed := 0
+	for _, t := range ticks {
+		b := Account(t, cfg)
+		l := controller.Update(t, b)
+		r := TickResult{ID: t.ID, At: t.At, WorkloadUID: t.WorkloadUID, PolicyUID: t.PolicyUID, State: "COMPLETE", Budget: b, Lambda: l}
+		r.V2 = score(t, b, 0, cfg, "v2")
+		r.V3 = score(t, b, l.Effective, cfg, "v3")
+		missing := []string{}
+		if !t.CandidateSetComplete {
+			missing = append(missing, "CANDIDATE_SET_INCOMPLETE")
+		}
+		if b.Refusal != "" {
+			missing = append(missing, b.Refusal)
+		}
+		if b.Spend == nil {
+			missing = append(missing, l.Reason)
+		}
+		if l.Write != "COMMITTED" {
+			missing = append(missing, l.Reason)
+		}
+		for i, c := range t.Candidates {
+			if !c.GatesKnown {
+				missing = append(missing, "NON_COST_GATES_MISSING")
+			}
+			if !c.FactsKnown {
+				missing = append(missing, "GROUNDED_FACTS_MISSING")
+			}
+			if !c.Containment && !nonnegative(c.WorthThreshold) {
+				missing = append(missing, "WORTH_THRESHOLD_MISSING")
+			}
+			if _, reason := Value(c); reason != "" {
+				missing = append(missing, reason)
+			}
+			if pricingNeeded(c) {
+				if c.K == nil {
+					missing = append(missing, "ENDPOINT_MEMBERSHIP_MISSING")
+				}
+				if c.K != nil && *c.K > 0 && !c.HistoryKnown && (c.Action == "rotate" || c.Action == "request-drain" || c.Action == "quarantine") {
+					missing = append(missing, "DURATION_HISTORY_MISSING")
+				}
+				// Price is identical in both arms. A missing/censored/invalid
+				// bound is unavailable evidence, not a successful NOOP. A
+				// known BUDGET refusal remains a valid comparable rejection.
+				if reason := r.V2.Rows[i].Cost.Refusal; strings.HasPrefix(reason, "BOUND_MISSING:") {
+					missing = append(missing, reason)
+				}
+			}
+		}
+		if len(missing) > 0 {
+			r.State = "BLOCKED"
+			unique := map[string]bool{}
+			for _, reason := range missing {
+				if reason != "" && !unique[reason] {
+					out.MissingReasons[reason]++
+					unique[reason] = true
+				}
+			}
+		} else {
+			out.Comparable++
+			different := (r.V2.Pick == nil) != (r.V3.Pick == nil) || (r.V2.Pick != nil && r.V3.Pick != nil && *r.V2.Pick != *r.V3.Pick)
+			r.Changed = &different
+			if different {
+				changed++
+			}
+			for _, arm := range []ArmResult{r.V2, r.V3} {
+				if arm.Pick == nil {
+					out.Noop[arm.Arm]++
+				}
+				for _, row := range arm.Rows {
+					if row.Selected && row.Cost.E != nil {
+						out.Forecast[arm.Arm] += *row.Cost.E
+					}
+				}
+			}
+		}
+		out.Ticks = append(out.Ticks, r)
+	}
+	if out.Comparable > 0 {
+		out.Changed = &changed
+		out.State = "PARTIAL"
+	} else {
+		out.Noop = nil
+		out.Forecast = nil
+	}
+	if out.Comparable == len(ticks) {
+		out.State = "COMPLETE"
+	}
+	// Check all emitted diagnostics for JSON finiteness, including supplied input
+	// values that were rejected. Never let a NaN turn a missing-data report into success.
+	if _, err := json.Marshal(out); err != nil {
+		return Result{}, fmt.Errorf("nonfinite result: %w", err)
+	}
+	return out, nil
+}
diff --git a/phorvex/internal/cost/endpoint/types.go b/phorvex/internal/cost/endpoint/types.go
new file mode 100644
index 0000000000000000000000000000000000000000..adc62713f04ca4ff44b0a3362c48be19d03e6858
--- /dev/null
+++ b/phorvex/internal/cost/endpoint/types.go
@@ -0,0 +1,152 @@
+// Package endpoint implements an offline paired endpoint-cost experiment.
+// It has no Kubernetes client or actuator and never changes the production brain.
+package endpoint
+
+import "math"
+
+const TraceSchema = "phorvex-bench.endpoint-trace.v1"
+const ResultSchema = "phorvex-bench.endpoint-result.v1"
+
+type Trace struct {
+	Schema         string `json:"schema"`
+	Evidence       string `json:"evidence"` // synthetic or recorded; provenance remains visible
+	SourceRevision string `json:"source_revision"`
+	Ticks          []Tick `json:"ticks"`
+}
+
+type Tick struct {
+	ID                   string      `json:"id"`
+	At                   float64     `json:"at"` // recorded Unix seconds, never wall-clock substitution
+	WorkloadUID          string      `json:"workload_uid"`
+	PolicyUID            string      `json:"policy_uid"`
+	SpecReplicas         *int        `json:"spec_replicas"`
+	SLO                  *SLO        `json:"slo"`
+	Ledger               *Ledger     `json:"ledger"`
+	Candidates           []Candidate `json:"candidates"`
+	CandidateSetComplete bool        `json:"candidate_set_complete"`
+	MandatoryID          string      `json:"mandatory_id,omitempty"` // original deterministic containment winner
+}
+
+type SLO struct {
+	Target          float64 `json:"target"`
+	Window          float64 `json:"window"`
+	Accepted        bool    `json:"accepted"`
+	StudyAssumption bool    `json:"study_assumption"`
+}
+
+type Ledger struct {
+	At            float64  `json:"at"`
+	CompleteFrom  *float64 `json:"complete_from"`
+	Authoritative bool     `json:"authoritative"`
+	Measurement   string   `json:"measurement"` // measured intervals or explicitly labelled watch-observed Service readiness
+	Moves         []Move   `json:"moves"`
+}
+
+type Interval struct {
+	EndpointUID string  `json:"endpoint_uid"`
+	Start       float64 `json:"start"`
+	End         float64 `json:"end"`
+}
+
+type Move struct {
+	ID          string     `json:"id"`
+	Revision    int        `json:"revision"`
+	WorkloadUID string     `json:"workload_uid"`
+	PolicyUID   string     `json:"policy_uid"`
+	Action      string     `json:"action"`
+	Containment bool       `json:"containment"`
+	State       string     `json:"state"` // open or settled
+	ObservedAt  float64    `json:"observed_at"`
+	Attributed  bool       `json:"attributed"`
+	Measured    bool       `json:"measured"` // explicit measured zero is distinct from missing
+	Intervals   []Interval `json:"intervals"`
+	Reservation *float64   `json:"reservation"`
+	Overdue     bool       `json:"overdue"`
+}
+
+type Sample struct {
+	ID          string   `json:"id"`
+	WorkloadUID string   `json:"workload_uid"`
+	Action      string   `json:"action"`
+	At          float64  `json:"at"`
+	Duration    *float64 `json:"duration"` // null + censored means a retained right-censored outcome
+	Censored    bool     `json:"censored"`
+	Overdue     bool     `json:"overdue"`
+	Suspect     bool     `json:"suspect"`
+}
+
+type Fact struct {
+	ID     string  `json:"id"`
+	Weight float64 `json:"weight"` // grounded provenance-adjusted security points
+}
+
+type Candidate struct {
+	ID             string   `json:"id"`
+	PodUID         string   `json:"pod_uid"`
+	Action         string   `json:"action"`
+	Facts          []Fact   `json:"facts"`
+	FactsKnown     bool     `json:"facts_known"`
+	Gates          []string `json:"gates"` // real non-cost veto reasons from the pinned generator
+	GatesKnown     bool     `json:"gates_known"`
+	WorthThreshold *float64 `json:"worth_threshold"`
+	Containment    bool     `json:"containment"`
+	K              *int     `json:"k"`
+	Class          string   `json:"class"`
+	HistoryKnown   bool     `json:"history_known"`
+	Samples        []Sample `json:"samples"`
+	HoldCap        *float64 `json:"hold_cap"`
+	// Additional actions may only use a specifically approved documented bound.
+	DocumentedBound *Bound `json:"documented_bound,omitempty"`
+}
+
+type Bound struct {
+	Source       string  `json:"source"`
+	Approved     bool    `json:"approved"`
+	Mid          float64 `json:"mid"`
+	Upper        float64 `json:"upper"`
+	FailureUpper float64 `json:"failure_upper"`
+}
+
+type Cost struct {
+	E            *float64 `json:"E"`
+	Rho          *float64 `json:"rho"`
+	Mid          *float64 `json:"T_mid"`
+	Upper        *float64 `json:"T_upper"`
+	FailureUpper *float64 `json:"p_f"`
+	Flow         *float64 `json:"C_flow"`
+	Norm         *float64 `json:"C_norm"`
+	SampleCount  int      `json:"sample_count"`
+	Hold         *float64 `json:"H_eff,omitempty"`
+	Refusal      string   `json:"refusal,omitempty"`
+	Rollback     string   `json:"rollback"`
+}
+
+type Budget struct {
+	R               *float64 `json:"R"`
+	Used            *float64 `json:"used"`
+	Held            *float64 `json:"held"`
+	Left            *float64 `json:"R_left"`
+	Spend           *float64 `json:"S"`
+	Refusal         string   `json:"refusal,omitempty"`
+	TelemetryReason string   `json:"telemetry_reason,omitempty"`
+	ActingAdmission string   `json:"acting_admission"`
+}
+
+type Config struct {
+	Lookback float64 `json:"lookback"`
+	Min      float64 `json:"min"`
+	Max      float64 `json:"max"`
+	Eta      float64 `json:"eta"`
+	GMax     float64 `json:"g_max"`
+	MaxDT    float64 `json:"max_dt"`
+	Delta    float64 `json:"delta"`
+}
+
+func Defaults() Config {
+	return Config{Lookback: 86400, Min: .0001, Max: 1000, Eta: math.Log(1e7) / 3600, GMax: 1, MaxDT: 30, Delta: 30}
+}
+
+func finite(v float64) bool           { return !math.IsNaN(v) && !math.IsInf(v, 0) }
+func ptr(v float64) *float64          { return &v }
+func nonnegative(v *float64) bool     { return v != nil && finite(*v) && *v >= 0 }
+func clamp(v, lo, hi float64) float64 { return math.Max(lo, math.Min(v, hi)) }
