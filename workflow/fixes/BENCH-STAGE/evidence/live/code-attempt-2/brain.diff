+package model
+
+import (
+	"fmt"
+	"math"
+)
+
+// EstimateEndpointSecondsV2 computes rho, C_flow, C_norm and E for the
+// experimental endpoint-second model from explicit inputs. Durations are in
+// seconds and results are in endpoint-seconds. k must be integer-valued and pF
+// must be in [0,1]. No bounds, history estimates or probabilities are derived.
+func EstimateEndpointSecondsV2(k, d, delta, tRB, hTail, tMid, pF float64) (rho, cFlow, cNorm, expected float64, err error) {
+	for _, input := range []struct {
+		name  string
+		value float64
+	}{
+		{"k", k},
+		{"D", d},
+		{"delta", delta},
+		{"T_rb", tRB},
+		{"H_tail", hTail},
+		{"T_mid", tMid},
+		{"p_f", pF},
+	} {
+		if math.IsNaN(input.value) || math.IsInf(input.value, 0) || input.value < 0 {
+			return 0, 0, 0, 0, fmt.Errorf("endpoint-seconds v2 %s must be finite and nonnegative", input.name)
+		}
+	}
+	if math.Trunc(k) != k {
+		return 0, 0, 0, 0, fmt.Errorf("endpoint-seconds v2 k must be an integer")
+	}
+	if pF > 1 {
+		return 0, 0, 0, 0, fmt.Errorf("endpoint-seconds v2 p_f must be between 0 and 1")
+	}
+	if d < tMid {
+		return 0, 0, 0, 0, fmt.Errorf("endpoint-seconds v2 requires D >= T_mid")
+	}
+
+	rho = k*(d+delta+tRB) + hTail
+	cFlow = k * tMid
+	cNorm = pF * (k*(d-tMid+delta+tRB) + hTail)
+	expected = cFlow + cNorm
+	for _, output := range []struct {
+		name  string
+		value float64
+	}{
+		{"rho", rho},
+		{"C_flow", cFlow},
+		{"C_norm", cNorm},
+		{"E", expected},
+	} {
+		if math.IsNaN(output.value) || math.IsInf(output.value, 0) || output.value < 0 {
+			return 0, 0, 0, 0, fmt.Errorf("endpoint-seconds v2 output %s must be finite and nonnegative", output.name)
+		}
+	}
+	return rho, cFlow, cNorm, expected, nil
+}
