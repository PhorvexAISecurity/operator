+package model
+
+import (
+	"math"
+	"testing"
+)
+
+func TestEstimateEndpointSecondsV2(t *testing.T) {
+	// Inputs are k, D, delta, T_rb, H_tail, T_mid, p_f.
+	for _, tc := range []struct {
+		name   string
+		inputs [7]float64
+		want   [4]float64
+	}{
+		{"A_certain_failure", [7]float64{1, 43, 30, 43, 43, 43, 1}, [4]float64{159, 43, 116, 159}},
+		{"B_no_failure", [7]float64{1, 43, 30, 43, 43, 43, 0}, [4]float64{159, 43, 0, 43}},
+		{"C_partial_failure", [7]float64{2, 50, 30, 50, 100, 40, 0.25}, [4]float64{360, 80, 70, 150}},
+		{"D_no_endpoints_or_tail", [7]float64{0, 43, 30, 43, 0, 43, 1}, [4]float64{}},
+		{"zero_inputs", [7]float64{}, [4]float64{}},
+		{"tail_without_endpoints", [7]float64{0, 43, 30, 43, 43, 43, 0.5}, [4]float64{43, 0, 21.5, 21.5}},
+		{"fractional_seconds", [7]float64{1, 0.5, 0.25, 0.5, 0.25, 0.25, 0.5}, [4]float64{1.5, 0.25, 0.625, 0.875}},
+		{"finite_limit", [7]float64{1, math.MaxFloat64, 0, 0, 0, math.MaxFloat64, 0}, [4]float64{math.MaxFloat64, math.MaxFloat64, 0, math.MaxFloat64}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			in := tc.inputs
+			rho, cFlow, cNorm, expected, err := EstimateEndpointSecondsV2(in[0], in[1], in[2], in[3], in[4], in[5], in[6])
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got := [4]float64{rho, cFlow, cNorm, expected}; got != tc.want {
+				t.Fatalf("(rho, C_flow, C_norm, E) = %v, want %v", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestEstimateEndpointSecondsV2RejectsInvalidInputs(t *testing.T) {
+	for index, name := range []string{"k", "D", "delta", "T_rb", "H_tail", "T_mid", "p_f"} {
+		for _, bad := range []struct {
+			name  string
+			value float64
+		}{
+			{"negative", -1},
+			{"NaN", math.NaN()},
+			{"positive_infinity", math.Inf(1)},
+			{"negative_infinity", math.Inf(-1)},
+		} {
+			t.Run(name+"/"+bad.name, func(t *testing.T) {
+				in := [7]float64{1, 43, 30, 43, 43, 43, 1}
+				in[index] = bad.value
+				if _, _, _, _, err := EstimateEndpointSecondsV2(in[0], in[1], in[2], in[3], in[4], in[5], in[6]); err == nil {
+					t.Fatalf("accepted invalid inputs: %v", in)
+				}
+			})
+		}
+	}
+
+	for _, tc := range []struct {
+		name   string
+		inputs [7]float64
+	}{
+		{"fractional_count", [7]float64{1.5, 43, 30, 43, 43, 43, 1}},
+		{"probability_above_one", [7]float64{1, 43, 30, 43, 43, 43, 1.01}},
+		{"mid_exceeds_D", [7]float64{1, 42, 30, 43, 43, 43, 1}},
+		{"duration_sum_overflow", [7]float64{1, math.MaxFloat64, math.MaxFloat64, 0, 0, 0, 1}},
+		{"endpoint_product_overflow", [7]float64{2, math.MaxFloat64, 0, 0, 0, math.MaxFloat64, 1}},
+		{"tail_sum_overflow", [7]float64{1, math.MaxFloat64, 0, 0, math.MaxFloat64, 0, 1}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			in := tc.inputs
+			if _, _, _, _, err := EstimateEndpointSecondsV2(in[0], in[1], in[2], in[3], in[4], in[5], in[6]); err == nil {
+				t.Fatalf("accepted invalid inputs: %v", in)
+			}
+		})
+	}
+}
