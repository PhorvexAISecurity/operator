index 0000000..031666f
--- /dev/null
+++ b/phorvex/internal/runner/codeexec_m99_test.go
@@ -0,0 +1,71 @@
+/*
+ * Phorvex — the deterministic intelligence layer for R6/Phoenix AMTD. (M-6)
+ *
+ * M99 coexistence regression: the qualified-outcome / SLO-breach path must NOT be able to
+ * re-admit a code-exec move whose API-server admission is unverified. The production tick
+ * closure is codeExecAwareEligibility; these tests exercise that exact function so the
+ * precedence (full gate first, M99 no-rbac fallback only when eligible) cannot regress.
+ */
+
+package runner
+
+import (
+	"context"
+	"testing"
+
+	"github.com/phorvex/phorvex/internal/capability"
+	"github.com/phorvex/phorvex/internal/model"
+)
+
+type fakeAdmission struct {
+	ok     bool
+	reason string
+}
+
+func (f fakeAdmission) Available(map[string]string) (bool, string) { return f.ok, f.reason }
+
+func unverifiedCodeExecWitness() capability.Witness {
+	// Empty fleet/index; no installability gaps; no SSAR checker; code-exec admission
+	// UNVERIFIED for the labelled namespace.
+	return capability.BuildWitness(context.Background(), capability.BuildIndex(nil, nil, nil), nil, nil, nil).
+		WithCodeExec(
+			fakeAdmission{ok: false, reason: capability.ReasonCodeExec + ": not verified"},
+			map[string]map[string]string{"ns": {"phorvex.ai/codeexec-managed": "true"}},
+		)
+}
+
+func TestM99CannotBypassCodeExecAdmissionGate(t *testing.T) {
+	wit := unverifiedCodeExecWitness()
+	v := &model.WorkloadView{Pod: model.Pod{Namespace: "ns", Name: "victim"}}
+	qualified := func(*model.WorkloadView) bool { return true } // M99 active
+
+	// authzNil=true + qualified outcome = the M99 fallback path. A code-exec move is STILL
+	// excluded by the admission leg, attributed to the code-exec class — never re-admitted.
+	for _, action := range []model.Action{model.ActionDebugger, model.ActionCustomInject} {
+		got := codeExecAwareEligibility(wit, true, qualified, v, action, []string{"cover-key"})
+		if got == nil || !got.Excluded {
+			t.Fatalf("%s must be excluded under M99 (authzNil+qualified), got %+v", action, got)
+		}
+		if got.Kind != capability.ReasonCodeExec {
+			t.Fatalf("%s exclusion must be attributed to %q, got %q", action, capability.ReasonCodeExec, got.Kind)
+		}
+	}
+}
+
+// Positive control: a non-code-exec action that is otherwise eligible still receives the
+// M99 no-rbac marker under authzNil+qualified — proving the extraction preserved the M99
+// path exactly and the code-exec leg does not disturb it.
+func TestM99NoRBACPathPreservedForNonCodeExec(t *testing.T) {
+	wit := unverifiedCodeExecWitness()
+	v := &model.WorkloadView{Pod: model.Pod{Namespace: "ns", Name: "victim"}}
+	got := codeExecAwareEligibility(wit, true, func(*model.WorkloadView) bool { return true }, v, model.ActionRotate, []string{"cover-key"})
+	if got == nil || !got.Excluded || got.Kind != capability.ReasonNoRBAC {
+		t.Fatalf("rotate under M99+authzNil must carry the m99 no-rbac marker, got %+v", got)
+	}
+	// And with a live SSAR checker (authzNil=false) + no qualified outcome, an eligible action
+	// is not excluded at all.
+	got = codeExecAwareEligibility(wit, false, func(*model.WorkloadView) bool { return false }, v, model.ActionRotate, []string{"cover-key"})
+	if got != nil {
+		t.Fatalf("rotate with live authz and no qualified outcome must be eligible, got %+v", got)
+	}
+}
diff --git a/phorvex/internal/runner/codeexec_presubmit_test.go b/phorvex/internal/runner/codeexec_presubmit_test.go
new file mode 100644
index 0000000..b0e7062
--- /dev/null
+++ b/phorvex/internal/runner/codeexec_presubmit_test.go
@@ -0,0 +1,71 @@
+/*
+ * Phorvex — the deterministic intelligence layer for R6/Phoenix AMTD. (M-6)
+ *
+ * The pre-submit admission gate at the actuate boundary: a code-exec move (debugger/custom-
+ * inject) is dispatched ONLY after a fresh FinalCheck (by namespace identity) passes. Fail-
+ * closed on a nil verifier (unwired) and on an unverified/unavailable verifier; a verified+in-
+ * scope verifier lets the dispatch proceed (positive control). Guards both direct dispatch and
+ * any queued work reaching this boundary.
+ */
+
+package runner
+
+import (
+	"context"
+	"testing"
+
+	"github.com/go-logr/logr"
+
+	"github.com/phorvex/phorvex/internal/capability"
+	"github.com/phorvex/phorvex/internal/model"
+)
+
+// fakeAdmissionFinal implements the runner's codeExecVerifier (Available + FinalCheck).
+type fakeAdmissionFinal struct {
+	ok     bool
+	reason string
+	sawNS  string
+}
+
+func (f *fakeAdmissionFinal) Available(map[string]string) (bool, string) { return f.ok, f.reason }
+func (f *fakeAdmissionFinal) FinalCheck(_ context.Context, namespace string) (bool, string) {
+	f.sawNS = namespace
+	return f.ok, f.reason
+}
+
+func TestCodeExecPreSubmitGateFailsClosed(t *testing.T) {
+	view := map[string]*model.WorkloadView{
+		"ns/p1": {Pod: model.Pod{Namespace: "ns", Name: "p1", ReadyReplicas: 3}},
+	}
+	dec := func() []model.Decision {
+		return []model.Decision{{Selected: true, Feasible: true, Action: model.ActionDebugger, Namespace: "ns", Pod: "p1"}}
+	}
+	pol := model.Policy{Tenant: "t", EnabledActions: map[model.Action]bool{model.ActionDebugger: true}}
+	e := &policyEntry{namespace: "ns"}
+
+	// (a) nil verifier (unwired) => fail-closed, zero actuations.
+	fa := &fakeActuator{}
+	m := &Manager{Actuator: fa, Log: logr.Discard()}
+	if n := m.actuate(context.Background(), e, pol, dec(), view); n != 0 || fa.calls != 0 {
+		t.Fatalf("nil verifier must fail-closed (n=%d, Actuate calls=%d)", n, fa.calls)
+	}
+
+	// (b) unavailable verifier => refused before the irreversible submit; FinalCheck saw the
+	// target namespace identity (not stale labels).
+	fa = &fakeActuator{}
+	adm := &fakeAdmissionFinal{ok: false, reason: capability.ReasonCodeExec + ": not verified"}
+	m = &Manager{Actuator: fa, Log: logr.Discard(), CodeExec: adm}
+	if n := m.actuate(context.Background(), e, pol, dec(), view); n != 0 || fa.calls != 0 {
+		t.Fatalf("unavailable verifier must refuse dispatch (n=%d, Actuate calls=%d)", n, fa.calls)
+	}
+	if adm.sawNS != "ns" {
+		t.Fatalf("FinalCheck must receive the target namespace identity, saw %q", adm.sawNS)
+	}
+
+	// (c) verified => the code-exec gate does not block; dispatch proceeds once.
+	fa = &fakeActuator{}
+	m = &Manager{Actuator: fa, Log: logr.Discard(), CodeExec: &fakeAdmissionFinal{ok: true}}
+	if n := m.actuate(context.Background(), e, pol, dec(), view); n != 1 || fa.calls != 1 {
+		t.Fatalf("verified verifier must allow dispatch (n=%d, Actuate calls=%d)", n, fa.calls)
+	}
+}
