diff --git a/phorvex/internal/capability/gate_codeexec_test.go b/phorvex/internal/capability/gate_codeexec_test.go
new file mode 100644
index 0000000..645addb
--- /dev/null
+++ b/phorvex/internal/capability/gate_codeexec_test.go
@@ -0,0 +1,89 @@
+/*
+ * Phorvex — the deterministic intelligence layer for R6/Phoenix AMTD. (M-6)
+ *
+ * The T1-E gate's code-exec admission leg: debugger/custom-inject are offered ONLY when the
+ * admission verifier reports available for the target namespace; the exclusion is attributed
+ * to the distinct ReasonCodeExec class; non-code-exec actions are unaffected; and the tick's
+ * per-namespace labels are threaded to the verifier (the C3 scope input).
+ */
+
+package capability
+
+import (
+	"testing"
+
+	"github.com/phorvex/phorvex/internal/model"
+)
+
+// recordingAdmission is a fake AdmissionVerifier: it returns a configured verdict and records
+// the namespace labels the gate passed (to prove the C3 scope input is threaded through).
+type recordingAdmission struct {
+	ok        bool
+	reason    string
+	sawLabels map[string]string
+	calls     int
+}
+
+func (r *recordingAdmission) Available(nsLabels map[string]string) (bool, string) {
+	r.calls++
+	r.sawLabels = nsLabels
+	return r.ok, r.reason
+}
+
+func codeExecView() *model.WorkloadView {
+	return &model.WorkloadView{Pod: model.Pod{Namespace: "ns", Name: "victim"}}
+}
+
+func TestEligible_CodeExecUnverifiedExcluded(t *testing.T) {
+	_, wit := capFleet()
+	adm := &recordingAdmission{ok: false, reason: ReasonCodeExec + ": not verified"}
+	wit = wit.WithCodeExec(adm, map[string]map[string]string{"ns": {"phorvex.ai/codeexec-managed": "true"}})
+
+	for _, action := range []model.Action{model.ActionDebugger, model.ActionCustomInject} {
+		r := wit.Eligible(codeExecView(), action, []string{"cover-key"})
+		if r == nil || !r.Excluded {
+			t.Fatalf("%s must be excluded when admission is unverified", action)
+		}
+		if r.Kind != ReasonCodeExec {
+			t.Fatalf("%s exclusion must be attributed to %q, got %q (detail %q)", action, ReasonCodeExec, r.Kind, r.Detail)
+		}
+	}
+	// The tick's namespace labels were threaded to the verifier (C3 scope input).
+	if adm.sawLabels["phorvex.ai/codeexec-managed"] != "true" {
+		t.Fatalf("gate must pass the target namespace labels to the verifier, saw %v", adm.sawLabels)
+	}
+}
+
+func TestEligible_CodeExecVerifiedOffered(t *testing.T) {
+	_, wit := capFleet()
+	adm := &recordingAdmission{ok: true}
+	wit = wit.WithCodeExec(adm, map[string]map[string]string{"ns": {"phorvex.ai/codeexec-managed": "true"}})
+	for _, action := range []model.Action{model.ActionDebugger, model.ActionCustomInject} {
+		if r := wit.Eligible(codeExecView(), action, []string{"cover-key"}); r != nil {
+			t.Fatalf("%s must be eligible when admission is verified+in-scope, got %+v", action, r)
+		}
+	}
+}
+
+// A non-code-exec action is never touched by the code-exec leg (even with a verifier that
+// reports unavailable): rotate stays eligible.
+func TestEligible_NonCodeExecUnaffectedByAdmissionLeg(t *testing.T) {
+	_, wit := capFleet()
+	adm := &recordingAdmission{ok: false, reason: "unverified"}
+	wit = wit.WithCodeExec(adm, map[string]map[string]string{"ns": {"x": "y"}})
+	if r := wit.Eligible(codeExecView(), model.ActionRotate, []string{"cover-key"}); r != nil {
+		t.Fatalf("rotate must be unaffected by the code-exec admission leg, got %+v", r)
+	}
+	if adm.calls != 0 {
+		t.Fatalf("the admission verifier must not be consulted for a non-code-exec action (calls=%d)", adm.calls)
+	}
+}
+
+// A nil verifier (unit fixtures that do not wire one) skips the leg — never a hard failure.
+// The runtime path always wires a real verifier, so this documents the fixture-only behavior.
+func TestEligible_NilVerifierSkipsLeg(t *testing.T) {
+	_, wit := capFleet()
+	if r := wit.Eligible(codeExecView(), model.ActionDebugger, []string{"cover-key"}); r != nil {
+		t.Fatalf("with no verifier wired the leg is skipped; got exclusion %+v", r)
+	}
+}
diff --git a/phorvex/internal/codeexec/cel_eval_test.go b/phorvex/internal/codeexec/cel_eval_test.go
new file mode 100644
index 0000000..343e049
--- /dev/null
+++ b/phorvex/internal/codeexec/cel_eval_test.go
@@ -0,0 +1,237 @@
+/*
+ * Phorvex — the deterministic intelligence layer for R6/Phoenix AMTD. (M-6)
+ *
+ * Real CEL SEMANTIC evaluation of the SHIPPED ValidatingAdmissionPolicy expressions (parsed
+ * from config/admission/codeexec-ephemeral-vap.yaml) with cel-go: the compliant debugger and
+ * custom-inject requests are ALLOWED (every validation true), and each isolated violation is
+ * DENIED by its own validation (attributable). This exercises the expressions, not string
+ * matches. It is NOT real API-server admission (that is L3) — it evaluates the same CEL text
+ * the API server would, over crafted object/oldObject/request/variables activations.
+ */
+
+package codeexec
+
+import (
+	"context"
+	"testing"
+
+	"github.com/google/cel-go/cel"
+)
+
+func celEnv(t *testing.T) *cel.Env {
+	t.Helper()
+	env, err := cel.NewEnv(
+		cel.Variable("object", cel.DynType),
+		cel.Variable("oldObject", cel.DynType),
+		cel.Variable("request", cel.DynType),
+		cel.Variable("variables", cel.DynType),
+	)
+	if err != nil {
+		t.Fatalf("cel env: %v", err)
+	}
+	return env
+}
+
+func celEval(t *testing.T, env *cel.Env, expr string, act map[string]any) any {
+	t.Helper()
+	ast, iss := env.Compile(expr)
+	if iss != nil && iss.Err() != nil {
+		t.Fatalf("compile %q: %v", expr, iss.Err())
+	}
+	prg, err := env.Program(ast)
+	if err != nil {
+		t.Fatalf("program %q: %v", expr, err)
+	}
+	out, _, err := prg.Eval(act)
+	if err != nil {
+		t.Fatalf("eval %q: %v", expr, err)
+	}
+	return out.Value()
+}
+
+// policyExprs pulls the shipped variable + validation expressions from the config manifest.
+func policyExprs(t *testing.T) (vars map[string]string, validations []string) {
+	t.Helper()
+	raw := repoFile(t, "config/admission/codeexec-ephemeral-vap.yaml")
+	p, _, err := ParseContract([]byte(raw))
+	if err != nil {
+		t.Fatalf("parse config manifest: %v", err)
+	}
+	vars = map[string]string{}
+	for _, v := range p.Spec.Variables {
+		vars[v.Name] = v.Expression
+	}
+	for _, val := range p.Spec.Validations {
+		validations = append(validations, val.Expression)
+	}
+	if len(validations) != 9 || len(vars) != 3 {
+		t.Fatalf("unexpected manifest shape: %d validations, %d variables", len(validations), len(vars))
+	}
+	return vars, validations
+}
+
+const managerSAName = "system:serviceaccount:phorvex-system:phorvex-phorvex-manager"
+const approvedImg = "busybox@sha256:b7f3d86d6e84fc17718c48bcde1450807faa2d56704205c697b4bd5df7b9e29f"
+
+func hardenedSC() map[string]any {
+	return map[string]any{
+		"privileged": false, "allowPrivilegeEscalation": false, "runAsNonRoot": true,
+		"runAsUser": int64(65534), "runAsGroup": int64(65534), "readOnlyRootFilesystem": true,
+		"capabilities":   map[string]any{"drop": []any{"ALL"}},
+		"seccompProfile": map[string]any{"type": "RuntimeDefault"},
+	}
+}
+
+func debuggerContainer() map[string]any {
+	return map[string]any{"name": "phorvex-debugger", "image": approvedImg, "securityContext": hardenedSC()}
+}
+
+func customContainer() map[string]any {
+	c := map[string]any{"name": "phorvex-custom", "image": approvedImg, "securityContext": hardenedSC()}
+	c["command"] = []any{"sh", "-c"}
+	c["args"] = []any{"echo phorvex-custom-action; sleep 1"}
+	return c
+}
+
+// activation builds object/oldObject/request/variables for a request that ADDS `containers`
+// (oldObject has none — first injection), submitted by `user`.
+func activation(t *testing.T, env *cel.Env, vars map[string]string, user string, containers ...map[string]any) map[string]any {
+	t.Helper()
+	ecs := make([]any, len(containers))
+	for i, c := range containers {
+		ecs[i] = c
+	}
+	object := map[string]any{"spec": map[string]any{"ephemeralContainers": ecs}}
+	oldObject := map[string]any{"spec": map[string]any{}} // no ephemeralContainers => all are new
+	base := map[string]any{"object": object, "oldObject": oldObject}
+	managerSA := celEval(t, env, vars["managerSA"], base)
+	approvedImage := celEval(t, env, vars["approvedImage"], base)
+	newContainers := celEval(t, env, vars["newContainers"], base)
+	return map[string]any{
+		"object":    object,
+		"oldObject": oldObject,
+		"request":   map[string]any{"userInfo": map[string]any{"username": user}},
+		"variables": map[string]any{"managerSA": managerSA, "approvedImage": approvedImage, "newContainers": newContainers},
+	}
+}
+
+func allValidationsTrue(t *testing.T, env *cel.Env, validations []string, act map[string]any) (allTrue bool, firstFalse int) {
+	t.Helper()
+	firstFalse = -1
+	allTrue = true
+	for i, expr := range validations {
+		if celEval(t, env, expr, act).(bool) != true {
+			allTrue = false
+			if firstFalse < 0 {
+				firstFalse = i
+			}
+		}
+	}
+	return
+}
+
+func TestCELAllowsCompliantRequests(t *testing.T) {
+	env := celEnv(t)
+	vars, validations := policyExprs(t)
+	for _, tc := range []struct {
+		name string
+		c    map[string]any
+	}{
+		{"debugger", debuggerContainer()},
+		{"custom-inject", customContainer()},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			act := activation(t, env, vars, managerSAName, tc.c)
+			if ok, ff := allValidationsTrue(t, env, validations, act); !ok {
+				t.Fatalf("compliant %s must be ALLOWED; validation[%d] denied", tc.name, ff)
+			}
+		})
+	}
+	// A request that ADDS NOTHING (no new containers) passes (migration / non-injection).
+	act := activation(t, env, vars, "someone:else")
+	if ok, _ := allValidationsTrue(t, env, validations, act); !ok {
+		t.Fatal("a request adding no new ephemeral container must be allowed")
+	}
+}
+
+func TestCELDeniesEachViolationIsolated(t *testing.T) {
+	env := celEnv(t)
+	vars, validations := policyExprs(t)
+	// validations index -> the rule expected to deny (in shipped order):
+	// 0 identity, 1 name, 2 image, 3 securityContext core, 4 capabilities, 5 seccomp,
+	// 6 securityContext-extra, 7 forbidden fields, 8 command/args.
+	cases := []struct {
+		name    string
+		user    string
+		mutate  func(map[string]any)
+		wantIdx int
+	}{
+		{"wrong-identity", "attacker:evil", func(map[string]any) {}, 0},
+		{"wrong-name", managerSAName, func(c map[string]any) { c["name"] = "evil" }, 1},
+		{"wrong-image", managerSAName, func(c map[string]any) { c["image"] = "busybox:1.36" }, 2},
+		{"privileged", managerSAName, func(c map[string]any) { c["securityContext"].(map[string]any)["privileged"] = true }, 3},
+		{"root-user", managerSAName, func(c map[string]any) { c["securityContext"].(map[string]any)["runAsUser"] = int64(0) }, 3},
+		{"caps-not-dropped", managerSAName, func(c map[string]any) {
+			c["securityContext"].(map[string]any)["capabilities"] = map[string]any{"drop": []any{}}
+		}, 4},
+		{"seccomp-unconfined", managerSAName, func(c map[string]any) {
+			c["securityContext"].(map[string]any)["seccompProfile"] = map[string]any{"type": "Unconfined"}
+		}, 5},
+		{"apparmor-extra", managerSAName, func(c map[string]any) {
+			c["securityContext"].(map[string]any)["appArmorProfile"] = map[string]any{"type": "Unconfined"}
+		}, 6},
+		{"procmount-extra", managerSAName, func(c map[string]any) { c["securityContext"].(map[string]any)["procMount"] = "Unmasked" }, 6},
+		{"tty-set", managerSAName, func(c map[string]any) { c["tty"] = true }, 7},
+		{"env-set", managerSAName, func(c map[string]any) { c["env"] = []any{map[string]any{"name": "X", "value": "y"}} }, 7},
+		{"debugger-with-command", managerSAName, func(c map[string]any) { c["command"] = []any{"sh"} }, 8},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			c := debuggerContainer()
+			tc.mutate(c)
+			act := activation(t, env, vars, tc.user, c)
+			if celEval(t, env, validations[tc.wantIdx], act).(bool) {
+				t.Fatalf("%s: validation[%d] must DENY but returned true", tc.name, tc.wantIdx)
+			}
+			// And the overall request is not allowed.
+			if ok, _ := allValidationsTrue(t, env, validations, act); ok {
+				t.Fatalf("%s: request must be denied overall", tc.name)
+			}
+		})
+	}
+	// custom-inject with wrong args is denied by the command rule (index 8).
+	t.Run("custom-wrong-args", func(t *testing.T) {
+		c := customContainer()
+		c["args"] = []any{"echo pwned"}
+		act := activation(t, env, vars, managerSAName, c)
+		if celEval(t, env, validations[8], act).(bool) {
+			t.Fatal("custom-inject wrong args must be denied by the command rule")
+		}
+	})
+}
+
+// TestCELNewContainersIgnoresPreexisting proves the oldObject boundary: a container already in
+// oldObject is NOT re-validated (migration), while a genuinely new one still is.
+func TestCELNewContainersIgnoresPreexisting(t *testing.T) {
+	env := celEnv(t)
+	vars, _ := policyExprs(t)
+	preexisting := map[string]any{"name": "legacy", "image": "whatever:latest"}
+	added := debuggerContainer()
+	// oldObject already has "legacy"; object has "legacy" + a new debugger. Only the debugger is new.
+	object := map[string]any{"spec": map[string]any{"ephemeralContainers": []any{preexisting, added}}}
+	oldObject := map[string]any{"spec": map[string]any{"ephemeralContainers": []any{preexisting}}}
+	nc := celEval(t, env, vars["newContainers"], map[string]any{"object": object, "oldObject": oldObject})
+	// Evaluate size() over the computed list via CEL (its runtime list type is not []any).
+	sz := celEval(t, env, "size(variables.newContainers)", map[string]any{"variables": map[string]any{"newContainers": nc}})
+	if sz.(int64) != 1 {
+		t.Fatalf("only the newly-added container must be in newContainers, got size %v", sz)
+	}
+	// And a request whose only container is pre-existing yields an EMPTY new set.
+	obj2 := map[string]any{"spec": map[string]any{"ephemeralContainers": []any{preexisting}}}
+	nc2 := celEval(t, env, vars["newContainers"], map[string]any{"object": obj2, "oldObject": oldObject})
+	sz2 := celEval(t, env, "size(variables.newContainers)", map[string]any{"variables": map[string]any{"newContainers": nc2}})
+	if sz2.(int64) != 0 {
+		t.Fatalf("a pre-existing-only request must yield no new containers, got size %v", sz2)
+	}
+	_ = context.Background()
+}
diff --git a/phorvex/internal/codeexec/chart_contract_test.go b/phorvex/internal/codeexec/chart_contract_test.go
new file mode 100644
index 0000000..98d97c6
--- /dev/null
+++ b/phorvex/internal/codeexec/chart_contract_test.go
@@ -0,0 +1,143 @@
+/*
+ * Phorvex — the deterministic intelligence layer for R6/Phoenix AMTD. (M-6)
+ *
+ * Static chart/manifest contract for the code-exec admission package (an L0-L2 "chart render"
+ * check without a helm binary, matching internal/actuator/rbac_contract_test.go's style):
+ *   - the VAP is Deny + failurePolicy:Fail, version-pinned, scoped to the managed label, and
+ *     targets pods/ephemeralcontainers UPDATE;
+ *   - the emitted profile the VAP allows (digest / securityContext / Option A / custom-inject)
+ *     is present verbatim;
+ *   - the runtime read grant is resourceName-scoped GET only (no list/watch/write), gated by
+ *     the off-by-default flag, and no ephemeral-container WRITE grant is bound by the chart;
+ *   - the standalone config manifest and the chart template agree on the load-bearing fields.
+ */
+
+package codeexec
+
+import (
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+)
+
+func repoFile(t *testing.T, rel string) string {
+	t.Helper()
+	_, thisFile, _, ok := runtime.Caller(0)
+	if !ok {
+		t.Fatal("locate test source")
+	}
+	// internal/codeexec -> repo root (phorvex/)
+	root := filepath.Join(filepath.Dir(thisFile), "..", "..")
+	raw, err := os.ReadFile(filepath.Join(root, rel))
+	if err != nil {
+		t.Fatalf("read %s: %v", rel, err)
+	}
+	return string(raw)
+}
+
+func mustContain(t *testing.T, name, hay string, needles ...string) {
+	t.Helper()
+	for _, n := range needles {
+		if !strings.Contains(hay, n) {
+			t.Errorf("%s: missing required content %q", name, n)
+		}
+	}
+}
+
+// vapContent asserts the load-bearing VAP fields the verifier and the enforcement both rely on.
+func vapContent(t *testing.T, name, text string) {
+	t.Helper()
+	mustContain(t, name, text,
+		"failurePolicy: Fail",
+		`validationActions: ["Deny"]`,
+		`phorvex.ai/policy-version: "m6-1"`,
+		`phorvex.ai/codeexec-managed: "true"`,
+		"pods/ephemeralcontainers",
+		`operations: ["UPDATE"]`,
+		"policyName: phorvex-codeexec-ephemeral",
+		// the paired profile the VAP allows:
+		"busybox@sha256:b7f3d86d6e84fc17718c48bcde1450807faa2d56704205c697b4bd5df7b9e29f",
+		"ec.securityContext.runAsUser == 65534",
+		"ec.securityContext.capabilities.drop == ['ALL']",
+		"'RuntimeDefault'",
+		"['sh', '-c']",
+		"['echo phorvex-custom-action; sleep 1']",
+		// Option A: debugger command AND args required empty.
+		"ec.name == 'phorvex-debugger'",
+	)
+}
+
+func TestVAPConfigManifestContract(t *testing.T) {
+	vapContent(t, "config/admission", repoFile(t, "config/admission/codeexec-ephemeral-vap.yaml"))
+}
+
+// TestConfigManifestEqualsTrustedContract proves the deployed config/admission manifest's
+// enforcement spec is byte-identical (normalized) to the embedded trusted contract the verifier
+// checks against — so the policy the installer applies and the policy the runtime demands cannot
+// drift. (The rendered Helm chart's agreement is proven in chart_render_test.go.)
+func TestConfigManifestEqualsTrustedContract(t *testing.T) {
+	p, b, err := ParseContract([]byte(repoFile(t, "config/admission/codeexec-ephemeral-vap.yaml")))
+	if err != nil {
+		t.Fatalf("parse config manifest: %v", err)
+	}
+	if why := validatePolicyContent(p); why != "" {
+		t.Fatalf("config VAP spec != trusted contract: %s", why)
+	}
+	if why := validateBindingContent(b); why != "" {
+		t.Fatalf("config Binding spec != trusted contract: %s", why)
+	}
+}
+
+func TestVAPChartTemplateContract(t *testing.T) {
+	text := repoFile(t, "charts/phorvex/templates/codeexec-admission.yaml")
+	vapContent(t, "chart", text)
+	// Gated off by default: the whole template is wrapped in the enable flag.
+	mustContain(t, "chart", text, "{{- if .Values.phorvex.codeExecAdmission.enabled }}")
+}
+
+func TestCodeExecAdmissionDefaultsOff(t *testing.T) {
+	values := repoFile(t, "charts/phorvex/values.yaml")
+	// The block must exist and default to disabled.
+	if !strings.Contains(values, "codeExecAdmission:") {
+		t.Fatal("values.yaml: missing codeExecAdmission block")
+	}
+	idx := strings.Index(values, "codeExecAdmission:")
+	after := values[idx:]
+	nextEnabled := strings.Index(after, "enabled:")
+	if nextEnabled < 0 || !strings.Contains(after[nextEnabled:nextEnabled+20], "false") {
+		t.Fatal("values.yaml: codeExecAdmission.enabled must default to false")
+	}
+}
+
+func TestRuntimeReadGrantIsResourceNameScopedGetOnly(t *testing.T) {
+	rbac := repoFile(t, "charts/phorvex/templates/rbac.yaml")
+	mustContain(t, "rbac", rbac,
+		"{{- if .Values.phorvex.codeExecAdmission.enabled }}",
+		`resources: ["validatingadmissionpolicies", "validatingadmissionpolicybindings"]`,
+		`resourceNames: ["phorvex-codeexec-ephemeral"]`,
+		`verbs: ["get"]`,
+	)
+	// The read grant must NOT smuggle list/watch or any write on those objects. Inspect just
+	// the read-grant stanza (from its resourceNames line to the end of that rule's verbs).
+	i := strings.Index(rbac, `resourceNames: ["phorvex-codeexec-ephemeral"]`)
+	if i < 0 {
+		t.Fatal("read-grant stanza not found")
+	}
+	stanza := rbac[i : i+120]
+	for _, forbidden := range []string{"list", "watch", "create", "update", "patch", "delete"} {
+		if strings.Contains(stanza, forbidden) {
+			t.Errorf("read grant must be get-only; found %q in %q", forbidden, stanza)
+		}
+	}
+}
+
+// The chart must NOT bind any pods/ephemeralcontainers WRITE (the execution grant) — that is a
+// separate, human-gated step. The manager ClusterRole and the routine actuator Role both omit it.
+func TestChartBindsNoEphemeralContainersWrite(t *testing.T) {
+	rbac := repoFile(t, "charts/phorvex/templates/rbac.yaml")
+	if strings.Contains(rbac, "ephemeralcontainers") {
+		t.Fatal("chart rbac.yaml must not grant pods/ephemeralcontainers (execution grant stays unbound)")
+	}
+}
diff --git a/phorvex/internal/codeexec/chart_render_test.go b/phorvex/internal/codeexec/chart_render_test.go
new file mode 100644
index 0000000..1dc9aa8
--- /dev/null
+++ b/phorvex/internal/codeexec/chart_render_test.go
@@ -0,0 +1,127 @@
+/*
+ * Phorvex — the deterministic intelligence layer for R6/Phoenix AMTD. (M-6)
+ *
+ * Actual Helm rendering of the chart (not string search over templates): with
+ * codeExecAdmission.enabled=true the VAP + Binding + minimal resourceName-scoped read grant
+ * render (Deny / failurePolicy:Fail / managed scope), the rendered VAP spec EQUALS the trusted
+ * contract, and NO ephemeral-container write (execution) grant appears; with enabled=false none
+ * of them render. Requires a helm binary: set HELM_BIN or have helm on PATH. If absent, the test
+ * SKIPS with a precise message rather than silently downgrading the requirement (the published
+ * evidence carries the executed render from a real helm binary).
+ */
+
+package codeexec
+
+import (
+	"bytes"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+
+	admissionv1 "k8s.io/api/admissionregistration/v1"
+	"sigs.k8s.io/yaml"
+)
+
+func helmBin(t *testing.T) string {
+	t.Helper()
+	if b := os.Getenv("HELM_BIN"); b != "" {
+		return b
+	}
+	if b, err := exec.LookPath("helm"); err == nil {
+		return b
+	}
+	t.Skip("helm binary not found (set HELM_BIN or add helm to PATH); executed render is in evidence/l0-l2/helm-render-*.yaml")
+	return ""
+}
+
+func chartDir(t *testing.T) string {
+	t.Helper()
+	_, thisFile, _, ok := runtime.Caller(0)
+	if !ok {
+		t.Fatal("locate test source")
+	}
+	return filepath.Join(filepath.Dir(thisFile), "..", "..", "charts", "phorvex")
+}
+
+func render(t *testing.T, enabled string) string {
+	t.Helper()
+	cmd := exec.Command(helmBin(t), "template", "codeexec-test", chartDir(t),
+		"--set", "phorvex.codeExecAdmission.enabled="+enabled)
+	var out, errb bytes.Buffer
+	cmd.Stdout, cmd.Stderr = &out, &errb
+	if err := cmd.Run(); err != nil {
+		t.Fatalf("helm template (enabled=%s): %v\n%s", enabled, err, errb.String())
+	}
+	return out.String()
+}
+
+// docsByKind splits a multi-doc render and returns the raw docs whose `kind:` matches.
+func docsByKind(rendered, kind string) []string {
+	var got []string
+	for _, d := range strings.Split(rendered, "\n---") {
+		if strings.Contains(d, "\nkind: "+kind+"\n") || strings.HasPrefix(strings.TrimSpace(d), "kind: "+kind) {
+			got = append(got, d)
+		}
+	}
+	return got
+}
+
+func TestHelmRenderEnabledProducesEnforcementAndReadGrant(t *testing.T) {
+	rendered := render(t, "true")
+
+	vaps := docsByKind(rendered, "ValidatingAdmissionPolicy")
+	if len(vaps) != 1 {
+		t.Fatalf("enabled render must contain exactly one ValidatingAdmissionPolicy, got %d", len(vaps))
+	}
+	bindings := docsByKind(rendered, "ValidatingAdmissionPolicyBinding")
+	if len(bindings) != 1 {
+		t.Fatalf("enabled render must contain exactly one Binding, got %d", len(bindings))
+	}
+
+	// The rendered VAP is a valid typed object whose spec EQUALS the trusted contract.
+	var vap admissionv1.ValidatingAdmissionPolicy
+	if err := yaml.Unmarshal([]byte(vaps[0]), &vap); err != nil {
+		t.Fatalf("rendered VAP does not parse: %v", err)
+	}
+	if why := validatePolicyContent(&vap); why != "" {
+		t.Fatalf("rendered VAP is not the trusted contract: %s", why)
+	}
+	var binding admissionv1.ValidatingAdmissionPolicyBinding
+	if err := yaml.Unmarshal([]byte(bindings[0]), &binding); err != nil {
+		t.Fatalf("rendered Binding does not parse: %v", err)
+	}
+	if why := validateBindingContent(&binding); why != "" {
+		t.Fatalf("rendered Binding is not the trusted contract: %s", why)
+	}
+
+	// The minimal resourceName-scoped read grant renders; NO ephemeral-container write grant does.
+	if !strings.Contains(rendered, `resourceNames: ["phorvex-codeexec-ephemeral"]`) {
+		t.Fatal("enabled render must include the resourceName-scoped read grant")
+	}
+	// No RBAC (Cluster)Role may grant pods/ephemeralcontainers (the execution grant stays unbound).
+	// Checked on RBAC docs only — the VAP legitimately NAMES pods/ephemeralcontainers as the
+	// subresource it validates, which is not a grant.
+	for _, kind := range []string{"ClusterRole", "Role"} {
+		for _, d := range docsByKind(rendered, kind) {
+			if strings.Contains(d, "ephemeralcontainers") {
+				t.Fatalf("enabled render must NOT bind pods/ephemeralcontainers in a %s (execution grant)", kind)
+			}
+		}
+	}
+}
+
+func TestHelmRenderDisabledProducesNothing(t *testing.T) {
+	rendered := render(t, "false")
+	if len(docsByKind(rendered, "ValidatingAdmissionPolicy")) != 0 {
+		t.Fatal("disabled render must not contain a ValidatingAdmissionPolicy")
+	}
+	if len(docsByKind(rendered, "ValidatingAdmissionPolicyBinding")) != 0 {
+		t.Fatal("disabled render must not contain a Binding")
+	}
+	if strings.Contains(rendered, "codeexec-managed") || strings.Contains(rendered, `resourceNames: ["phorvex-codeexec-ephemeral"]`) {
+		t.Fatal("disabled render must not contain the code-exec scope label or read grant")
+	}
+}
diff --git a/phorvex/internal/codeexec/expected_vap.yaml b/phorvex/internal/codeexec/expected_vap.yaml
new file mode 100644
index 0000000..5036478
--- /dev/null
+++ b/phorvex/internal/codeexec/expected_vap.yaml
@@ -0,0 +1,106 @@
+# M-6 TRUSTED CONTRACT — the canonical enforcement content the runtime verifier compares the
+# LIVE ValidatingAdmissionPolicy + Binding against, field-for-field (normalized), before it will
+# report code-exec admission available. This is the single source of truth; a test asserts that
+# config/admission/codeexec-ephemeral-vap.yaml and the rendered Helm chart both equal this spec,
+# so the deployed policy and the verifier's expectation can never drift. The annotation is NOT the
+# check — the entire normalized spec is.
+apiVersion: admissionregistration.k8s.io/v1
+kind: ValidatingAdmissionPolicy
+metadata:
+  name: phorvex-codeexec-ephemeral
+  annotations:
+    phorvex.ai/policy-version: "m6-1"
+spec:
+  failurePolicy: Fail
+  matchConstraints:
+    resourceRules:
+      - apiGroups: [""]
+        apiVersions: ["v1"]
+        operations: ["UPDATE"]
+        resources: ["pods/ephemeralcontainers"]
+  variables:
+    - name: managerSA
+      expression: "'system:serviceaccount:phorvex-system:phorvex-phorvex-manager'"
+    - name: approvedImage
+      expression: "'busybox@sha256:b7f3d86d6e84fc17718c48bcde1450807faa2d56704205c697b4bd5df7b9e29f'"
+    - name: newContainers
+      expression: >-
+        has(object.spec.ephemeralContainers)
+          ? object.spec.ephemeralContainers.filter(ec,
+              !(has(oldObject.spec.ephemeralContainers)
+                && oldObject.spec.ephemeralContainers.exists(o, o.name == ec.name)))
+          : []
+  validations:
+    - expression: "size(variables.newContainers) == 0 || request.userInfo.username == variables.managerSA"
+      reason: Forbidden
+      messageExpression: >-
+        "code-exec/identity: only the Phorvex manager service account may add an ephemeral container in
+        a managed namespace (got '" + request.userInfo.username + "')"
+    - expression: "variables.newContainers.all(ec, ec.name in ['phorvex-debugger', 'phorvex-custom'])"
+      reason: Forbidden
+      message: "code-exec/name: ephemeral container name must be exactly phorvex-debugger or phorvex-custom"
+    - expression: "variables.newContainers.all(ec, has(ec.image) && ec.image == variables.approvedImage)"
+      reason: Forbidden
+      message: "code-exec/image: ephemeral container image must be the pinned busybox digest"
+    - expression: >-
+        variables.newContainers.all(ec, has(ec.securityContext)
+          && ec.securityContext.privileged == false
+          && ec.securityContext.allowPrivilegeEscalation == false
+          && ec.securityContext.runAsNonRoot == true
+          && ec.securityContext.runAsUser == 65534
+          && ec.securityContext.runAsGroup == 65534
+          && ec.securityContext.readOnlyRootFilesystem == true)
+      reason: Forbidden
+      message: "code-exec/securityContext: require privileged=false, allowPrivilegeEscalation=false, runAsNonRoot=true, runAsUser=runAsGroup=65534, readOnlyRootFilesystem=true"
+    - expression: >-
+        variables.newContainers.all(ec, has(ec.securityContext) && has(ec.securityContext.capabilities)
+          && ec.securityContext.capabilities.drop == ['ALL']
+          && (!has(ec.securityContext.capabilities.add) || size(ec.securityContext.capabilities.add) == 0))
+      reason: Forbidden
+      message: "code-exec/capabilities: require capabilities.drop=[ALL] and no capabilities.add"
+    - expression: >-
+        variables.newContainers.all(ec, has(ec.securityContext) && has(ec.securityContext.seccompProfile)
+          && ec.securityContext.seccompProfile.type == 'RuntimeDefault')
+      reason: Forbidden
+      message: "code-exec/seccomp: require seccompProfile.type=RuntimeDefault"
+    - expression: >-
+        variables.newContainers.all(ec, !has(ec.securityContext)
+          || (!has(ec.securityContext.appArmorProfile)
+              && !has(ec.securityContext.seLinuxOptions)
+              && !has(ec.securityContext.windowsOptions)
+              && !has(ec.securityContext.procMount)))
+      reason: Forbidden
+      message: "code-exec/securityContext-extra: appArmorProfile/seLinuxOptions/windowsOptions/procMount are not permitted (securityContext must equal the approved allow-set)"
+    - expression: >-
+        variables.newContainers.all(ec,
+          (!has(ec.tty) || ec.tty == false)
+          && (!has(ec.stdin) || ec.stdin == false)
+          && !has(ec.targetContainerName)
+          && (!has(ec.env) || size(ec.env) == 0)
+          && (!has(ec.envFrom) || size(ec.envFrom) == 0)
+          && (!has(ec.volumeMounts) || size(ec.volumeMounts) == 0)
+          && (!has(ec.volumeDevices) || size(ec.volumeDevices) == 0))
+      reason: Forbidden
+      message: "code-exec/fields: tty/stdin/targetContainerName/env/envFrom/volumeMounts/volumeDevices are not permitted"
+    - expression: >-
+        variables.newContainers.all(ec,
+          ec.name == 'phorvex-debugger'
+            ? ((!has(ec.command) || size(ec.command) == 0) && (!has(ec.args) || size(ec.args) == 0))
+            : (ec.name == 'phorvex-custom'
+                ? (has(ec.command) && ec.command == ['sh', '-c']
+                   && has(ec.args) && ec.args == ['echo phorvex-custom-action; sleep 1'])
+                : true))
+      reason: Forbidden
+      message: "code-exec/command: phorvex-debugger must carry empty command+args; phorvex-custom must carry the exact approved command+args"
+---
+apiVersion: admissionregistration.k8s.io/v1
+kind: ValidatingAdmissionPolicyBinding
+metadata:
+  name: phorvex-codeexec-ephemeral
+spec:
+  policyName: phorvex-codeexec-ephemeral
+  validationActions: ["Deny"]
+  matchResources:
+    namespaceSelector:
+      matchLabels:
+        phorvex.ai/codeexec-managed: "true"
diff --git a/phorvex/internal/codeexec/reader_k8s.go b/phorvex/internal/codeexec/reader_k8s.go
new file mode 100644
index 0000000..9e73488
--- /dev/null
+++ b/phorvex/internal/codeexec/reader_k8s.go
@@ -0,0 +1,119 @@
+/*
+ * Phorvex — the deterministic intelligence layer for R6/Phoenix AMTD. (M-6)
+ */
+
+package codeexec
+
+import (
+	"context"
+
+	admissionregistrationv1 "k8s.io/api/admissionregistration/v1"
+	authorizationv1 "k8s.io/api/authorization/v1"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/client-go/kubernetes"
+)
+
+const (
+	admissionGroup  = "admissionregistration.k8s.io"
+	policyResource  = "validatingadmissionpolicies"
+	bindingResource = "validatingadmissionpolicybindings"
+)
+
+// k8sReader is the production PolicyReader: GET-by-resourceName over the typed
+// admissionregistration/v1 client, resourceName-scoped SSARs, and a by-name namespace GET.
+// It performs NO list/watch — exactly the minimal get-only grant the contract requires. It
+// returns the FULL typed objects (no projection), so content verification sees every field.
+type k8sReader struct {
+	cs kubernetes.Interface
+}
+
+// NewK8sReader builds the production reader over a cluster clientset.
+func NewK8sReader(cs kubernetes.Interface) PolicyReader { return &k8sReader{cs: cs} }
+
+func (r *k8sReader) GetPolicy(ctx context.Context) (*admissionregistrationv1.ValidatingAdmissionPolicy, error) {
+	p, err := r.cs.AdmissionregistrationV1().ValidatingAdmissionPolicies().Get(ctx, PolicyName, metav1.GetOptions{})
+	if apierrors.IsNotFound(err) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	return p, nil
+}
+
+func (r *k8sReader) GetBinding(ctx context.Context) (*admissionregistrationv1.ValidatingAdmissionPolicyBinding, error) {
+	b, err := r.cs.AdmissionregistrationV1().ValidatingAdmissionPolicyBindings().Get(ctx, PolicyName, metav1.GetOptions{})
+	if apierrors.IsNotFound(err) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	return b, nil
+}
+
+// GetNamespaceLabels reads the CURRENT labels of one namespace by name (uncached).
+func (r *k8sReader) GetNamespaceLabels(ctx context.Context, namespace string) (map[string]string, bool, error) {
+	ns, err := r.cs.CoreV1().Namespaces().Get(ctx, namespace, metav1.GetOptions{})
+	if apierrors.IsNotFound(err) {
+		return nil, false, nil
+	}
+	if err != nil {
+		return nil, false, err
+	}
+	return ns.Labels, true, nil
+}
+
+// CanRead confirms, via SelfSubjectAccessReview, that the operator may `get` BOTH named
+// admission objects by resourceName. Both must be allowed; an SSAR error is unknown=true.
+func (r *k8sReader) CanRead(ctx context.Context) (allowed, unknown bool, err error) {
+	for _, res := range []string{policyResource, bindingResource} {
+		ok, unk, e := r.ssarGet(ctx, res, PolicyName)
+		if unk {
+			return false, true, e
+		}
+		if !ok {
+			return false, false, nil
+		}
+	}
+	return true, false, nil
+}
+
+func (r *k8sReader) ssarGet(ctx context.Context, resource, name string) (allowed, unknown bool, err error) {
+	sar := &authorizationv1.SelfSubjectAccessReview{
+		Spec: authorizationv1.SelfSubjectAccessReviewSpec{
+			ResourceAttributes: &authorizationv1.ResourceAttributes{
+				Group:    admissionGroup,
+				Resource: resource,
+				Verb:     "get",
+				Name:     name,
+			},
+		},
+	}
+	res, err := r.cs.AuthorizationV1().SelfSubjectAccessReviews().Create(ctx, sar, metav1.CreateOptions{})
+	if err != nil {
+		return false, true, err
+	}
+	return res.Status.Allowed, false, nil
+}
+
+// unavailableReader is a PolicyReader whose every read fails — used at boot when a cluster
+// clientset cannot be built, so the verifier is non-nil but permanently UNAVAILABLE.
+type unavailableReader struct{ reason string }
+
+// NewUnavailableReader builds a reader that always fails verification with the given reason.
+func NewUnavailableReader(reason string) PolicyReader { return unavailableReader{reason: reason} }
+
+func (r unavailableReader) GetPolicy(context.Context) (*admissionregistrationv1.ValidatingAdmissionPolicy, error) {
+	return nil, verifyError(r.reason)
+}
+func (r unavailableReader) GetBinding(context.Context) (*admissionregistrationv1.ValidatingAdmissionPolicyBinding, error) {
+	return nil, verifyError(r.reason)
+}
+func (r unavailableReader) CanRead(context.Context) (bool, bool, error) {
+	return false, true, verifyError(r.reason)
+}
+func (r unavailableReader) GetNamespaceLabels(context.Context, string) (map[string]string, bool, error) {
+	return nil, false, verifyError(r.reason)
+}
diff --git a/phorvex/internal/codeexec/verifier.go b/phorvex/internal/codeexec/verifier.go
new file mode 100644
index 0000000..1825829
--- /dev/null
+++ b/phorvex/internal/codeexec/verifier.go
@@ -0,0 +1,580 @@
+/*
+ * Phorvex — the deterministic intelligence layer for R6/Phoenix AMTD. (M-6)
+ */
+
+// Package codeexec is the RUNTIME admission-capability verifier for the two in-pod
+// code-execution actions (debugger / custom-inject). It answers, fail-closed, one
+// question the T1-E capability gate and the actuate boundary both ask:
+//
+//	"Is the ephemeral-container admission policy (the ValidatingAdmissionPolicy +
+//	 Binding phorvex-codeexec-ephemeral) currently PRESENT, its ENTIRE enforcement content
+//	 EQUAL to the trusted contract, Deny + failurePolicy:Fail, and does it cover THIS
+//	 namespace RIGHT NOW?"
+//
+// RBAC-allowed is NOT admission-verified, and a matching name/annotation is NOT enforcement:
+// a policy whose CEL was gutted (validations replaced by `true`, `newContainers` emptied, a
+// match-condition that skips it, a wrong resource group, a binding that excludes the target)
+// must be REJECTED. So the verifier compares the complete NORMALIZED spec of the live objects,
+// field-for-field, against an embedded trusted contract (config/admission + the rendered chart
+// are tested to equal it), tolerating only an explicit, justified set of API-defaulted fields.
+// The API-server VAP remains the durable enforcement; this is the operator-side fail-closed gate.
+//
+// Verification discipline (the M-6 frozen contract §6):
+//   - UNCACHED reads via GET-by-resourceName of the two named objects + an SSAR that the
+//     minimal read grant is present, all under a single AGGREGATE deadline D.
+//   - An independent TTL expiry (a quiet process never refreshes it — no watch).
+//   - A process-local, atomically-published invalidationEpoch: ANY observed invalidation
+//     — including a timeout or a partial read failure — increments it, and a verification
+//     success republishes valid state ONLY if its captured startEpoch still equals the
+//     current epoch at completion. A fresh verification after a timeout recovers.
+//   - A final pre-submit check that re-verifies the policy AND reads the target namespace's
+//     scope LIVE (uncached, by identity) within the aggregate deadline — never a stale label.
+//
+// Off by default and fail-closed: UNAVAILABLE until the first successful verification.
+package codeexec
+
+import (
+	"context"
+	_ "embed"
+	"encoding/json"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	admissionregistrationv1 "k8s.io/api/admissionregistration/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"sigs.k8s.io/yaml"
+)
+
+// Object identity + version the verifier checks (the installer-owned singleton).
+const (
+	// PolicyName is the resourceName of both the ValidatingAdmissionPolicy and its Binding.
+	PolicyName = "phorvex-codeexec-ephemeral"
+	// PolicyVersion is the value of the phorvex.ai/policy-version annotation (a cheap signal,
+	// NOT the check — the full spec comparison is). A chart/policy change bumps it.
+	PolicyVersion = "m6-1"
+	// ManagedLabelKey/Val is the installer-set namespace label the Binding selects on.
+	ManagedLabelKey = "phorvex.ai/codeexec-managed"
+	ManagedLabelVal = "true"
+)
+
+const versionAnnotation = "phorvex.ai/policy-version"
+
+// The §2 exact timing targets (L4 asserts against these; changing them requires a
+// recorded contract amendment).
+const (
+	// DefaultDeadline (D) is the AGGREGATE deadline shared by all reads of one verification.
+	DefaultDeadline = 2000 * time.Millisecond
+	// DefaultTTL is the independent expiry of a successful verification.
+	DefaultTTL = 30 * time.Second
+	// DefaultPoll is the periodic re-verify cadence (a GET, not a watch).
+	DefaultPoll = 10 * time.Second
+)
+
+// ReasonUnverified is the capability-gate / dispatch exclusion reason when code-exec
+// admission is not currently verified for the target.
+const ReasonUnverified = "codeexec-admission-unverified"
+
+// PolicyReader is the injectable read surface: GET-by-resourceName of the two named objects
+// (typed, so NOTHING security-relevant is projected away), an SSAR that the minimal read grant
+// is present, and a LIVE namespace-label read for the pre-submit scope check. Every method MUST
+// honor the ctx deadline (the aggregate D is applied by the verifier).
+type PolicyReader interface {
+	// GetPolicy GETs the ValidatingAdmissionPolicy PolicyName. A not-found object returns
+	// (nil, nil) — only a read FAILURE returns a non-nil error.
+	GetPolicy(ctx context.Context) (*admissionregistrationv1.ValidatingAdmissionPolicy, error)
+	// GetBinding GETs the ValidatingAdmissionPolicyBinding PolicyName (same not-found rule).
+	GetBinding(ctx context.Context) (*admissionregistrationv1.ValidatingAdmissionPolicyBinding, error)
+	// CanRead is the SSAR confirming the operator may `get` both named objects — a positive
+	// check the minimal read grant is installed. unknown=true means the SSAR itself errored.
+	CanRead(ctx context.Context) (allowed, unknown bool, err error)
+	// GetNamespaceLabels reads the CURRENT labels of a namespace (uncached) for the pre-submit
+	// scope check. found=false means the namespace is absent (⇒ out of scope, fail-closed).
+	GetNamespaceLabels(ctx context.Context, namespace string) (labels map[string]string, found bool, err error)
+}
+
+// --- the embedded trusted contract ------------------------------------------------------
+
+//go:embed expected_vap.yaml
+var expectedContractYAML []byte
+
+var (
+	expectedPolicyNorm  []byte            // normalized spec JSON of the trusted VAP
+	expectedBindingNorm []byte            // normalized spec JSON of the trusted Binding
+	expectedSelector    map[string]string // the trusted Binding namespaceSelector.matchLabels
+)
+
+// ExpectedPolicy / ExpectedBinding return fresh typed copies of the trusted contract (for
+// tests that build fixtures from it). They are parsed once from the embedded YAML.
+var expectedPolicy = &admissionregistrationv1.ValidatingAdmissionPolicy{}
+var expectedBinding = &admissionregistrationv1.ValidatingAdmissionPolicyBinding{}
+
+func init() {
+	p, b, err := ParseContract(expectedContractYAML)
+	if err != nil {
+		panic("codeexec: embedded trusted contract is unparseable: " + err.Error())
+	}
+	expectedPolicy, expectedBinding = p, b
+	expectedPolicyNorm = normalizedPolicySpecJSON(p)
+	expectedBindingNorm = normalizedBindingSpecJSON(b)
+	if b.Spec.MatchResources != nil && b.Spec.MatchResources.NamespaceSelector != nil {
+		expectedSelector = b.Spec.MatchResources.NamespaceSelector.MatchLabels
+	}
+	if len(expectedSelector) == 0 {
+		panic("codeexec: embedded trusted contract has no namespaceSelector matchLabels")
+	}
+}
+
+// ParseContract splits a two-document (policy---binding) YAML into the typed objects.
+func ParseContract(raw []byte) (*admissionregistrationv1.ValidatingAdmissionPolicy, *admissionregistrationv1.ValidatingAdmissionPolicyBinding, error) {
+	docs := splitYAMLDocs(raw)
+	p := &admissionregistrationv1.ValidatingAdmissionPolicy{}
+	b := &admissionregistrationv1.ValidatingAdmissionPolicyBinding{}
+	if err := yaml.Unmarshal(docs.policy, p); err != nil {
+		return nil, nil, err
+	}
+	if err := yaml.Unmarshal(docs.binding, b); err != nil {
+		return nil, nil, err
+	}
+	return p, b, nil
+}
+
+// ExpectedContract returns fresh deep copies of the trusted policy + binding (for fixtures).
+func ExpectedContract() (*admissionregistrationv1.ValidatingAdmissionPolicy, *admissionregistrationv1.ValidatingAdmissionPolicyBinding) {
+	return expectedPolicy.DeepCopy(), expectedBinding.DeepCopy()
+}
+
+// --- the verifier -----------------------------------------------------------------------
+
+// verifiedState is the immutable published result of one successful verification.
+type verifiedState struct {
+	valid         bool
+	at            time.Time
+	epochAtVerify uint64
+	selector      map[string]string
+	detail        string
+}
+
+// Verifier is the process-local, atomically-invalidated admission-capability oracle.
+type Verifier struct {
+	reader   PolicyReader
+	deadline time.Duration
+	ttl      time.Duration
+	poll     time.Duration
+	now      func() time.Time
+
+	epoch atomic.Uint64
+
+	mu    sync.RWMutex
+	state verifiedState
+}
+
+// Config carries the (all-optional) knobs; zero values fall back to the §2 defaults.
+type Config struct {
+	Deadline time.Duration
+	TTL      time.Duration
+	Poll     time.Duration
+	Now      func() time.Time
+}
+
+// New builds a Verifier in the initial UNAVAILABLE state (fail-closed until first success).
+func New(reader PolicyReader, cfg Config) *Verifier {
+	v := &Verifier{
+		reader:   reader,
+		deadline: orDur(cfg.Deadline, DefaultDeadline),
+		ttl:      orDur(cfg.TTL, DefaultTTL),
+		poll:     orDur(cfg.Poll, DefaultPoll),
+		now:      cfg.Now,
+	}
+	if v.now == nil {
+		v.now = time.Now
+	}
+	v.state = verifiedState{valid: false, detail: "not yet verified"}
+	return v
+}
+
+func orDur(d, def time.Duration) time.Duration {
+	if d <= 0 {
+		return def
+	}
+	return d
+}
+
+// Invalidate records an observed invalidation: it increments the epoch (so any in-flight
+// success started before now can no longer publish) and marks the published state invalid.
+func (v *Verifier) Invalidate(reason string) {
+	v.epoch.Add(1)
+	v.mu.Lock()
+	v.state.valid = false
+	v.state.detail = reason
+	v.mu.Unlock()
+}
+
+// Verify performs one uncached verification under the aggregate deadline D.
+func (v *Verifier) Verify(ctx context.Context) error {
+	dctx, cancel := context.WithTimeout(ctx, v.deadline)
+	defer cancel()
+	return v.verifyUnder(dctx)
+}
+
+// verifyUnder runs one verification using ctx as the (already deadline-bounded) aggregate. On
+// success it republishes valid state IFF no invalidation intervened; on any failure it invalidates.
+func (v *Verifier) verifyUnder(ctx context.Context) error {
+	startEpoch := v.epoch.Load()
+
+	allowed, unknown, err := v.reader.CanRead(ctx)
+	if err != nil || unknown {
+		return v.fail("ssar-read-check failed (fail-closed)")
+	}
+	if !allowed {
+		return v.fail("minimal read grant absent: operator cannot get the named admission objects")
+	}
+	policy, err := v.reader.GetPolicy(ctx)
+	if err != nil {
+		return v.fail("policy read failed (fail-closed): " + err.Error())
+	}
+	binding, err := v.reader.GetBinding(ctx)
+	if err != nil {
+		return v.fail("binding read failed (fail-closed): " + err.Error())
+	}
+	if why := validatePolicyContent(policy); why != "" {
+		return v.fail("policy invalid: " + why)
+	}
+	if why := validateBindingContent(binding); why != "" {
+		return v.fail("binding invalid: " + why)
+	}
+
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	if v.epoch.Load() != startEpoch {
+		v.state.detail = "verification superseded by a concurrent invalidation; discarded"
+		return context.Canceled
+	}
+	v.state = verifiedState{
+		valid:         true,
+		at:            v.now(),
+		epochAtVerify: startEpoch,
+		selector:      copyLabels(expectedSelector), // == the verified live selector
+		detail:        "verified",
+	}
+	return nil
+}
+
+func (v *Verifier) fail(reason string) error {
+	v.Invalidate(reason)
+	return verifyError(reason)
+}
+
+type verifyError string
+
+func (e verifyError) Error() string { return string(e) }
+
+// globalReady reports whether a valid verification is currently unexpired AND epoch-matched.
+func (v *Verifier) globalReady() (bool, string) {
+	v.mu.RLock()
+	st := v.state
+	v.mu.RUnlock()
+	if !st.valid {
+		if st.detail == "" {
+			return false, "not verified"
+		}
+		return false, st.detail
+	}
+	if v.now().Sub(st.at) >= v.ttl {
+		return false, "verification expired (TTL)"
+	}
+	if st.epochAtVerify != v.epoch.Load() {
+		return false, "verification invalidated"
+	}
+	return true, "verified"
+}
+
+// Available is the O(1) cached gate check for the pre-scoring capability gate: is admission
+// verified AND does the verified Binding scope cover the target namespace? nsLabels are the
+// tick snapshot's labels (best-effort, cheap; the authoritative live scope check is FinalCheck).
+func (v *Verifier) Available(nsLabels map[string]string) (bool, string) {
+	ready, why := v.globalReady()
+	if !ready {
+		return false, ReasonUnverified + ": " + why
+	}
+	v.mu.RLock()
+	sel := v.state.selector
+	v.mu.RUnlock()
+	if !scopeMatch(sel, nsLabels) {
+		return false, ReasonUnverified + ": target namespace not in the verified managed scope (C3)"
+	}
+	return true, ""
+}
+
+// FinalCheck is the pre-submit re-confirmation immediately before an irreversible inject. It
+// carries the target namespace IDENTITY (not stale labels): it re-verifies the policy AND reads
+// the namespace's CURRENT labels LIVE (uncached), all within one aggregate deadline D, then
+// requires unexpired + epoch-matched verification + the live namespace in verified scope. A
+// managed label removed since the tick is therefore caught here. ok=false carries ReasonUnverified.
+func (v *Verifier) FinalCheck(ctx context.Context, namespace string) (bool, string) {
+	dctx, cancel := context.WithTimeout(ctx, v.deadline)
+	defer cancel()
+	_ = v.verifyUnder(dctx) // fresh verify sharing the aggregate D; failure invalidates
+
+	// Capture the verification TOKEN before the scope I/O.
+	ready, why := v.globalReady()
+	if !ready {
+		return false, ReasonUnverified + ": " + why
+	}
+	v.mu.RLock()
+	tokenEpoch := v.state.epochAtVerify
+	tokenAt := v.state.at
+	sel := v.state.selector
+	v.mu.RUnlock()
+
+	labels, found, err := v.reader.GetNamespaceLabels(dctx, namespace)
+	if err != nil {
+		// A partial read failure (incl. a deadline) is an observed invalidation: bump the epoch
+		// so this and any concurrent gating decision fail closed, not just this call.
+		v.Invalidate("live namespace scope read failed for " + namespace + ": " + err.Error())
+		return false, ReasonUnverified + ": live namespace scope read failed for " + namespace + " (fail-closed): " + err.Error()
+	}
+	if !found {
+		return false, ReasonUnverified + ": target namespace " + namespace + " not found (out of scope)"
+	}
+
+	// RE-CHECK the token AFTER the I/O: an invalidation observed DURING the namespace read (a
+	// concurrent poll seeing the policy weakened), a TTL expiry, or a blown aggregate deadline
+	// all void this submit. This is distinct from the accepted post-check last-moment race.
+	if v.epoch.Load() != tokenEpoch {
+		return false, ReasonUnverified + ": verification invalidated during the final scope read"
+	}
+	if v.now().Sub(tokenAt) >= v.ttl {
+		return false, ReasonUnverified + ": verification expired during the final scope read (TTL)"
+	}
+	if dctx.Err() != nil {
+		return false, ReasonUnverified + ": final check exceeded the aggregate deadline: " + dctx.Err().Error()
+	}
+	if !scopeMatch(sel, labels) {
+		return false, ReasonUnverified + ": target namespace " + namespace + " not in the verified managed scope (C3)"
+	}
+	return true, ""
+}
+
+// Run drives the periodic re-verify loop (a GET every poll interval; no watch). Returns on ctx.
+func (v *Verifier) Run(ctx context.Context) {
+	_ = v.Verify(ctx)
+	t := time.NewTicker(v.poll)
+	defer t.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-t.C:
+			_ = v.Verify(ctx)
+		}
+	}
+}
+
+// Status returns the current availability + detail for boot logs / degraded-status reporting.
+func (v *Verifier) Status() (available bool, detail string) {
+	return v.globalReady()
+}
+
+// --- content validation (full normalized spec vs the trusted contract) ------------------
+
+// validatePolicyContent rejects a live VAP whose annotation, failurePolicy, or ANY normalized
+// spec field differs from the trusted contract. The whole spec is compared, so an unexpected
+// enforcement change (gutted CEL, emptied variable, added match-condition, wrong resource) is
+// caught rather than silently projected away.
+func validatePolicyContent(p *admissionregistrationv1.ValidatingAdmissionPolicy) string {
+	if p == nil {
+		return "ValidatingAdmissionPolicy " + PolicyName + " not found"
+	}
+	if p.Annotations[versionAnnotation] != PolicyVersion {
+		return "phorvex.ai/policy-version annotation is not " + PolicyVersion
+	}
+	if p.Spec.FailurePolicy == nil || *p.Spec.FailurePolicy != admissionregistrationv1.Fail {
+		return "failurePolicy is not Fail"
+	}
+	if !bytesEqual(normalizedPolicySpecJSON(p), expectedPolicyNorm) {
+		return "policy enforcement content does not match the trusted contract (validations/variables/matchConstraints/matchConditions)"
+	}
+	return ""
+}
+
+// validateBindingContent rejects a live Binding whose normalized spec differs from the trusted
+// contract — a wrong policyName, a missing Deny, added exclusions, an object selector, or a
+// namespace selector (matchLabels OR matchExpressions) that narrows/skips the target.
+func validateBindingContent(b *admissionregistrationv1.ValidatingAdmissionPolicyBinding) string {
+	if b == nil {
+		return "ValidatingAdmissionPolicyBinding " + PolicyName + " not found"
+	}
+	if b.Spec.PolicyName != PolicyName {
+		return "binding.policyName does not reference " + PolicyName
+	}
+	if !hasDeny(b.Spec.ValidationActions) {
+		return "validationActions does not contain Deny"
+	}
+	if !bytesEqual(normalizedBindingSpecJSON(b), expectedBindingNorm) {
+		return "binding enforcement content does not match the trusted contract (validationActions/matchResources/selectors/exclusions)"
+	}
+	return ""
+}
+
+// normalizedPolicySpecJSON deep-copies the spec, FILLS the API-server defaults to their canonical
+// values (rather than clearing them), and marshals deterministically. Filling — not clearing — is
+// what lets the same canonical form come out of BOTH the raw committed manifest (defaults absent)
+// AND the actual server-returned object (defaults populated: matchPolicy=Equivalent, empty
+// namespace/object selectors, scope="*"), while a NON-default incompatible value (e.g. scope
+// Cluster, or a real narrowing selector) is preserved and so mismatches the trusted contract.
+// Every other field participates in the comparison, so nothing security-relevant is dropped.
+func normalizedPolicySpecJSON(p *admissionregistrationv1.ValidatingAdmissionPolicy) []byte {
+	spec := p.Spec.DeepCopy()
+	if spec.MatchConstraints != nil {
+		spec.MatchConstraints.MatchPolicy = fillMatchPolicy(spec.MatchConstraints.MatchPolicy)
+		spec.MatchConstraints.NamespaceSelector = fillSelector(spec.MatchConstraints.NamespaceSelector)
+		spec.MatchConstraints.ObjectSelector = fillSelector(spec.MatchConstraints.ObjectSelector)
+		for i := range spec.MatchConstraints.ResourceRules {
+			if spec.MatchConstraints.ResourceRules[i].Scope == nil {
+				all := admissionregistrationv1.AllScopes // "*" — the server default; a real Cluster/Namespaced stays as-is
+				spec.MatchConstraints.ResourceRules[i].Scope = &all
+			}
+		}
+	}
+	out, _ := json.Marshal(spec)
+	return out
+}
+
+func normalizedBindingSpecJSON(b *admissionregistrationv1.ValidatingAdmissionPolicyBinding) []byte {
+	spec := b.Spec.DeepCopy()
+	if spec.MatchResources != nil {
+		spec.MatchResources.MatchPolicy = fillMatchPolicy(spec.MatchResources.MatchPolicy)
+		spec.MatchResources.NamespaceSelector = fillSelector(spec.MatchResources.NamespaceSelector)
+		spec.MatchResources.ObjectSelector = fillSelector(spec.MatchResources.ObjectSelector)
+	}
+	out, _ := json.Marshal(spec)
+	return out
+}
+
+// fillMatchPolicy returns Equivalent (the server default) when unset, else the explicit value.
+func fillMatchPolicy(mp *admissionregistrationv1.MatchPolicyType) *admissionregistrationv1.MatchPolicyType {
+	if mp == nil {
+		eq := admissionregistrationv1.Equivalent
+		return &eq
+	}
+	return mp
+}
+
+// fillSelector returns an empty (match-everything) selector when unset — the server default —
+// so an absent selector and a server-populated empty selector canonicalize identically. A
+// non-empty selector (matchLabels or matchExpressions) is left intact, so a narrowing selector
+// still differs from the trusted contract.
+func fillSelector(s *metav1.LabelSelector) *metav1.LabelSelector {
+	if s == nil {
+		return &metav1.LabelSelector{}
+	}
+	return s
+}
+
+func hasDeny(actions []admissionregistrationv1.ValidationAction) bool {
+	for _, a := range actions {
+		if a == admissionregistrationv1.Deny {
+			return true
+		}
+	}
+	return false
+}
+
+// scopeMatch reports whether nsLabels satisfy the verified Binding selector (every selector
+// label present with the same value). An empty selector never matches (fail-closed).
+func scopeMatch(selector, nsLabels map[string]string) bool {
+	if len(selector) == 0 {
+		return false
+	}
+	for k, val := range selector {
+		if nsLabels[k] != val {
+			return false
+		}
+	}
+	return true
+}
+
+func copyLabels(m map[string]string) map[string]string {
+	if m == nil {
+		return nil
+	}
+	out := make(map[string]string, len(m))
+	for k, v := range m {
+		out[k] = v
+	}
+	return out
+}
+
+func bytesEqual(a, b []byte) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+type yamlDocs struct{ policy, binding []byte }
+
+// splitYAMLDocs splits a "policy\n---\nbinding" document pair. It splits on a line that is
+// exactly "---" so the "---" inside folded scalars/comments is never a separator.
+func splitYAMLDocs(raw []byte) yamlDocs {
+	lines := splitLines(raw)
+	var cur []byte
+	var docs [][]byte
+	for _, ln := range lines {
+		if string(ln) == "---" {
+			docs = append(docs, cur)
+			cur = nil
+			continue
+		}
+		cur = append(cur, ln...)
+		cur = append(cur, '\n')
+	}
+	docs = append(docs, cur)
+	// Keep the two non-empty documents (skip a possible empty leading/trailing doc).
+	var nonEmpty [][]byte
+	for _, d := range docs {
+		if len(trimSpace(d)) > 0 {
+			nonEmpty = append(nonEmpty, d)
+		}
+	}
+	out := yamlDocs{}
+	if len(nonEmpty) > 0 {
+		out.policy = nonEmpty[0]
+	}
+	if len(nonEmpty) > 1 {
+		out.binding = nonEmpty[1]
+	}
+	return out
+}
+
+func splitLines(raw []byte) [][]byte {
+	var lines [][]byte
+	start := 0
+	for i := 0; i < len(raw); i++ {
+		if raw[i] == '\n' {
+			lines = append(lines, raw[start:i])
+			start = i + 1
+		}
+	}
+	if start < len(raw) {
+		lines = append(lines, raw[start:])
+	}
+	return lines
+}
+
+func trimSpace(b []byte) []byte {
+	i, j := 0, len(b)
+	for i < j && (b[i] == ' ' || b[i] == '\t' || b[i] == '\n' || b[i] == '\r') {
+		i++
+	}
+	for j > i && (b[j-1] == ' ' || b[j-1] == '\t' || b[j-1] == '\n' || b[j-1] == '\r') {
+		j--
+	}
+	return b[i:j]
+}
