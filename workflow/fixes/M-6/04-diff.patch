+  # NO injection permission (the ephemeralcontainers write Role stays unbound — a separate,
+  # human-gated step) and labels no namespace: an admin opts a namespace in with
+  # `kubectl label ns <ns> phorvex.ai/codeexec-managed=true`. Deny-only, so it is safe to enable
+  # ahead of any execution grant, and required to be verified BEFORE one.
+  codeExecAdmission:
+    enabled: false
