diff --git a/phorvex/internal/exposure/intent.go b/phorvex/internal/exposure/intent.go
new file mode 100644
index 0000000..b806446
--- /dev/null
+++ b/phorvex/internal/exposure/intent.go
@@ -0,0 +1,91 @@
+/*
+ * Phorvex — synchronous per-action actuation intent (M-23).
+ */
+
+package exposure
+
+import (
+	"sync"
+	"time"
+)
+
+// Intents records, per (slot, variable), the wall-clock time an action was EMITTED —
+// stamped synchronously at the emit boundary, before the next observed snapshot moves
+// the exposure Clock. It closes the cross-tick burst hole M-23 targets: between a
+// successful actuation and the tick that first observes the resulting `*-epoch` marker,
+// the observed clock still reads "long ago", so a second emit of the same (pod, action)
+// would pass the anti-over-rotation guard. The guard takes min(observed-since,
+// intent-since) — the most recent of the two — so intent throttles that gap.
+//
+// Keyed by the same slotKey as Clock, and GC'd the same way (RetainTenant each tick).
+type Intents struct {
+	mu sync.Mutex
+	at map[string]map[string]time.Time // slotKey -> variable -> marked-at
+}
+
+// NewIntents returns an empty intent store.
+func NewIntents() *Intents { return &Intents{at: make(map[string]map[string]time.Time)} }
+
+// Mark records that `variable` was actuated on this slot at `now`. Called once per
+// emitted move, on the SUCCESSFUL-emit path (a failed actuation must not throttle its
+// retry). A later Mark overwrites — only the most recent emission matters.
+func (i *Intents) Mark(tenant, ns, pod, variable string, now time.Time) {
+	if i == nil || pod == "" || variable == "" {
+		return
+	}
+	key := slotKey(tenant, ns, pod)
+	i.mu.Lock()
+	defer i.mu.Unlock()
+	vars := i.at[key]
+	if vars == nil {
+		vars = make(map[string]time.Time)
+		i.at[key] = vars
+	}
+	vars[variable] = now
+}
+
+// Since returns time-since-emission per variable for a slot (empty if none). A negative
+// interval (clock skew) is clamped to 0, matching Clock.Since.
+func (i *Intents) Since(tenant, ns, pod string, now time.Time) map[string]time.Duration {
+	if i == nil {
+		return nil
+	}
+	key := slotKey(tenant, ns, pod)
+	i.mu.Lock()
+	defer i.mu.Unlock()
+	vars := i.at[key]
+	if len(vars) == 0 {
+		return nil
+	}
+	out := make(map[string]time.Duration, len(vars))
+	for v, ts := range vars {
+		d := now.Sub(ts)
+		if d < 0 {
+			d = 0
+		}
+		out[v] = d
+	}
+	return out
+}
+
+// RetainTenant prunes this tenant's intent slots not in keep (a set of full slot keys),
+// mirroring Clock.RetainTenant so a departed pod's intent is dropped with its clock.
+// Returns the count dropped.
+func (i *Intents) RetainTenant(tenant string, keep map[string]struct{}) int {
+	if i == nil {
+		return 0
+	}
+	prefix := tenant + "\x00"
+	i.mu.Lock()
+	defer i.mu.Unlock()
+	dropped := 0
+	for k := range i.at {
+		if len(k) >= len(prefix) && k[:len(prefix)] == prefix {
+			if _, ok := keep[k]; !ok {
+				delete(i.at, k)
+				dropped++
+			}
+		}
+	}
+	return dropped
+}
diff --git a/phorvex/internal/exposure/intent_test.go b/phorvex/internal/exposure/intent_test.go
new file mode 100644
index 0000000..30455ee
--- /dev/null
+++ b/phorvex/internal/exposure/intent_test.go
@@ -0,0 +1,64 @@
+package exposure
+
+import (
+	"testing"
+	"time"
+)
+
+func TestIntentsMarkAndSince(t *testing.T) {
+	now := time.Now()
+	i := NewIntents()
+	i.Mark("t", "ns", "p", "guardrailEpoch", now.Add(-20*time.Second))
+
+	since := i.Since("t", "ns", "p", now)
+	if got, ok := since["guardrailEpoch"]; !ok || got < 19*time.Second || got > 21*time.Second {
+		t.Fatalf("intent since = %v (ok=%v), want ~20s", got, ok)
+	}
+	// Untouched slot / variable is absent (so Check fail-opens on it).
+	if len(i.Since("t", "ns", "other", now)) != 0 {
+		t.Error("a slot with no intent must return no durations")
+	}
+	if _, ok := i.Since("t", "ns", "p", now)["drainEpoch"]; ok {
+		t.Error("an unmarked variable must be absent")
+	}
+}
+
+func TestIntentsMarkOverwritesAndClampsSkew(t *testing.T) {
+	now := time.Now()
+	i := NewIntents()
+	i.Mark("t", "ns", "p", "v", now.Add(-5*time.Minute))
+	i.Mark("t", "ns", "p", "v", now.Add(-10*time.Second)) // most recent emission wins
+	if got := i.Since("t", "ns", "p", now)["v"]; got > 11*time.Second {
+		t.Fatalf("Mark must overwrite with the most recent emission; since=%v", got)
+	}
+	// A future mark (clock skew) clamps to 0, never negative.
+	i.Mark("t", "ns", "p", "v", now.Add(time.Minute))
+	if got := i.Since("t", "ns", "p", now)["v"]; got < 0 {
+		t.Fatalf("negative since not clamped: %v", got)
+	}
+	// Empty pod / variable is a no-op.
+	i.Mark("t", "ns", "", "v", now)
+	i.Mark("t", "ns", "p", "", now)
+}
+
+func TestIntentsRetainTenant(t *testing.T) {
+	now := time.Now()
+	i := NewIntents()
+	i.Mark("t", "ns", "keep", "v", now)
+	i.Mark("t", "ns", "drop", "v", now)
+	i.Mark("other", "ns", "p", "v", now) // different tenant, must be untouched
+
+	keep := map[string]struct{}{SlotKey("t", "ns", "keep"): {}}
+	if dropped := i.RetainTenant("t", keep); dropped != 1 {
+		t.Fatalf("RetainTenant dropped %d, want 1 (the 'drop' pod)", dropped)
+	}
+	if len(i.Since("t", "ns", "drop", now)) != 0 {
+		t.Error("dropped pod's intent should be gone")
+	}
+	if len(i.Since("t", "ns", "keep", now)) == 0 {
+		t.Error("kept pod's intent should survive")
+	}
+	if len(i.Since("other", "ns", "p", now)) == 0 {
+		t.Error("another tenant's intent must not be touched by RetainTenant('t')")
+	}
+}
diff --git a/phorvex/internal/feasibility/anti_over_rotation_test.go b/phorvex/internal/feasibility/anti_over_rotation_test.go
new file mode 100644
index 0000000..b5ef995
--- /dev/null
+++ b/phorvex/internal/feasibility/anti_over_rotation_test.go
@@ -0,0 +1,155 @@
+package feasibility
+
+import (
+	"testing"
+	"time"
+
+	"github.com/phorvex/phorvex/internal/model"
+)
+
+// M-23 — per-action exposure clocks. These pin the three legs and the D1–D3 decisions:
+// a TOTAL exposureVarFor over a clocked variable set (completeness), each pod-alive action
+// throttled against its OWN clock, the emit-intent burst guard (min over observed+intent),
+// and fail-OPEN on an absent clock (never-actuated pod is not deadlocked).
+
+func liveVarSet() map[string]bool {
+	s := map[string]bool{}
+	for _, v := range model.LiveExposureVariables {
+		s[v] = true
+	}
+	return s
+}
+
+// viewClocks builds a view with arbitrary observed and intent clocks.
+func viewClocks(observed, intent map[string]time.Duration) *model.WorkloadView {
+	return &model.WorkloadView{
+		Pod:                model.Pod{Namespace: "ns", Name: "p", UID: "u1"},
+		ExposureByVariable: observed,
+		IntentByVariable:   intent,
+	}
+}
+
+// TestExposureVarForCompleteness is the M-23 wiring tripwire (D1): because the runtime Check
+// fail-OPENs an unclocked variable, the fail-CLOSED guarantee lives here — every generatable
+// action MUST map to a variable that is actually clocked (∈ LiveExposureVariables). A new
+// MutatingActions member with no exposure decision, or a typo'd variable, fails the build.
+func TestExposureVarForCompleteness(t *testing.T) {
+	live := liveVarSet()
+	for _, a := range model.MutatingActions {
+		v := ExposureVarFor(a)
+		if v == "" {
+			t.Errorf("action %q has no exposure variable (add an ExposureVarFor arm; pod-replacing => VarPodIdentity)", a)
+			continue
+		}
+		if !live[v] {
+			t.Errorf("action %q maps to %q which is NOT clocked (not in model.LiveExposureVariables) — a mapped-but-unclocked variable fail-OPENs forever", a, v)
+		}
+	}
+}
+
+// TestExposureFingerprintsCoversClockedVars closes the loop: a fully-marked pod emits EXACTLY
+// LiveExposureVariables (so every mapped variable can actually be observed), and an unmarked pod
+// absent-skips the per-action epochs (leaving only the always-present identity/node/session).
+func TestExposureFingerprintsCoversClockedVars(t *testing.T) {
+	full := model.Pod{
+		UID: "u1", Node: "n1", SessionEpoch: "s",
+		QuarantineEpoch: "1", RouteKeyEpoch: "2", IdentityEpoch: "3",
+		AdapterEpoch: "4", DrainEpoch: "5", GuardrailEpoch: "6",
+	}
+	fp := model.ExposureFingerprints(full)
+	live := liveVarSet()
+	if len(fp) != len(live) {
+		t.Fatalf("fully-marked pod emitted %d fingerprints, want %d (== LiveExposureVariables)", len(fp), len(live))
+	}
+	for v := range fp {
+		if !live[v] {
+			t.Errorf("ExposureFingerprints emitted %q which is not in LiveExposureVariables", v)
+		}
+	}
+	// Absent-skip: a never-actuated pod carries only the always-present three.
+	bare := model.ExposureFingerprints(model.Pod{UID: "u1", Node: "n1", SessionEpoch: "s"})
+	if len(bare) != 3 {
+		t.Fatalf("unmarked pod emitted %d fingerprints, want 3 (podIdentity/nodePlacement/session); absent epochs must be skipped, not seeded", len(bare))
+	}
+}
+
+// TestPerActionClockThrottles proves each pod-alive action reads the clock its OWN handler resets:
+// 20s after that variable moved it is vetoed; 16m after, feasible. On the OLD code (default ->
+// podIdentity) every one of these read podIdentity and passed — this is ticket test (a)'s RED.
+func TestPerActionClockThrottles(t *testing.T) {
+	pol := model.Policy{AntiOverRotationWindow: 15 * time.Minute}
+	for _, a := range []model.Action{
+		model.ActionQuarantine, model.ActionEndpointRotate, model.ActionRouteRotate,
+		model.ActionIdentityRotate, model.ActionAdapterRotate, model.ActionRequestDrain,
+		model.ActionGuardrailRotate,
+	} {
+		v := ExposureVarFor(a)
+		// podIdentity is ancient (the bug's clock); only the action's own variable is fresh.
+		inWindow := viewClocks(map[string]time.Duration{model.VarPodIdentity: 10 * time.Hour, v: 20 * time.Second}, nil)
+		if got := (antiOverRotation{}).Check(inWindow, model.Move{Action: a}, pol); got.Feasible {
+			t.Errorf("%q 20s after its %q clock reset was allowed (old bug: read podIdentity=10h)", a, v)
+		}
+		elapsed := viewClocks(map[string]time.Duration{model.VarPodIdentity: 10 * time.Hour, v: 16 * time.Minute}, nil)
+		if got := (antiOverRotation{}).Check(elapsed, model.Move{Action: a}, pol); !got.Feasible {
+			t.Errorf("%q 16m after its %q clock reset must be allowed: %s", a, v, got.Reason)
+		}
+	}
+}
+
+// TestPodAliveActionReadsOwnClockNotPodIdentity is the sharpest statement of the M-23 bug and its
+// fix (ticket test a): a pod alive for 10h but guardrail-rotated 20s ago must be BLOCKED. The old
+// code read podIdentity (10h > window) and allowed it — the re-fire-every-tick defect. The view
+// hardcodes both clocks (it does NOT key off ExposureVarFor), so reverting the guardrail mapping
+// back to podIdentity flips this test red.
+func TestPodAliveActionReadsOwnClockNotPodIdentity(t *testing.T) {
+	pol := model.Policy{AntiOverRotationWindow: 15 * time.Minute}
+	view := viewClocks(map[string]time.Duration{
+		model.VarPodIdentity:    10 * time.Hour,   // pod itself is ancient
+		model.VarGuardrailEpoch: 20 * time.Second, // but guardrail was rotated 20s ago
+	}, nil)
+	if got := (antiOverRotation{}).Check(view, model.Move{Action: model.ActionGuardrailRotate}, pol); got.Feasible {
+		t.Fatalf("guardrail-rotate 20s after its own epoch was allowed — the guard read podIdentity (10h), the M-23 bug")
+	}
+}
+
+// TestIntentClosesBurstHole is ticket test (c) + the D3 sign guard: the observed clock is stale
+// (the *-epoch marker hasn't been re-observed yet) but an emit intent was stamped 20s ago, so the
+// second emit is vetoed. With the D3 regression (max instead of min) the stale 10h would win and
