# Dependencies
**/node_modules/

# Next.js build + static export output
dashboard-web/.next/
dashboard-web/out/
**/.next/

# Compiled binaries
**/bin/*.exe
*.exe

# Go build/test cache
*.test
*.out

# Python bytecode/cache
**/__pycache__/
*.py[cod]

# Runtime audit trail (generated)
phorvex/bin/console-audit.jsonl

# OS / editor
.claude/settings.json
.claude/settings.local.json
.DS_Store
Thumbs.db
*.log
*.exe~
*.tsbuildinfo

# Retained workflow proof is versioned; runtime logs elsewhere remain ignored.
!workflow/fixes/**/evidence/**/*.log
# Recorded protocol replies used as console test fixtures.
!phorvex/internal/console/testdata/**/*.log
