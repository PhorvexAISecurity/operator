    "commandSources": {
      "/ragstore-fixture": "phorvex/cmd/ragstore-fixture",
      "/cost-admission": "phorvex/cmd/cost-admission",
      "/cost-load-detector": "phorvex/cmd/cost-load-detector"
    },
    "labels": [
      "org.opencontainers.image.revision",
      "org.opencontainers.image.version",
      "ai.phorvex.fixture.commands"
    ]
  },
  "consumers": {
    "renderFlag": "--phorvex-image",
    "renderTool": "tools/render_catalogue_staging_values.py",
    "valuesPath": [
      "phorvex",
      "console",
      "attackCatalog",
      "familyFixtures",
      "images",
      "phorvex"
    ],
    "families": {
      "datastore": [
        "/ragstore-fixture"
      ],
      "serving-rate": [
        "/ragstore-fixture",
        "/cost-admission",
        "/cost-load-detector"
      ],
      "serving-kv": [
        "/ragstore-fixture"
      ]
    }
  }
