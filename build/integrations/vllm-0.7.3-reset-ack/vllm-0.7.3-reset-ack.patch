@@ -313,0 +315,16 @@ class MQLLMEngine:
+    def _handle_reset_prefix_cache_request(
+            self, request: RPCResetPrefixCacheRequest):
+        try:
+            success = self.reset_prefix_cache()
+            if type(success) is not bool:
+                raise TypeError("Prefix-cache reset result must be bool")
+        except BaseException as e:
+            self._send_outputs(
+                RPCError(request_id=request.request_id,
+                         is_engine_errored=False,
+                         exception=e))
+            return
+        self._send_outputs(
+            RPCResetPrefixCacheResponse(request_id=request.request_id,
+                                        success=success))
+
