{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "description": "", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["phorvex", "amtd", "security"],
  "title": "Phorvex — Risk Heatmap & Decisions",
  "uid": "phorvex-p0",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "tenant",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(phorvex_pod_risk_score, tenant)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Risk heatmap — per-pod risk score (pods × time, color = risk)",
      "type": "heatmap",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "options": { "calculate": false, "color": { "scheme": "Turbo", "mode": "scheme" }, "yAxis": { "axisLabel": "pod" } },
      "targets": [
        {
          "expr": "phorvex_pod_risk_score{tenant=~\"$tenant\"}",
          "legendFormat": "{{namespace}}/{{pod}}",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Current risk by pod",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "custom": { "displayMode": "color-background" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.4 },
            { "color": "orange", "value": 0.7 },
            { "color": "red", "value": 1.0 }
          ] }
        }
      },
      "targets": [
        { "expr": "sort_desc(phorvex_pod_risk_score{tenant=~\"$tenant\"})", "format": "table", "instant": true, "legendFormat": "{{namespace}}/{{pod}}", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "Blast radius by pod",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "options": { "orientation": "horizontal", "displayMode": "gradient" },
      "targets": [
        { "expr": "sort_desc(phorvex_pod_blast_radius{tenant=~\"$tenant\"})", "legendFormat": "{{namespace}}/{{pod}}", "instant": true, "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "Selected moves per tick",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 18 },
      "targets": [
        { "expr": "phorvex_selected_moves{tenant=~\"$tenant\"}", "legendFormat": "{{tenant}}", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "title": "Decisions rate by action (dry-run)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 18 },
      "targets": [
        { "expr": "sum by (action) (rate(phorvex_decisions_total{tenant=~\"$tenant\"}[5m]))", "legendFormat": "{{action}}", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "title": "Per-variable exposure (max seconds)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 18 },
      "targets": [
        { "expr": "max by (variable) (phorvex_pod_exposure_seconds{tenant=~\"$tenant\"})", "legendFormat": "{{variable}}", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "title": "Kill-switch engaged",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 26 },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "OFF", "color": "green" }, "1": { "text": "ENGAGED", "color": "red" } } } ] } },
      "targets": [ { "expr": "phorvex_kill_switch_engaged", "instant": true, "refId": "A" } ]
    },
    {
      "id": 8,
      "title": "Tick duration p99 (NFR1 < 1s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 16, "x": 8, "y": 26 },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(phorvex_tick_duration_seconds_bucket{tenant=~\"$tenant\"}[5m])))", "legendFormat": "p99 tick seconds", "refId": "A" }
      ]
    },
    {
      "id": 9,
      "title": "Budget shadow-price λ (dual-descent)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 30 },
      "targets": [
        { "expr": "phorvex_tenant_lambda{tenant=~\"$tenant\"}", "legendFormat": "{{tenant}} λ", "refId": "A" }
      ]
    },
    {
      "id": 10,
      "title": "Recon-per-dollar by pod (P1 objective)",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 30 },
      "options": { "orientation": "horizontal", "displayMode": "gradient" },
      "targets": [
        { "expr": "sort_desc(phorvex_pod_per_dollar{tenant=~\"$tenant\"})", "legendFormat": "{{namespace}}/{{pod}}", "instant": true, "refId": "A" }
      ]
    },
    {
      "id": 11,
      "title": "Accepted native dispatch / Phoenix submissions",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 30 },
      "targets": [
        { "expr": "sum by (action) (increase(phorvex_actuations_total{tenant=~\"$tenant\"}[5m]))", "legendFormat": "{{action}}", "refId": "A" }
      ]
    },
    {
      "id": 12,
      "title": "Emergent proactive firing rate (perDollar − λ; >0 = due)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 37 },
      "targets": [
        { "expr": "phorvex_pod_proactive_rate{tenant=~\"$tenant\"}", "legendFormat": "{{namespace}}/{{pod}}", "refId": "A" }
      ]
    },
    {
      "id": 13,
      "title": "Actual dispatch attempts by synchronous outcome",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 44 },
      "targets": [
        { "expr": "sum by (action, outcome) (increase(phorvex_actuation_attempts_total{tenant=~\"$tenant\"}[5m]))", "legendFormat": "{{action}} / {{outcome}}", "refId": "A" }
      ]
    },
    {
      "id": 14,
      "title": "Attempt failures and explicit refusals",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 44 },
      "targets": [
        { "expr": "sum by (action, reason) (increase(phorvex_actuation_failures_total{tenant=~\"$tenant\"}[5m]))", "legendFormat": "{{action}} / {{reason}}", "refId": "A" }
      ]
    },
    {
      "id": 15,
      "title": "Current retry cooldowns",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 44 },
      "targets": [
        { "expr": "sum by (action) (phorvex_actuation_circuit_open{tenant=~\"$tenant\"})", "legendFormat": "{{action}}", "refId": "A" }
      ]
    },
    {
      "id": 16,
      "title": "Selected actions suppressed before dispatch",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 51 },
      "targets": [
        { "expr": "sum by (action, reason) (increase(phorvex_actuation_suppressions_total{tenant=~\"$tenant\"}[5m]))", "legendFormat": "{{action}} / {{reason}}", "refId": "A" }
      ]
    }
  ]
}
