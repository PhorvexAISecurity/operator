{
 "uid": "phorvex-services-__ENVIRONMENT__",
 "title": "Phorvex services \u2014 __ENVIRONMENT__",
 "description": "The split Phorvex services of one environment (ADR-0001): scrape health, gRPC calls between the services, ticks, decisions, actuations and resources. Rendered by the manager chart (phorvex.metrics.dashboard).",
 "tags": [
  "phorvex",
  "__ENVIRONMENT__"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "1m",
 "templating": {
  "list": [
   {
    "name": "datasource",
    "type": "datasource",
    "query": "prometheus",
    "label": "Prometheus",
    "current": {},
    "hide": 0
   }
  ]
 },
 "annotations": {
  "list": []
 },
