     "expr": "up{environment=\"__ENVIRONMENT__\"}",
     "legendFormat": "{{job}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
