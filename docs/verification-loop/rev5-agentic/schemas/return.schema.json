{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rev5 worker return",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "campaign_id",
    "case_id",
    "round_id",
    "attempt_id",
    "epoch",
    "actor_id",
    "harness_job_id",
    "role",
    "model",
    "expected_case_revision",
    "input_hashes",
    "pins",
    "status",
    "findings",
    "payload_contract",
    "payload",
    "artifact_refs",
    "proposed_transition",
    "review_request",
    "blockers",
    "next_action",
    "usage"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "round_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "attempt_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "epoch": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "harness_job_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "ORCHESTRATOR",
        "CLUSTER_ANALYST",
        "LIBRARY_SELECTOR",
        "CASE_BINDER",
        "CHALLENGE_PLANNER",
        "DEFENSE_PROPOSER",
        "CRITIC",
        "ACTUATOR_DESIGNER",
        "EVIDENCE_AUDITOR"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "expected_case_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "input_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "pins": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "SUBMITTED",
        "BLOCKED",
        "INPUT_STALE",
        "FAILED"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "statement",
          "artifact_ids"
        ],
        "properties": {
          "kind": {
            "enum": [
              "OBSERVED",
              "INFERENCE",
              "UNKNOWN"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "artifact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    },
    "payload_contract": {
      "enum": [
        "CampaignPlan",
        "WorkloadProfile",
        "CandidateSet",
        "BoundCaseContract",
        "ChallengePlan",
        "DefenseQueue",
        "Critique",
        "ActuatorCapabilityContract",
        "IndependentReview"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "proposed_transition": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "review_request": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "role",
        "specialty",
        "raw_artifact_ids",
        "criteria",
        "conflict_actor_ids",
        "raw_first",
        "conclusion_artifact_id"
      ],
      "properties": {
        "role": {
          "enum": [
            "CRITIC",
            "EVIDENCE_AUDITOR"
          ]
        },
        "specialty": {
          "type": "string",
          "minLength": 1
        },
        "raw_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conflict_actor_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "raw_first": {
          "type": "boolean"
        },
        "conclusion_artifact_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "role": {
                "const": "EVIDENCE_AUDITOR"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "raw_first": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "failure_layer",
          "reason",
          "owner",
          "exit_condition",
          "next_deliverable",
          "deadline"
        ],
        "properties": {
          "failure_layer": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "exit_condition": {
            "type": "string",
            "minLength": 1
          },
          "next_deliverable": {
            "type": "string",
            "minLength": 1
          },
          "deadline": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "additionalProperties": true
      }
    },
    "next_action": {
      "type": "object",
      "required": [
        "owner",
        "action"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "usage": {
      "type": "object",
      "required": [
        "elapsed_seconds",
        "input_tokens",
        "output_tokens",
        "cost"
      ],
      "properties": {
        "elapsed_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cost": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "artifact_id",
        "ref",
        "sha256",
        "producer_id",
        "observed_at",
        "classification",
        "pins"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "producer_id": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "classification": {
          "enum": [
            "PRIMARY",
            "DERIVED",
            "REVIEW",
            "SYNTHETIC"
          ]
        },
        "pins": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "case_id": {
            "type": "null"
          }
        },
        "required": [
          "case_id"
        ]
      },
      "then": {
        "properties": {
          "expected_case_revision": {
            "type": "null"
          },
          "round_id": {
            "type": "null"
          },
          "attempt_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "expected_case_revision": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "ORCHESTRATOR"
          }
        }
      },
      "then": {
        "properties": {
          "payload_contract": {
            "const": "CampaignPlan"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "CLUSTER_ANALYST"
          }
        }
      },
      "then": {
        "properties": {
          "payload_contract": {
            "const": "WorkloadProfile"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "LIBRARY_SELECTOR"
          }
        }
      },
      "then": {
        "properties": {
          "payload_contract": {
            "const": "CandidateSet"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "CASE_BINDER"
          }
        }
      },
      "then": {
        "properties": {
          "payload_contract": {
            "const": "BoundCaseContract"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "CHALLENGE_PLANNER"
          }
        }
      },
      "then": {
        "properties": {
          "payload_contract": {
            "const": "ChallengePlan"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "DEFENSE_PROPOSER"
          }
        }
      },
      "then": {
        "properties": {
          "payload_contract": {
            "const": "DefenseQueue"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "CRITIC"
          }
        }
      },
      "then": {
        "properties": {
          "payload_contract": {
            "const": "Critique"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "ACTUATOR_DESIGNER"
          }
        }
      },
      "then": {
        "properties": {
          "payload_contract": {
            "const": "ActuatorCapabilityContract"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "EVIDENCE_AUDITOR"
          }
        }
      },
      "then": {
        "properties": {
          "payload_contract": {
            "const": "IndependentReview"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "BLOCKED",
              "INPUT_STALE",
              "FAILED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "blockers": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUBMITTED"
          },
          "role": {
            "const": "CLUSTER_ANALYST"
          }
        },
        "required": [
          "status",
          "role"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "roster_inputs"
            ],
            "properties": {
              "roster_inputs": {
                "type": [
                  "object",
                  "array"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUBMITTED"
          },
          "role": {
            "const": "ORCHESTRATOR"
          }
        },
        "required": [
          "status",
          "role"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "roster_plan_ref"
            ],
            "properties": {
              "roster_plan_ref": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
