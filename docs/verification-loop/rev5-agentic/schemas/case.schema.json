{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rev5 trusted local case register",
  "description": "Structural schema; progress.py applies conditional admission/CAS/history guards. References and distinct identities do not certify physical truth or authenticated independence.",
  "type": "object",
  "required": [
    "schema_version",
    "campaign_id",
    "case_id",
    "revision",
    "title",
    "stack",
    "synthetic",
    "target",
    "library",
    "capability",
    "profile",
    "branches",
    "progress_plan_revision",
    "stage",
    "substep",
    "work_state",
    "scheduling_state",
    "owner",
    "round",
    "attempt_id",
    "epoch",
    "pins",
    "observation_mode",
    "claim_scope",
    "milestones",
    "metrics",
    "checks",
    "chain",
    "outcome",
    "current_validation",
    "defended_at",
    "evidence_level",
    "threat_effect",
    "failure_layer",
    "resolution",
    "planned_resolution",
    "closure",
    "competition_state",
    "final_review_ref",
    "blocker",
    "next_action",
    "assignments",
    "prs",
    "attempts",
    "history_notes",
    "timing",
    "created_at",
    "updated_at",
    "last_evidence_at",
    "last_heartbeat_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string"
    },
    "stack": {
      "type": "string"
    },
    "synthetic": {
      "type": "boolean"
    },
    "target": {
      "type": "object",
      "required": [
        "customer",
        "twin"
      ],
      "properties": {
        "customer": {
          "type": [
            "string",
            "null"
          ]
        },
        "twin": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "library": {
      "type": "object",
      "required": [
        "entry_id",
        "version",
        "bucket",
        "review_ref"
      ],
      "properties": {
        "entry_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "bucket": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "capability": {
      "type": [
        "string",
        "null"
      ]
    },
    "profile": {
      "enum": [
        "PHASE1",
        "FULL"
      ]
    },
    "branches": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "ACTUATOR_ENGINEERING"
        ]
      }
    },
    "progress_plan_revision": {
      "type": "integer",
      "minimum": 1
    },
    "stage": {
      "enum": [
        "S0_SCOPE",
        "S1_SCAN_SELECT",
        "S2_BIND_REVIEW",
        "S3_TWIN_ADMIT",
        "S4_ESTABLISH_REAL",
        "S5_PROPOSE_DEFENSE",
        "S6_BRAIN_EXECUTE",
        "S7_MEASURE_REVIEW",
        "S8_CHALLENGE",
        "S9_REPEAT_RELEASE",
        "S10_PUBLISH",
        "SD_DESIGN",
        "SE_ENGINEERING"
      ]
    },
    "substep": {
      "type": "string"
    },
    "work_state": {
      "type": "string"
    },
    "scheduling_state": {
      "enum": [
        "ACTIVE",
        "PARKED",
        "TERMINAL"
      ]
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "round": {
      "type": "integer",
      "minimum": 0
    },
    "attempt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "epoch": {
      "type": "string"
    },
    "pins": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "observation_mode": {
      "enum": [
        "UNBOUND",
        "NATURAL_OBSERVATION",
        "AUTHENTICATED_FIXTURE_INPUT",
        "REPLAY_INPUT"
      ]
    },
    "claim_scope": {
      "type": "string"
    },
    "milestones": {
      "type": "object",
      "patternProperties": {
        "^(M[0-9]{2}|E[0-9]{2})$": {
          "$ref": "#/$defs/milestone"
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": [
        "G1",
        "G2",
        "G3",
        "S1",
        "S2",
        "S3",
        "S4"
      ],
      "properties": {
        "G1": {
          "$ref": "#/$defs/metric"
        },
        "G2": {
          "$ref": "#/$defs/metric"
        },
        "G3": {
          "$ref": "#/$defs/metric"
        },
        "S1": {
          "$ref": "#/$defs/metric"
        },
        "S2": {
          "$ref": "#/$defs/metric"
        },
        "S3": {
          "$ref": "#/$defs/metric"
        },
        "S4": {
          "$ref": "#/$defs/metric"
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "properties": {
        "scenario_battery": {
          "$ref": "#/$defs/battery"
        },
        "g2_components": {
          "type": "object",
          "required": [
            "availability_floor",
            "bound_proof",
            "co_tenant_isolation",
            "ledger_hold",
            "slo_headroom"
          ],
          "properties": {
            "slo_headroom": {
              "$ref": "#/$defs/check"
            },
            "bound_proof": {
              "$ref": "#/$defs/check"
            },
            "availability_floor": {
              "$ref": "#/$defs/check"
            },
            "co_tenant_isolation": {
              "$ref": "#/$defs/check"
            },
            "ledger_hold": {
              "$ref": "#/$defs/check"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "chain": {
      "type": "object"
    },
    "outcome": {
      "enum": [
        "DEFENDED",
        "INCONCLUSIVE",
        "MITIGATED_UNACCEPTABLE",
        "NON_TRANSFERABLE",
        "NOT_APPLICABLE",
        "NOT_DEFENDED",
        "OUT_OF_SCOPE",
        "PENDING"
      ]
    },
    "current_validation": {
      "enum": [
        "CURRENT",
        "STALE",
        "UNKNOWN"
      ]
    },
    "defended_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "evidence_level": {
      "enum": [
        "NONE",
        "REPORTED",
        "INDEPENDENTLY_VERIFIED"
      ]
    },
    "threat_effect": {
      "type": "string"
    },
    "failure_layer": {
      "type": "string"
    },
    "resolution": {
      "type": "array",
      "items": {
        "enum": [
          "ACTUATOR_CORRECTION",
          "EXISTING_ACTUATOR",
          "HARNESS_CORRECTION",
          "NEW_ACTUATOR",
          "OBSERVATION_INTEGRATION"
        ]
      }
    },
    "planned_resolution": {
      "type": "array",
      "items": {
        "enum": [
          "ACTUATOR_CORRECTION",
          "EXISTING_ACTUATOR",
          "HARNESS_CORRECTION",
          "NEW_ACTUATOR",
          "OBSERVATION_INTEGRATION"
        ]
      }
    },
    "closure": {
      "enum": [
        "CLOSED_NEGATIVE",
        "CLOSED_NOT_APPLICABLE",
        "CLOSED_UNRESOLVED",
        "FULL_FULL",
        "FULL_PHASE1",
        "INITIAL_WIN_ONLY",
        "OPEN"
      ]
    },
    "competition_state": {
      "type": "string"
    },
    "final_review_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "blocker": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_action": {
      "type": "string"
    },
    "assignments": {
      "type": "array"
    },
    "prs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pr"
      }
    },
    "attempts": {
      "type": "array"
    },
    "history_notes": {
      "type": "array"
    },
    "timing": {
      "type": "object"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_evidence_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_heartbeat_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "check": {
      "type": "object",
      "required": [
        "status",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_RUN",
            "PENDING",
            "PASS",
            "FAIL",
            "UNKNOWN",
            "STALE",
            "UNSUPPORTED"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "milestone": {
      "type": "object",
      "required": [
        "status",
        "author",
        "depends_on",
        "evidence_refs",
        "acceptance",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "ACCEPTED",
            "BLOCKED",
            "NOT_STARTED",
            "RUNNING",
            "STALE",
            "SUBMITTED"
          ]
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "author_job_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "reviewer",
            "review_ref",
            "at",
            "pins"
          ],
          "properties": {
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "reviewer_job_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_ref": {
              "type": "string",
              "minLength": 1
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "pins": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": true
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "metric": {
      "type": "object",
      "required": [
        "status",
        "value",
        "units",
        "window",
        "measurement_type",
        "evidence_refs",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_RUN",
            "PENDING",
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "value": {
          "type": [
            "number",
            "boolean",
            "null"
          ]
        },
        "units": {
          "type": [
            "string",
            "null"
          ]
        },
        "window": {
          "type": [
            "object",
            "string",
            "number",
            "null"
          ]
        },
        "measurement_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "assertion": {
      "type": "object",
      "required": [
        "assertion_id",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "assertion_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "NOT_RUN",
            "PENDING",
            "PASS",
            "FAIL",
            "UNKNOWN",
            "STALE",
            "UNSUPPORTED"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "scenario": {
      "type": "object",
      "required": [
        "scenario_id",
        "archetype",
        "fixture_ref",
        "fixture_hash",
        "expected_outcome",
        "status",
        "evidence_refs",
        "review_ref",
        "epoch",
        "assertions"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "archetype": {
          "type": "string",
          "minLength": 1
        },
        "fixture_ref": {
          "type": "string",
          "minLength": 1
        },
        "fixture_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expected_outcome": {
          "enum": [
            "SELECTED_AND_CONFIRMED",
            "EXPECTED_REJECTION",
            "INTEGRITY_ASSERTION"
          ]
        },
        "status": {
          "enum": [
            "NOT_RUN",
            "PENDING",
            "PASS",
            "FAIL",
            "UNKNOWN",
            "STALE",
            "UNSUPPORTED"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review_ref": {
          "type": "string",
          "minLength": 1
        },
        "epoch": {
          "type": "string",
          "minLength": 1
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assertion"
          }
        }
      },
      "additionalProperties": true
    },
    "battery": {
      "type": "object",
      "required": [
        "manifest_ref",
        "review_ref",
        "evidence_refs",
        "status",
        "completed_at",
        "required_archetype_families",
        "required_scenario_ids",
        "scenarios"
      ],
      "properties": {
        "manifest_ref": {
          "type": "string",
          "minLength": 1
        },
        "review_ref": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "NOT_RUN",
            "PENDING",
            "PASS",
            "FAIL",
            "UNKNOWN",
            "STALE",
            "UNSUPPORTED"
          ]
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "required_archetype_families": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_scenario_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scenario"
          }
        }
      },
      "additionalProperties": true
    },
    "pr": {
      "type": "object",
      "required": [
        "repo",
        "number",
        "url",
        "change_types",
        "state",
        "head_sha",
        "merge_sha",
        "review_ref",
        "follow_up_to",
        "deployments",
        "retests"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "change_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "head_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "merge_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "follow_up_to": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deployments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "target",
              "image_digest",
              "source",
              "at",
              "status",
              "evidence_refs"
            ],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "image_digest": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "status": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        },
        "retests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "attempt_id",
              "epoch",
              "source",
              "deployment_ref",
              "outcome",
              "evidence_level",
              "evidence_refs"
            ],
            "properties": {
              "attempt_id": {
                "type": "string",
                "minLength": 1
              },
              "epoch": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "deployment_ref": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "enum": [
                  "DEFENDED",
                  "INCONCLUSIVE",
                  "MITIGATED_UNACCEPTABLE",
                  "NON_TRANSFERABLE",
                  "NOT_APPLICABLE",
                  "NOT_DEFENDED",
                  "OUT_OF_SCOPE",
                  "PENDING"
                ]
              },
              "evidence_level": {
                "enum": [
                  "NONE",
                  "REPORTED",
                  "INDEPENDENTLY_VERIFIED"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  }
}
