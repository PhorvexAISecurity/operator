{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rev5 worker task",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "campaign_id",
    "case_id",
    "round_id",
    "attempt_id",
    "epoch",
    "role",
    "actor_id",
    "harness_job_id",
    "parent_task_id",
    "model",
    "objective",
    "expected_case_revision",
    "inputs",
    "pins",
    "allowed_tools",
    "dependencies",
    "acceptance_conditions",
    "budget",
    "return_schema_ref",
    "payload_contract",
    "output_ref",
    "nested_spawning_allowed",
    "work_state",
    "started_at",
    "last_heartbeat_at",
    "ended_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "round_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "attempt_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "epoch": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "role": {
      "enum": [
        "ORCHESTRATOR",
        "CLUSTER_ANALYST",
        "LIBRARY_SELECTOR",
        "CASE_BINDER",
        "CHALLENGE_PLANNER",
        "DEFENSE_PROPOSER",
        "CRITIC",
        "ACTUATOR_DESIGNER",
        "EVIDENCE_AUDITOR"
      ]
    },
    "actor_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "harness_job_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "parent_task_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "model": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "expected_case_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "pins": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget": {
      "type": "object",
      "required": [
        "max_seconds",
        "max_tokens"
      ],
      "properties": {
        "max_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "return_schema_ref": {
      "const": "schemas/return.schema.json"
    },
    "payload_contract": {
      "enum": [
        "CampaignPlan",
        "WorkloadProfile",
        "CandidateSet",
        "BoundCaseContract",
        "ChallengePlan",
        "DefenseQueue",
        "Critique",
        "ActuatorCapabilityContract",
        "IndependentReview"
      ]
    },
    "output_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "nested_spawning_allowed": {
      "const": false,
      "default": false
    },
    "work_state": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "BLOCKED",
        "SUBMITTED",
        "FINISHED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_heartbeat_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "artifact_id",
        "ref",
        "sha256",
        "producer_id",
        "observed_at",
        "classification",
        "pins"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "producer_id": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "classification": {
          "enum": [
            "PRIMARY",
            "DERIVED",
            "REVIEW",
            "SYNTHETIC"
          ]
        },
        "pins": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "case_id": {
            "type": "null"
          }
        },
        "required": [
          "case_id"
        ]
      },
      "then": {
        "properties": {
          "expected_case_revision": {
            "type": "null"
          },
          "round_id": {
            "type": "null"
          },
          "attempt_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "expected_case_revision": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "ORCHESTRATOR"
          }
        }
      },
      "then": {
        "properties": {
          "payload_contract": {
            "const": "CampaignPlan"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "CLUSTER_ANALYST"
          }
        }
      },
      "then": {
        "properties": {
          "payload_contract": {
            "const": "WorkloadProfile"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "LIBRARY_SELECTOR"
          }
        }
      },
      "then": {
        "properties": {
          "payload_contract": {
            "const": "CandidateSet"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "CASE_BINDER"
          }
        }
      },
      "then": {
        "properties": {
          "payload_contract": {
            "const": "BoundCaseContract"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "CHALLENGE_PLANNER"
          }
        }
      },
      "then": {
        "properties": {
          "payload_contract": {
            "const": "ChallengePlan"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "DEFENSE_PROPOSER"
          }
        }
      },
      "then": {
        "properties": {
          "payload_contract": {
            "const": "DefenseQueue"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "CRITIC"
          }
        }
      },
      "then": {
        "properties": {
          "payload_contract": {
            "const": "Critique"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "ACTUATOR_DESIGNER"
          }
        }
      },
      "then": {
        "properties": {
          "payload_contract": {
            "const": "ActuatorCapabilityContract"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "EVIDENCE_AUDITOR"
          }
        }
      },
      "then": {
        "properties": {
          "payload_contract": {
            "const": "IndependentReview"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "work_state": {
            "const": "RUNNING"
          }
        }
      },
      "then": {
        "properties": {
          "actor_id": {
            "type": "string",
            "minLength": 1
          },
          "harness_job_id": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "output_ref": {
            "type": "string",
            "minLength": 1
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ]
}
