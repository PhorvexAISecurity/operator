{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phorvex.agentic-handoff.v2",
  "title": "Agent proposal bound to a supervisor assignment",
  "type": "object",
  "required": ["schema_version", "actor_id", "role", "run_id", "case_id", "attempt_id", "episode_id", "contract_sha256", "source_revision", "status", "input_refs", "artifacts", "findings", "limitations", "next_action"],
  "properties": {
    "schema_version": {"const": 2},
    "actor_id": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"enum": ["READY", "BLOCKED", "UNAVAILABLE"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "input_refs": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref"}},
    "findings": {"type": "array"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true,
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "$comment": "Shape validation is only the first gate. protocol.validate_handoff must bind values to the supervisor assignment, validate actual file bytes and reject traversal, stale dependencies and self-review. Extra fields are non-authoritative role metadata and cannot set gate results. Actor authenticity and permissions are enforced by future service adapters, not by model-written JSON."
}
